// Parses `PP_FILE` `PP_REPS` times and writes the last parse's blob and
// diagnostics to `PP_OUT`. `PP_ARENA=1` runs each parse in an `arena { }`.

use std::{env, fs}

use ast
use parse_items

/// Parses and encodes `text`, writes the result to `dest`, and answers its
/// length.
fn parse_once(text: String, dest: String) -> i64 {
    let tree, diags = parse_items::parse_source_file(text, 0)
    let mut out: Vec<u8> = Vec::with_capacity(text.byte_len() * 4)
    ast::encode_source_file(&mut out, tree)
    for d in diags {
        out.extend_from_slice(d.name.as_bytes())
        out.push(32)
        out.extend_from_slice(f"{d.start} {d.end}\n".as_bytes())
    }
    let n = out.len()
    fs::write(dest, out).unwrap()
    n
}

fn main() {
    let text = fs::read_to_string(env::var("PP_FILE").unwrap_or("")).unwrap_or("")
    let dest = env::var("PP_OUT").unwrap_or("/dev/null")
    let reps = env::var("PP_REPS").unwrap_or("1").to_i64().unwrap_or(1)
    let in_arena = env::var("PP_ARENA").unwrap_or("0") == "1"
    let mut total = 0
    for _ in 0..reps {
        if in_arena {
            arena {
                total += parse_once(text, dest)
            }
        } else {
            total += parse_once(text, dest)
        }
    }
    println(total)
}
