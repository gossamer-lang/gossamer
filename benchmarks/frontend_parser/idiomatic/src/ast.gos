    encode_span(out, v.span)
    encode_pattern_kind(out, v.kind)
}

pub enum PatternKind {
    Wildcard,
    PatternLiteral(Literal),
    PatternIdent { mutability: Mutability, name: Ident, subpattern: Option<Pattern> },
    Path(TypePath),
    Tuple(Vec<Pattern>),
    Slice { prefix: Vec<Pattern>, rest: Option<Pattern>, suffix: Vec<Pattern> },
    Struct { path: TypePath, fields: Vec<FieldPattern>, rest: bool },
    TupleStruct { path: TypePath, elems: Vec<Pattern> },
    Range { lo: Option<Literal>, hi: Option<Literal>, kind: RangeKind },
    Or(Vec<Pattern>),
    Rest,
    Ref { mutability: Mutability, inner: Pattern },
    Error,
}

pub fn encode_pattern_kind(out: &mut Vec<u8>, v: PatternKind) {
    match v {
        PatternKind::Wildcard => put_varint(out, 0),
        PatternKind::PatternLiteral(f0) => {
            put_varint(out, 1)
            encode_literal(out, f0)
        }
        PatternKind::PatternIdent { mutability: f0, name: f1, subpattern: f2 } => {
            put_varint(out, 2)
            encode_mutability(out, f0)
            encode_ident(out, f1)
            match f2 {
                Some(e1) => {
                    out.push(1)
                    encode_pattern(out, e1)
                }
                None => out.push(0)
            }
        }
        PatternKind::Path(f0) => {
            put_varint(out, 3)
            encode_type_path(out, f0)
        }
        PatternKind::Tuple(f0) => {
            put_varint(out, 4)
            put_varint(out, f0.len() as u64)
            for e2 in f0 {
                encode_pattern(out, e2)
            }
        }
        PatternKind::Slice { prefix: f0, rest: f1, suffix: f2 } => {
            put_varint(out, 5)
            put_varint(out, f0.len() as u64)
            for e3 in f0 {
                encode_pattern(out, e3)
            }
            match f1 {
                Some(e4) => {
                    out.push(1)
                    encode_pattern(out, e4)
                }
                None => out.push(0)
            }
            put_varint(out, f2.len() as u64)
            for e5 in f2 {
                encode_pattern(out, e5)
            }
        }
        PatternKind::Struct { path: f0, fields: f1, rest: f2 } => {
            put_varint(out, 6)
            encode_type_path(out, f0)
            put_varint(out, f1.len() as u64)
            for e6 in f1 {
                encode_field_pattern(out, e6)
            }
            out.push(if f2 { 1 } else { 0 })
        }
        PatternKind::TupleStruct { path: f0, elems: f1 } => {
            put_varint(out, 7)
            encode_type_path(out, f0)
            put_varint(out, f1.len() as u64)
            for e7 in f1 {
                encode_pattern(out, e7)
            }
        }
        PatternKind::Range { lo: f0, hi: f1, kind: f2 } => {
            put_varint(out, 8)
            match f0 {
                Some(e8) => {
                    out.push(1)
                    encode_literal(out, e8)
                }
                None => out.push(0)
            }
            match f1 {
                Some(e9) => {
                    out.push(1)
                    encode_literal(out, e9)
                }
                None => out.push(0)
            }
            encode_range_kind(out, f2)
        }
        PatternKind::Or(f0) => {
            put_varint(out, 9)
            put_varint(out, f0.len() as u64)
            for e10 in f0 {
                encode_pattern(out, e10)
            }
        }
        PatternKind::Rest => put_varint(out, 10),
        PatternKind::Ref { mutability: f0, inner: f1 } => {
            put_varint(out, 11)
            encode_mutability(out, f0)
            encode_pattern(out, f1)
        }
        PatternKind::Error => put_varint(out, 12),
    }
}

pub enum RangeKind {
    Exclusive,
    Inclusive,
}

pub fn encode_range_kind(out: &mut Vec<u8>, v: RangeKind) {
    match v {
        RangeKind::Exclusive => put_varint(out, 0),
