}

pub struct Type {
    pub id: NodeId
    pub span: Span
    pub kind: TypeKind
}

pub fn encode_type(out: &mut Vec<u8>, v: Type) {
    encode_node_id(out, v.id)
    encode_span(out, v.span)
    encode_type_kind(out, v.kind)
}

pub struct TypeAliasDecl {
    pub name: Ident
    pub generics: Generics
    pub ty: Type
    pub nominal: bool
}

pub fn encode_type_alias_decl(out: &mut Vec<u8>, v: TypeAliasDecl) {
    encode_ident(out, v.name)
    encode_generics(out, v.generics)
    encode_type(out, v.ty)
    out.push(if v.nominal { 1 } else { 0 })
}

pub enum TypeKind {
    Unit,
    Never,
    Infer,
    Path(TypePath),
    Tuple(Vec<Type>),
    Array { elem: Type, len: Expr },
    Slice(Type),
    Ref { mutability: Mutability, inner: Type },
    Fn { kind: FnTypeKind, params: Vec<Type>, ret: Option<Type> },
}

pub fn encode_type_kind(out: &mut Vec<u8>, v: TypeKind) {
    match v {
        TypeKind::Unit => put_varint(out, 0),
        TypeKind::Never => put_varint(out, 1),
        TypeKind::Infer => put_varint(out, 2),
        TypeKind::Path(f0) => {
            put_varint(out, 3)
            encode_type_path(out, f0)
        }
        TypeKind::Tuple(f0) => {
            put_varint(out, 4)
            put_varint(out, f0.len() as u64)
            for e1 in f0 {
                encode_type(out, e1)
            }
        }
        TypeKind::Array { elem: f0, len: f1 } => {
            put_varint(out, 5)
            encode_type(out, f0)
            encode_expr(out, f1)
        }
        TypeKind::Slice(f0) => {
            put_varint(out, 6)
            encode_type(out, f0)
        }
        TypeKind::Ref { mutability: f0, inner: f1 } => {
            put_varint(out, 7)
            encode_mutability(out, f0)
            encode_type(out, f1)
        }
        TypeKind::Fn { kind: f0, params: f1, ret: f2 } => {
            put_varint(out, 8)
            encode_fn_type_kind(out, f0)
            put_varint(out, f1.len() as u64)
            for e2 in f1 {
                encode_type(out, e2)
            }
            match f2 {
                Some(e3) => {
                    out.push(1)
                    encode_type(out, e3)
                }
                None => out.push(0)
            }
        }
    }
}

pub struct TypePath {
    pub segments: Vec<TypePathSegment>
}

pub fn encode_type_path(out: &mut Vec<u8>, v: TypePath) {
    put_varint(out, v.segments.len() as u64)
    for e1 in v.segments {
        encode_type_path_segment(out, e1)
    }
}

pub struct TypePathSegment {
    pub name: Ident
    pub generics: Vec<GenericArg>
    pub assoc_bindings: Vec<AssocBinding>
}

pub fn encode_type_path_segment(out: &mut Vec<u8>, v: TypePathSegment) {
    encode_ident(out, v.name)
    put_varint(out, v.generics.len() as u64)
    for e1 in v.generics {
        encode_generic_arg(out, e1)
    }
    put_varint(out, v.assoc_bindings.len() as u64)
    for e2 in v.assoc_bindings {
        encode_assoc_binding(out, e2)
    }
}

pub enum UnaryOp {
    Neg,
    Not,
    RefShared,
    RefMut,
    Deref,
}

pub fn encode_unary_op(out: &mut Vec<u8>, v: UnaryOp) {
    match v {
        UnaryOp::Neg => put_varint(out, 0),
        UnaryOp::Not => put_varint(out, 1),
        UnaryOp::RefShared => put_varint(out, 2),
        UnaryOp::RefMut => put_varint(out, 3),
        UnaryOp::Deref => put_varint(out, 4),
    }
}

pub struct UseDecl {
    pub id: NodeId
    pub span: Span
    pub target: UseTarget
    pub alias: Option<Ident>
    pub list: Option<Vec<UseListEntry>>
    pub module: Vec<String>
    pub cfg: Option<String>
}

pub fn encode_use_decl(out: &mut Vec<u8>, v: UseDecl) {
    encode_node_id(out, v.id)
    encode_span(out, v.span)
    encode_use_target(out, v.target)
    match v.alias {
        Some(e1) => {
            out.push(1)
            encode_ident(out, e1)
        }
        None => out.push(0)
    }
    match v.list {
        Some(e2) => {
            out.push(1)
            put_varint(out, e2.len() as u64)
            for e3 in e2 {
                encode_use_list_entry(out, e3)
            }
        }
        None => out.push(0)
    }
    put_varint(out, v.module.len() as u64)
    for e4 in v.module {
        put_str(out, e4)
    }
    match v.cfg {
        Some(e5) => {
            out.push(1)
            put_str(out, e5)
        }
        None => out.push(0)
    }
}

pub struct UseListEntry {
    pub prefix: Vec<Ident>
    pub name: Ident
    pub alias: Option<Ident>
}

pub fn encode_use_list_entry(out: &mut Vec<u8>, v: UseListEntry) {
    put_varint(out, v.prefix.len() as u64)
    for e1 in v.prefix {
        encode_ident(out, e1)
    }
    encode_ident(out, v.name)
    match v.alias {
        Some(e2) => {
            out.push(1)
            encode_ident(out, e2)
        }
        None => out.push(0)
    }
}

pub enum UseTarget {
    Module(ModulePath),
    Project { id: String, module: Option<ModulePath> },
}

pub fn encode_use_target(out: &mut Vec<u8>, v: UseTarget) {
    match v {
        UseTarget::Module(f0) => {
            put_varint(out, 0)
            encode_module_path(out, f0)
        }
        UseTarget::Project { id: f0, module: f1 } => {
            put_varint(out, 1)
            put_str(out, f0)
            match f1 {
                Some(e1) => {
                    out.push(1)
                    encode_module_path(out, e1)
                }
                None => out.push(0)
            }
        }
    }
}

pub enum Visibility {
    Inherited,
    Package,
    Public,
}

pub fn encode_visibility(out: &mut Vec<u8>, v: Visibility) {
    match v {
        Visibility::Inherited => put_varint(out, 0),
        Visibility::Package => put_varint(out, 1),
        Visibility::Public => put_varint(out, 2),
    }
}

pub struct WhereClause {
    pub predicates: Vec<WherePredicate>
}

pub fn encode_where_clause(out: &mut Vec<u8>, v: WhereClause) {
    put_varint(out, v.predicates.len() as u64)
    for e1 in v.predicates {
        encode_where_predicate(out, e1)
    }
}

pub struct WherePredicate {
    pub bounded: Type
    pub bounds: Vec<TraitBound>
}

pub fn encode_where_predicate(out: &mut Vec<u8>, v: WherePredicate) {
    encode_type(out, v.bounded)
    put_varint(out, v.bounds.len() as u64)
    for e1 in v.bounds {
        encode_trait_bound(out, e1)
    }
}
