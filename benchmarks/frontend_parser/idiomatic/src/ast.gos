pub struct SourceFile {
    pub file: FileId
    pub attrs: Attrs
    pub uses: Vec<UseDecl>
    pub items: Vec<Item>
    pub top_level_stmts: Vec<Stmt>
    pub next_node_id: u32
    pub named_args: Map<NodeId, Vec<NamedArg>>
}

pub fn encode_source_file(out: &mut Vec<u8>, v: SourceFile) {
    encode_file_id(out, v.file)
    encode_attrs(out, v.attrs)
    put_varint(out, v.uses.len() as u64)
    for e1 in v.uses {
        encode_use_decl(out, e1)
    }
    put_varint(out, v.items.len() as u64)
    for e2 in v.items {
        encode_item(out, e2)
    }
    put_varint(out, v.top_level_stmts.len() as u64)
    for e3 in v.top_level_stmts {
        encode_stmt(out, e3)
    }
    put_varint(out, v.next_node_id as u64)
    let mut e4 = v.named_args.keys()
    e4.sort()
    put_varint(out, e4.len() as u64)
    for e5 in e4 {
        encode_node_id(out, e5)
        put_varint(out, v.named_args[e5].len() as u64)
        for e6 in v.named_args[e5] {
            encode_named_arg(out, e6)
        }
    }
}

