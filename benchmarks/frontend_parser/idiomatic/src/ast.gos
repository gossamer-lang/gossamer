// Generated by `cargo xtask schema` from the serde types the frontend blob
// encodes; change those, not this file. Each type is named and shaped as
// its Rust counterpart, and `encode_<name>` writes one as postcard does:
// fields in order, a variant as its index, a length before every
// sequence or map, a map in key order.

/// Appends `v` as an unsigned LEB128 varint.
pub fn put_varint(out: &mut Vec<u8>, v: u64) {
    let mut rest = v
    while rest >= 128 {
        out.push((rest & 127 | 128) as u8)
        rest = rest >> 7
    }
    out.push(rest as u8)
}

/// Appends `v` zigzag-encoded as a varint.
pub fn put_zigzag(out: &mut Vec<u8>, v: i64) {
    put_varint(out, ((v << 1) ^ (v >> 63)) as u64)
}

/// Appends `s` as its byte length and its bytes.
pub fn put_str(out: &mut Vec<u8>, s: String) {
    put_varint(out, s.byte_len() as u64)
    out.extend_from_slice(s.as_bytes())
}

pub enum ArrayExpr {
    List(Vec<Expr>),
    Repeat { value: Expr, count: Expr },
}

pub fn encode_array_expr(out: &mut Vec<u8>, v: ArrayExpr) {
    match v {
        ArrayExpr::List(f0) => {
            put_varint(out, 0)
            put_varint(out, f0.len() as u64)
            for e1 in f0 {
                encode_expr(out, e1)
            }
        }
        ArrayExpr::Repeat { value: f0, count: f1 } => {
            put_varint(out, 1)
            encode_expr(out, f0)
            encode_expr(out, f1)
        }
    }
}

pub enum AssignOp {
    Assign,
    AddAssign,
    SubAssign,
    MulAssign,
    DivAssign,
    RemAssign,
    BitAndAssign,
    BitOrAssign,
    BitXorAssign,
    ShlAssign,
    ShrAssign,
    WrappingAddAssign,
    WrappingSubAssign,
    WrappingMulAssign,
    WrappingShlAssign,
    WrappingShrAssign,
}

pub fn encode_assign_op(out: &mut Vec<u8>, v: AssignOp) {
    match v {
        AssignOp::Assign => put_varint(out, 0),
        AssignOp::AddAssign => put_varint(out, 1),
        AssignOp::SubAssign => put_varint(out, 2),
        AssignOp::MulAssign => put_varint(out, 3),
        AssignOp::DivAssign => put_varint(out, 4),
        AssignOp::RemAssign => put_varint(out, 5),
        AssignOp::BitAndAssign => put_varint(out, 6),
        AssignOp::BitOrAssign => put_varint(out, 7),
        AssignOp::BitXorAssign => put_varint(out, 8),
        AssignOp::ShlAssign => put_varint(out, 9),
        AssignOp::ShrAssign => put_varint(out, 10),
        AssignOp::WrappingAddAssign => put_varint(out, 11),
        AssignOp::WrappingSubAssign => put_varint(out, 12),
        AssignOp::WrappingMulAssign => put_varint(out, 13),
        AssignOp::WrappingShlAssign => put_varint(out, 14),
        AssignOp::WrappingShrAssign => put_varint(out, 15),
    }
}

pub struct AssocBinding {
    pub name: Ident
    pub ty: Type
}

pub fn encode_assoc_binding(out: &mut Vec<u8>, v: AssocBinding) {
    encode_ident(out, v.name)
    encode_type(out, v.ty)
}

pub struct Attribute {
    pub path: PathExpr
    pub tokens: Option<String>
}

pub fn encode_attribute(out: &mut Vec<u8>, v: Attribute) {
    encode_path_expr(out, v.path)
    match v.tokens {
        Some(e1) => {
            out.push(1)
            put_str(out, e1)
        }
        None => out.push(0)
    }
}

pub struct Attrs {
    pub outer: Vec<Attribute>
    pub inner: Vec<Attribute>
}

pub fn encode_attrs(out: &mut Vec<u8>, v: Attrs) {
    put_varint(out, v.outer.len() as u64)
    for e1 in v.outer {
        encode_attribute(out, e1)
    }
    put_varint(out, v.inner.len() as u64)
    for e2 in v.inner {
        encode_attribute(out, e2)
    }
}

pub enum BinaryOp {
    Mul,
    Div,
    Rem,
    WrappingMul,
    Add,
    Sub,
    WrappingAdd,
    WrappingSub,
    Shl,
    Shr,
    WrappingShl,
    WrappingShr,
    BitAnd,
    BitXor,
    BitOr,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    And,
    Or,
    PipeGt,
}

pub fn encode_binary_op(out: &mut Vec<u8>, v: BinaryOp) {
    match v {
        BinaryOp::Mul => put_varint(out, 0),
        BinaryOp::Div => put_varint(out, 1),
        BinaryOp::Rem => put_varint(out, 2),
        BinaryOp::WrappingMul => put_varint(out, 3),
        BinaryOp::Add => put_varint(out, 4),
        BinaryOp::Sub => put_varint(out, 5),
        BinaryOp::WrappingAdd => put_varint(out, 6),
        BinaryOp::WrappingSub => put_varint(out, 7),
        BinaryOp::Shl => put_varint(out, 8),
        BinaryOp::Shr => put_varint(out, 9),
        BinaryOp::WrappingShl => put_varint(out, 10),
        BinaryOp::WrappingShr => put_varint(out, 11),
        BinaryOp::BitAnd => put_varint(out, 12),
        BinaryOp::BitXor => put_varint(out, 13),
        BinaryOp::BitOr => put_varint(out, 14),
        BinaryOp::Eq => put_varint(out, 15),
        BinaryOp::Ne => put_varint(out, 16),
        BinaryOp::Lt => put_varint(out, 17),
        BinaryOp::Le => put_varint(out, 18),
        BinaryOp::Gt => put_varint(out, 19),
        BinaryOp::Ge => put_varint(out, 20),
        BinaryOp::And => put_varint(out, 21),
        BinaryOp::Or => put_varint(out, 22),
        BinaryOp::PipeGt => put_varint(out, 23),
    }
}

pub struct Block {
    pub stmts: Vec<Stmt>
    pub tail: Option<Expr>
    pub synthetic: bool
    pub kind: BlockKind
}

pub fn encode_block(out: &mut Vec<u8>, v: Block) {
    put_varint(out, v.stmts.len() as u64)
    for e1 in v.stmts {
        encode_stmt(out, e1)
    }
    match v.tail {
        Some(e2) => {
            out.push(1)
            encode_expr(out, e2)
        }
        None => out.push(0)
    }
    out.push(if v.synthetic { 1 } else { 0 })
    encode_block_kind(out, v.kind)
}

pub enum BlockKind {
    Plain,
    Arena,
    Cohort,
    Comptime,
}

pub fn encode_block_kind(out: &mut Vec<u8>, v: BlockKind) {
    match v {
        BlockKind::Plain => put_varint(out, 0),
        BlockKind::Arena => put_varint(out, 1),
        BlockKind::Cohort => put_varint(out, 2),
        BlockKind::Comptime => put_varint(out, 3),
    }
}

pub struct ClosureParam {
    pub pattern: Pattern
    pub ty: Option<Type>
}

pub fn encode_closure_param(out: &mut Vec<u8>, v: ClosureParam) {
    encode_pattern(out, v.pattern)
    match v.ty {
        Some(e1) => {
            out.push(1)
            encode_type(out, e1)
        }
        None => out.push(0)
    }
}

pub struct ConstDecl {
    pub name: Ident
    pub ty: Type
    pub value: Expr
}

pub fn encode_const_decl(out: &mut Vec<u8>, v: ConstDecl) {
    encode_ident(out, v.name)
    encode_type(out, v.ty)
    encode_expr(out, v.value)
}

pub struct EnumDecl {
    pub name: Ident
    pub generics: Generics
    pub where_clause: WhereClause
    pub variants: Vec<EnumVariant>
    pub repr: EnumRepr
}

pub fn encode_enum_decl(out: &mut Vec<u8>, v: EnumDecl) {
    encode_ident(out, v.name)
    encode_generics(out, v.generics)
    encode_where_clause(out, v.where_clause)
    put_varint(out, v.variants.len() as u64)
    for e1 in v.variants {
        encode_enum_variant(out, e1)
    }
    encode_enum_repr(out, v.repr)
}

pub struct EnumRepr {
    pub packed: bool
    pub declared_bits: Option<u32>
}

pub fn encode_enum_repr(out: &mut Vec<u8>, v: EnumRepr) {
    out.push(if v.packed { 1 } else { 0 })
    match v.declared_bits {
        Some(e1) => {
            out.push(1)
            put_varint(out, e1 as u64)
        }
        None => out.push(0)
    }
}

pub struct EnumVariant {
    pub attrs: Attrs
    pub name: Ident
    pub body: StructBody
    pub discriminant: Option<Expr>
}

pub fn encode_enum_variant(out: &mut Vec<u8>, v: EnumVariant) {
    encode_attrs(out, v.attrs)
    encode_ident(out, v.name)
    encode_struct_body(out, v.body)
    match v.discriminant {
        Some(e1) => {
            out.push(1)
            encode_expr(out, e1)
        }
        None => out.push(0)
    }
}

pub struct Expr {
    pub id: NodeId
    pub span: Span
    pub kind: ExprKind
}

pub fn encode_expr(out: &mut Vec<u8>, v: Expr) {
    encode_node_id(out, v.id)
    encode_span(out, v.span)
    encode_expr_kind(out, v.kind)
}

pub enum ExprKind {
    ExprLiteral(Literal),
    Path(PathExpr),
    Call { callee: Expr, args: Vec<Expr> },
    MethodCall { receiver: Expr, name: Ident, name_span: Span, desugared_from: Option<Ident>, generics: Vec<GenericArg>, args: Vec<Expr> },
    FieldAccess { receiver: Expr, field: FieldSelector },
    Index { base: Expr, index: Expr },
    Unary { op: UnaryOp, operand: Expr },
    Binary { op: BinaryOp, lhs: Expr, rhs: Expr },
    Assign { op: AssignOp, place: Expr, value: Expr },
    Cast { value: Expr, ty: Type },
    If { condition: Expr, then_branch: Expr, else_branch: Option<Expr> },
    Match { scrutinee: Expr, arms: Vec<MatchArm> },
    Loop { label: Option<Label>, body: Expr },
    While { label: Option<Label>, condition: Expr, body: Expr },
    For { label: Option<Label>, pattern: Pattern, iter: Expr, body: Expr },
    ExprBlock(Block),
    Closure { params: Vec<ClosureParam>, ret: Option<Type>, body: Expr },
    Return(Option<Expr>),
    Break { label: Option<Label>, value: Option<Expr> },
    Continue { label: Option<Label> },
    Tuple(Vec<Expr>),
    MapLiteral(Vec<Expr>),
    SetLiteral(Vec<Expr>),
    Struct { path: PathExpr, fields: Vec<StructExprField>, base: Option<Expr>, syntax: StructExprSyntax },
    Array(ArrayExpr),
    FixedArray(ArrayExpr),
    Range { start: Option<Expr>, end: Option<Expr>, kind: RangeKind },
    Unsafe(Block),
    Try(Expr),
    Select(Vec<SelectArm>),
    Error,
}

pub fn encode_expr_kind(out: &mut Vec<u8>, v: ExprKind) {
    match v {
        ExprKind::ExprLiteral(f0) => {
            put_varint(out, 0)
            encode_literal(out, f0)
        }
        ExprKind::Path(f0) => {
            put_varint(out, 1)
            encode_path_expr(out, f0)
        }
        ExprKind::Call { callee: f0, args: f1 } => {
            put_varint(out, 2)
            encode_expr(out, f0)
            put_varint(out, f1.len() as u64)
            for e1 in f1 {
                encode_expr(out, e1)
            }
        }
        ExprKind::MethodCall { receiver: f0, name: f1, name_span: f2, desugared_from: f3, generics: f4, args: f5 } => {
            put_varint(out, 3)
            encode_expr(out, f0)
            encode_ident(out, f1)
            encode_span(out, f2)
            match f3 {
                Some(e2) => {
                    out.push(1)
                    encode_ident(out, e2)
                }
                None => out.push(0)
            }
            put_varint(out, f4.len() as u64)
            for e3 in f4 {
                encode_generic_arg(out, e3)
            }
            put_varint(out, f5.len() as u64)
            for e4 in f5 {
                encode_expr(out, e4)
            }
        }
        ExprKind::FieldAccess { receiver: f0, field: f1 } => {
            put_varint(out, 4)
            encode_expr(out, f0)
            encode_field_selector(out, f1)
        }
        ExprKind::Index { base: f0, index: f1 } => {
            put_varint(out, 5)
            encode_expr(out, f0)
            encode_expr(out, f1)
        }
        ExprKind::Unary { op: f0, operand: f1 } => {
            put_varint(out, 6)
            encode_unary_op(out, f0)
            encode_expr(out, f1)
        }
        ExprKind::Binary { op: f0, lhs: f1, rhs: f2 } => {
            put_varint(out, 7)
            encode_binary_op(out, f0)
            encode_expr(out, f1)
            encode_expr(out, f2)
        }
        ExprKind::Assign { op: f0, place: f1, value: f2 } => {
            put_varint(out, 8)
            encode_assign_op(out, f0)
            encode_expr(out, f1)
            encode_expr(out, f2)
        }
        ExprKind::Cast { value: f0, ty: f1 } => {
            put_varint(out, 9)
            encode_expr(out, f0)
            encode_type(out, f1)
        }
        ExprKind::If { condition: f0, then_branch: f1, else_branch: f2 } => {
            put_varint(out, 10)
            encode_expr(out, f0)
            encode_expr(out, f1)
            match f2 {
                Some(e5) => {
                    out.push(1)
                    encode_expr(out, e5)
                }
                None => out.push(0)
            }
        }
        ExprKind::Match { scrutinee: f0, arms: f1 } => {
            put_varint(out, 11)
            encode_expr(out, f0)
            put_varint(out, f1.len() as u64)
            for e6 in f1 {
                encode_match_arm(out, e6)
            }
        }
        ExprKind::Loop { label: f0, body: f1 } => {
            put_varint(out, 12)
            match f0 {
                Some(e7) => {
                    out.push(1)
                    encode_label(out, e7)
                }
                None => out.push(0)
            }
            encode_expr(out, f1)
        }
        ExprKind::While { label: f0, condition: f1, body: f2 } => {
            put_varint(out, 13)
            match f0 {
                Some(e8) => {
                    out.push(1)
                    encode_label(out, e8)
                }
                None => out.push(0)
            }
            encode_expr(out, f1)
            encode_expr(out, f2)
        }
        ExprKind::For { label: f0, pattern: f1, iter: f2, body: f3 } => {
            put_varint(out, 14)
            match f0 {
                Some(e9) => {
                    out.push(1)
                    encode_label(out, e9)
                }
                None => out.push(0)
            }
            encode_pattern(out, f1)
            encode_expr(out, f2)
            encode_expr(out, f3)
        }
        ExprKind::ExprBlock(f0) => {
            put_varint(out, 15)
            encode_block(out, f0)
        }
        ExprKind::Closure { params: f0, ret: f1, body: f2 } => {
            put_varint(out, 16)
            put_varint(out, f0.len() as u64)
            for e10 in f0 {
                encode_closure_param(out, e10)
            }
            match f1 {
                Some(e11) => {
                    out.push(1)
                    encode_type(out, e11)
                }
                None => out.push(0)
            }
            encode_expr(out, f2)
        }
        ExprKind::Return(f0) => {
            put_varint(out, 17)
            match f0 {
                Some(e12) => {
                    out.push(1)
                    encode_expr(out, e12)
                }
                None => out.push(0)
            }
        }
        ExprKind::Break { label: f0, value: f1 } => {
            put_varint(out, 18)
            match f0 {
                Some(e13) => {
                    out.push(1)
                    encode_label(out, e13)
                }
                None => out.push(0)
            }
            match f1 {
                Some(e14) => {
                    out.push(1)
                    encode_expr(out, e14)
                }
                None => out.push(0)
            }
        }
        ExprKind::Continue { label: f0 } => {
            put_varint(out, 19)
            match f0 {
                Some(e15) => {
                    out.push(1)
                    encode_label(out, e15)
                }
                None => out.push(0)
            }
        }
        ExprKind::Tuple(f0) => {
            put_varint(out, 20)
            put_varint(out, f0.len() as u64)
            for e16 in f0 {
                encode_expr(out, e16)
            }
        }
        ExprKind::MapLiteral(f0) => {
            put_varint(out, 21)
            put_varint(out, f0.len() as u64)
            for e17 in f0 {
                encode_expr(out, e17)
            }
        }
        ExprKind::SetLiteral(f0) => {
            put_varint(out, 22)
            put_varint(out, f0.len() as u64)
            for e18 in f0 {
                encode_expr(out, e18)
            }
        }
        ExprKind::Struct { path: f0, fields: f1, base: f2, syntax: f3 } => {
            put_varint(out, 23)
            encode_path_expr(out, f0)
            put_varint(out, f1.len() as u64)
            for e19 in f1 {
                encode_struct_expr_field(out, e19)
            }
            match f2 {
                Some(e20) => {
                    out.push(1)
                    encode_expr(out, e20)
                }
                None => out.push(0)
            }
            encode_struct_expr_syntax(out, f3)
        }
        ExprKind::Array(f0) => {
            put_varint(out, 24)
            encode_array_expr(out, f0)
        }
        ExprKind::FixedArray(f0) => {
            put_varint(out, 25)
            encode_array_expr(out, f0)
        }
        ExprKind::Range { start: f0, end: f1, kind: f2 } => {
            put_varint(out, 26)
            match f0 {
                Some(e21) => {
                    out.push(1)
                    encode_expr(out, e21)
                }
                None => out.push(0)
            }
            match f1 {
                Some(e22) => {
                    out.push(1)
                    encode_expr(out, e22)
                }
                None => out.push(0)
            }
            encode_range_kind(out, f2)
        }
        ExprKind::Unsafe(f0) => {
            put_varint(out, 27)
            encode_block(out, f0)
        }
        ExprKind::Try(f0) => {
            put_varint(out, 28)
            encode_expr(out, f0)
        }
        ExprKind::Select(f0) => {
            put_varint(out, 29)
            put_varint(out, f0.len() as u64)
            for e23 in f0 {
                encode_select_arm(out, e23)
            }
        }
        ExprKind::Error => put_varint(out, 30),
    }
}

pub struct FieldPattern {
    pub name: Ident
    pub pattern: Option<Pattern>
}

pub fn encode_field_pattern(out: &mut Vec<u8>, v: FieldPattern) {
    encode_ident(out, v.name)
    match v.pattern {
        Some(e1) => {
            out.push(1)
            encode_pattern(out, e1)
        }
        None => out.push(0)
    }
}

pub enum FieldSelector {
    Named(Ident),
    Index(u32),
}

pub fn encode_field_selector(out: &mut Vec<u8>, v: FieldSelector) {
    match v {
        FieldSelector::Named(f0) => {
            put_varint(out, 0)
            encode_ident(out, f0)
        }
        FieldSelector::Index(f0) => {
            put_varint(out, 1)
            put_varint(out, f0 as u64)
        }
    }
}

pub struct FileId(pub u32)

pub fn encode_file_id(out: &mut Vec<u8>, v: FileId) {
    put_varint(out, v.0 as u64)
}

pub struct FnDecl {
    pub attrs: Attrs
    pub span: Span
    pub is_unsafe: bool
    pub is_comptime: bool
    pub visibility: Visibility
    pub name: Ident
    pub generics: Generics
    pub params: Vec<FnParam>
    pub ret: Option<Type>
    pub where_clause: WhereClause
    pub body: Option<Expr>
    pub extern_abi: Option<String>
}

pub fn encode_fn_decl(out: &mut Vec<u8>, v: FnDecl) {
    encode_attrs(out, v.attrs)
    encode_span(out, v.span)
    out.push(if v.is_unsafe { 1 } else { 0 })
    out.push(if v.is_comptime { 1 } else { 0 })
    encode_visibility(out, v.visibility)
    encode_ident(out, v.name)
    encode_generics(out, v.generics)
    put_varint(out, v.params.len() as u64)
    for e1 in v.params {
        encode_fn_param(out, e1)
    }
    match v.ret {
        Some(e2) => {
            out.push(1)
            encode_type(out, e2)
        }
        None => out.push(0)
    }
    encode_where_clause(out, v.where_clause)
    match v.body {
        Some(e3) => {
            out.push(1)
            encode_expr(out, e3)
        }
        None => out.push(0)
    }
    match v.extern_abi {
        Some(e4) => {
            out.push(1)
            put_str(out, e4)
        }
        None => out.push(0)
    }
}

pub enum FnParam {
    FnParamReceiver(Receiver),
    Typed { pattern: Pattern, ty: Type, is_comptime: bool, default: Option<Expr> },
}

pub fn encode_fn_param(out: &mut Vec<u8>, v: FnParam) {
    match v {
        FnParam::FnParamReceiver(f0) => {
            put_varint(out, 0)
            encode_receiver(out, f0)
        }
        FnParam::Typed { pattern: f0, ty: f1, is_comptime: f2, default: f3 } => {
            put_varint(out, 1)
            encode_pattern(out, f0)
            encode_type(out, f1)
            out.push(if f2 { 1 } else { 0 })
            match f3 {
                Some(e1) => {
                    out.push(1)
                    encode_expr(out, e1)
                }
                None => out.push(0)
            }
        }
    }
}

pub enum FnTypeKind {
    Fn,
    ClosureFn,
    ClosureFnMut,
    ClosureFnOnce,
}

pub fn encode_fn_type_kind(out: &mut Vec<u8>, v: FnTypeKind) {
    match v {
        FnTypeKind::Fn => put_varint(out, 0),
        FnTypeKind::ClosureFn => put_varint(out, 1),
        FnTypeKind::ClosureFnMut => put_varint(out, 2),
        FnTypeKind::ClosureFnOnce => put_varint(out, 3),
    }
}

pub enum GenericArg {
    GenericArgType(Type),
    Const(Expr),
}

pub fn encode_generic_arg(out: &mut Vec<u8>, v: GenericArg) {
    match v {
        GenericArg::GenericArgType(f0) => {
            put_varint(out, 0)
            encode_type(out, f0)
        }
        GenericArg::Const(f0) => {
            put_varint(out, 1)
            encode_expr(out, f0)
        }
    }
}

pub enum GenericParam {
    Lifetime { name: String },
    GenericParamType { name: Ident, bounds: Vec<TraitBound>, default: Option<Type> },
    Const { name: Ident, ty: Type, default: Option<Expr> },
}

pub fn encode_generic_param(out: &mut Vec<u8>, v: GenericParam) {
    match v {
        GenericParam::Lifetime { name: f0 } => {
            put_varint(out, 0)
            put_str(out, f0)
        }
        GenericParam::GenericParamType { name: f0, bounds: f1, default: f2 } => {
            put_varint(out, 1)
            encode_ident(out, f0)
            put_varint(out, f1.len() as u64)
            for e1 in f1 {
                encode_trait_bound(out, e1)
            }
            match f2 {
                Some(e2) => {
                    out.push(1)
                    encode_type(out, e2)
                }
                None => out.push(0)
            }
        }
        GenericParam::Const { name: f0, ty: f1, default: f2 } => {
            put_varint(out, 2)
            encode_ident(out, f0)
            encode_type(out, f1)
            match f2 {
                Some(e3) => {
                    out.push(1)
                    encode_expr(out, e3)
                }
                None => out.push(0)
            }
        }
    }
}

