pub enum Literal {
    Int(String),
    Float(String),
    String(String),
    RawString { hashes: u8, value: String },
    Char(char),
    Byte(u8),
    ByteString(Vec<u8>),
    RawByteString { hashes: u8, value: Vec<u8> },
    Bool(bool),
    Unit,
}

pub fn encode_literal(out: &mut Vec<u8>, v: Literal) {
    match v {
        Literal::Int(f0) => {
            put_varint(out, 0)
            put_str(out, f0)
        }
        Literal::Float(f0) => {
            put_varint(out, 1)
            put_str(out, f0)
        }
        Literal::String(f0) => {
            put_varint(out, 2)
            put_str(out, f0)
        }
        Literal::RawString { hashes: f0, value: f1 } => {
            put_varint(out, 3)
            out.push(f0)
            put_str(out, f1)
        }
        Literal::Char(f0) => {
            put_varint(out, 4)
            put_str(out, f0.to_string())
        }
        Literal::Byte(f0) => {
            put_varint(out, 5)
            out.push(f0)
        }
        Literal::ByteString(f0) => {
            put_varint(out, 6)
            put_varint(out, f0.len() as u64)
            for e1 in f0 {
                out.push(e1)
            }
        }
        Literal::RawByteString { hashes: f0, value: f1 } => {
            put_varint(out, 7)
            out.push(f0)
            put_varint(out, f1.len() as u64)
            for e2 in f1 {
                out.push(e2)
            }
        }
        Literal::Bool(f0) => {
            put_varint(out, 8)
            out.push(if f0 { 1 } else { 0 })
        }
        Literal::Unit => put_varint(out, 9),
    }
}

