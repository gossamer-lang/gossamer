}

pub enum StmtKind {
    Let { pattern: Pattern, ty: Option<Type>, init: Option<Expr> },
    StmtExpr { expr: Expr, has_semi: bool },
    StmtItem(Item),
    Defer(Expr),
}

pub fn encode_stmt_kind(out: &mut Vec<u8>, v: StmtKind) {
    match v {
        StmtKind::Let { pattern: f0, ty: f1, init: f2 } => {
            put_varint(out, 0)
            encode_pattern(out, f0)
            match f1 {
                Some(e1) => {
                    out.push(1)
                    encode_type(out, e1)
                }
                None => out.push(0)
            }
            match f2 {
                Some(e2) => {
                    out.push(1)
                    encode_expr(out, e2)
                }
                None => out.push(0)
            }
        }
        StmtKind::StmtExpr { expr: f0, has_semi: f1 } => {
            put_varint(out, 1)
            encode_expr(out, f0)
            out.push(if f1 { 1 } else { 0 })
        }
        StmtKind::StmtItem(f0) => {
            put_varint(out, 2)
            encode_item(out, f0)
        }
        StmtKind::Defer(f0) => {
            put_varint(out, 3)
            encode_expr(out, f0)
        }
    }
}

pub enum StructBody {
    Named(Vec<StructField>),
