// Structs built from locals and returned, copied into bindings, and walked.
// Every constructor hands its fields to the value it answers.

struct Point {
    x: i64
    y: i64
    tag: String
}

struct Shape {
    name: String
    points: Vec<Point>
    weights: Vec<i64>
}

fn point(i: i64) -> Point {
    let tag = "p".repeat(1 + i % 3)
    Point { x: i, y: i * 2, tag: tag }
}

fn shape(n: i64) -> Shape {
    let mut points = #[]
    let mut weights = #[]
    for i in 0..n {
        points.push(point(i))
        weights.push(i % 5)
    }
    let name = "shape".repeat(2)
    Shape { name: name, points: points, weights: weights }
}

fn walk(s: Shape) -> i64 {
    let mut total = s.name.len()
    for p in s.points { total += p.x + p.y + p.tag.len() }
    for w in s.weights { total += w }
    total
}

fn main() {
    let mut total = 0
    for round in 0..3000 {
        let s = shape(40 + round % 5)
        let copy = s
        total += walk(copy)
    }
    println("{}", total)
}
