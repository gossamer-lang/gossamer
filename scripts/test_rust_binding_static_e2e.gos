// Compiled-mode (`gos build`) e2e for the Rust-binding system.
//
// Usage: gos run scripts/test_rust_binding_static_e2e.gos
//
// Builds each example with `gos build`, runs the produced binary in a
// scrubbed environment with no Rust toolchain on PATH, and asserts the
// same stdout markers the runner produces.
//
// A compiled binary links `libgos_static_bindings.a` plus the gossamer
// runtime, and the codegen lowers binding call sites to direct
// `gos_binding_*` C-ABI calls. The whole pipeline is supposed to work
// without `cargo` / `rustc` on PATH at run time, which is what the
// scrub proves: `env -i` replaces the environment outright, where
// `process::run_in`'s own env pairs override an inherited one.
//
// The toolchain under test is the one this harness builds, at
// `<root>/target/debug/gos`. The interpreter running the harness is
// chosen by whoever invokes it - CI uses `GOS_HARNESS_BIN`.

use std::{env, fs, path, process, sort}

/// The environment scrubber, and the only PATH the built binary is
/// allowed to see.
const ENV_BINARY: String = "/usr/bin/env"
const SCRUBBED_PATH: String = "PATH=/usr/bin:/bin"

/// The checkout the examples live in.
fn repo_root() -> String {
    if let Some(root) = env::var("GOSSAMER_ROOT") {
        return root
    }
    let mut directory = env::current_dir().unwrap_or(".")
    loop {
        if fs::is_dir(path::join(directory, "example-external-libraries")) {
            return directory
        }
        match path::parent(directory) {
            Some(parent) => directory = parent
            None => return "."
        }
    }
}

/// Ends the run with `message` on standard error.
fn fail(message: String) {
    eprintln("test_rust_binding_static_e2e: {}", message)
    process::exit(1)
}

/// The first file `gos build` left in `directory`, by name.
fn produced_binary(directory: String) -> Option<String> {
    let mut names = #[]
    for entry in fs::read_dir(directory).unwrap_or(#[]) {
        if entry.is_file {
            names.push(entry.name)
        }
    }
    let ordered = sort::sort_stable(names)
    if ordered.is_empty() {
        return None
    }
    Some(path::join(directory, ordered[0]))
}

/// Builds one example and runs what it produced, scrubbed.
fn build_and_run(
    gos: String
    label: String
    project: String
    entry: String
    cache: String
    markers: Vec<String>
) {
    println("=> {}", label)
    let _ = fs::remove_dir_all(path::join(project, "target"))
    let environment = #[("XDG_CACHE_HOME", *cache)]
    match process::run_in(gos, #["build", entry], project, environment) {
        Ok(result) => {
            print("{}", result.stdout)
            if result.code != 0 {
                eprint("{}", result.stderr)
                fail(format("{}: the build failed", label))
            }
        }
        Err(e) => fail(format("{}: {}", label, e))
    }
    let Some(binary) = produced_binary(path::join(project, "target/debug")) else {
        fail(format("build did not produce a binary in {}/target/debug", project))
        return
    }
    let scrubbed = process::run_in(ENV_BINARY, #["-i", SCRUBBED_PATH, binary], project, #[])
    let output = match scrubbed {
        Ok(result) => format("{}{}", result.stdout, result.stderr)
        Err(e) => {
            fail(format("{}: {}", label, e))
            return
        }
    }
    print("{}", output)
    if !output.ends_with("\n") {
        println("")
    }
    for marker in markers {
        if !output.contains(marker) {
            fail(format("missing marker '{}' for {}", marker, label))
        }
    }
}

fn main() {
    let root = repo_root()
    println("=> building gos...")
    match process::run_in("cargo", #["build", "-p", "gossamer-cli"], root, #[]) {
        Ok(result) => {
            if result.code != 0 {
                eprint("{}", result.stderr)
                fail("cargo build failed")
            }
        }
        Err(e) => fail(format("cargo build: {}", e))
    }
    let gos = path::join(target_dir(root), "debug/gos")
    if !fs::is_file(gos) {
        fail(format("gos binary not produced at {}", gos))
    }
    let cache = match fs::temp_dir("gos-static-cache-") {
        Ok(cache) => cache
        Err(e) => {
            fail(format("creating a cache directory: {}", e))
            return
        }
    }

    let examples = path::join(root, "example-external-libraries")
    build_and_run(
        gos
        "example 01 (echo-binding) - gos build"
        path::join(examples, "01-gossamer-aware")
        "src/main.gos"
        cache
        #["HELLO, GOSSAMER", "sum: 15", "count: 3"]
    )
    build_and_run(
        gos
        "example 02 (unic-segment wrapper) - gos build"
        path::join(examples, "02-plain-rust-wrapped")
        "src/main.gos"
        cache
        #["count: 10", "grapheme: n", "grapheme: ï"]
    )
    let _ = fs::remove_dir_all(cache)
    println("=> static-link e2e green")
}

/// Where `cargo build` writes: `CARGO_TARGET_DIR` when set, taken relative to
/// `root` unless absolute, else `<root>/target`.
fn target_dir(root: String) -> String {
    let dir = env::var("CARGO_TARGET_DIR").unwrap_or("target")
    if path::is_absolute(dir) { dir } else { path::join(root, dir) }
}
