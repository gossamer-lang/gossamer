// Cross-build the canonical fixture list for a Linux target. The list
// includes the independent Stable all-tier contract fixtures, so cross
// AOT validation cannot drift from native VM/JIT/AOT conformance.
//
// Usage: gos run scripts/cross_build_fixtures.gos <target-triple> <out-base>
//
// Binaries land in <out-base>/<target-triple>/ so several targets can
// share one upload artifact without filename collisions. Used by the
// macOS and Windows host cross CI jobs: they produce the binaries here,
// upload them, and a Linux job runs them (natively for x86_64, under
// QEMU for aarch64) and diffs against the bytecode VM
// (scripts/qemu_diff_against_vm.gos). The runtime archive is supplied
// through the GOS_RUNTIME_LIB_<TRIPLE> environment variable the calling
// job sets, which the build inherits.

use std::{env, fs, os, path, process}

/// The fixture list, relative to the checkout root.
const FIXTURE_LIST: String = "scripts/cross_fixtures.txt"

/// The toolchain this build runs, from `GOS_BIN` or the dev tree.
fn gos_binary() -> String {
    match env::var("GOS_BIN") {
        Some(binary) => binary
        None => {
            if os::family() == "windows" {
                path::join(target_dir("."), "debug/gos.exe")
            } else {
                path::join(target_dir("."), "debug/gos")
            }
        }
    }
}

/// The checkout the fixture list lives in, found by walking up from the
/// working directory.
///
/// Discovered rather than derived from the program's own path: the same
/// source runs as a script and as a compiled binary, and a binary can
/// live anywhere.
fn repo_root() -> String {
    let mut directory = env::current_dir().unwrap_or(".")
    loop {
        if fs::is_file(path::join(directory, FIXTURE_LIST)) {
            return directory
        }
        match path::parent(directory) {
            Some(parent) => directory = parent
            None => return "."
        }
    }
}

/// The fixture paths in `list`, without its comments and blank lines.
fn fixtures(list: String) -> Vec<String> {
    let mut paths = #[]
    for line in list.lines() {
        let entry = line.trim()
        if entry.is_empty() || entry.starts_with("#") {
            continue
        }
        paths.push(entry)
    }
    paths
}

fn main() {
    let args = env::args()
    if args.len() != 2 {
        eprintln("usage: gos run scripts/cross_build_fixtures.gos <target-triple> <out-base>")
        process::exit(2)
    }
    let triple = args[0]
    let out = path::join(args[1], triple)
    let root = repo_root()
    let gos = gos_binary()

    if let Err(e) = fs::create_dir_all(out) {
        eprintln("cross-build: creating {}: {}", out, e)
        process::exit(1)
    }

    let list_path = path::join(root, FIXTURE_LIST)
    let list = match fs::read_to_string(list_path) {
        Ok(text) => text
        Err(e) => {
            eprintln("cross-build: reading {}: {}", list_path, e)
            process::exit(1)
        }
    }

    for src in fixtures(list) {
        println("cross-build {} -> {}", src, triple)
        let source = path::join(root, src)
        let arguments = #[
            "build"
            "--release"
            "--target"
            triple
            source
            "--out-dir"
            out
        ]
        match process::run(gos, arguments) {
            Ok(result) => {
                print("{}", result.stdout)
                eprint("{}", result.stderr)
                if result.code != 0 {
                    eprintln("cross-build: {} failed for {}", triple, src)
                    process::exit(result.code)
                }
            }
            Err(e) => {
                eprintln("cross-build: running {}: {}", gos, e)
                process::exit(1)
            }
        }
    }
}

/// Where `cargo build` writes: `CARGO_TARGET_DIR` when set, taken relative to
/// `root` unless absolute, else `<root>/target`.
fn target_dir(root: String) -> String {
    let dir = env::var("CARGO_TARGET_DIR").unwrap_or("target")
    if path::is_absolute(dir) { dir } else { path::join(root, dir) }
}
