// Gate a perf run against its accepted baseline.
//
// Usage: gos run scripts/perf_compare.gos <baseline> <current>
//
// Each row is `name ns [rss-kib]`. The two kinds of row are gated on
// different terms: a `bench:` row is a calibrated ns/op reading from
// `gos bench` and holds VM throughput tightly, while the legacy
// process-smoke rows time a whole tiny program, so they need a large
// absolute wall-clock delta before a ratio means anything. A
// two-column baseline stays readable, and peak RSS begins gating for a
// row once a three-column entry has been written on main.

use std::{env, fs, process}
use std::collections::Map

/// One row: the reading, and the peak RSS when the baseline carries it.
struct Row {
    ns: i64
    rss: i64
}

/// A row whose RSS column has not been written yet.
const NO_RSS: i64 = -1

/// The rows of `path`, keyed by name, and the names in the order the
/// file states them.
///
/// The report walks the current file in its own order, so a reader
/// comparing two runs sees the rows where the run wrote them. A name
/// stated twice keeps its first position and its last reading.
fn load(path: String) -> (Map<String, Row>, Vec<String>) {
    let mut rows: Map<String, Row> = Map::new()
    let mut order = #[]
    let text = match fs::read_to_string(path) {
        Ok(text) => text
        Err(e) => {
            eprintln("perf_compare: reading {}: {}", path, e)
            process::exit(1)
        }
    }
    for line in text.lines() {
        let parts = line.split_whitespace()
        if parts.len() < 2 {
            continue
        }
        let ns = parts[1].to_i64().unwrap_or(0)
        let rss = if parts.len() >= 3 { parts[2].to_i64().unwrap_or(NO_RSS) } else { NO_RSS }
        let name = parts[0]
        if !rows.contains_key(name) {
            order.push(name)
        }
        rows.insert(name, Row { ns: ns, rss: rss })
    }
    (rows, order)
}

/// A ratio rendered the way the report has always rendered one.
fn ratio_text(numerator: i64, denominator: i64) -> String {
    if denominator == 0 {
        return "inf"
    }
    format("{:.2}", numerator as f64 / denominator as f64)
}

fn main() {
    let args = env::args()
    if args.len() != 2 {
        eprintln("usage: gos run scripts/perf_compare.gos <baseline> <current>")
        process::exit(2)
    }
    let base, _ = load(args[0])
    let curr, names = load(args[1])
    let mut regressions = #[]

    for name in names {
        let row = curr.get(name).unwrap_or(Row { ns: 0, rss: NO_RSS })
        let Some(base_row) = base.get(name) else {
            println("  {}: no baseline yet [NEW]", name)
            continue
        }
        let ratio = ratio_text(row.ns, base_row.ns)
        let time_delta = row.ns - base_row.ns
        let gates_rss = row.rss != NO_RSS && base_row.rss > 0
        let rss_ratio = if gates_rss { ratio_text(row.rss, base_row.rss) } else { "" }

        let calibrated = name.starts_with("bench:")
        let limit_ratio = if calibrated { 1.25 } else { 1.5 }
        let min_delta = if calibrated {
            max(500, base_row.ns * 5 / 100)
        } else {
            10_000_000
        }
        let value_text = if calibrated {
            format("{} ns/op (baseline {} ns/op, {}x)", row.ns, base_row.ns, ratio)
        } else {
            format(
                "{}ms (baseline {}ms, {}x)"
                row.ns / 1_000_000
                base_row.ns / 1_000_000
                ratio
            )
        }

        let time_regressed = base_row.ns > 0 &&
            row.ns as f64 / base_row.ns as f64 >= limit_ratio &&
            time_delta >= min_delta
        let rss_regressed = gates_rss && row.rss as f64 / base_row.rss as f64 >= 1.5
        let status = if time_regressed || rss_regressed { "REGRESSION" } else { "OK" }
        let rss_text = if gates_rss {
            format("RSS {}KiB (baseline {}KiB, {}x)", row.rss, base_row.rss, rss_ratio)
        } else {
            "RSS baseline pending"
        }
        println("  {}: {}; {} [{}]", name, value_text, rss_text, status)
        if time_regressed || rss_regressed {
            regressions.push(name)
        }
    }

    if !regressions.is_empty() {
        println("")
        println("Perf regressions:")
        for name in regressions {
            println("  {}", name)
        }
        println("::warning::Perf baseline comparison regressed; see uploaded perf-log artifact")
    }
}
