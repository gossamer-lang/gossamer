// Compiled-tier leak oracle: peak RSS may not grow with the loop count.
//
// A reference-counted value the compiled tiers never release shows up as
// RSS that scales with how many times the loop ran. Every probe below
// holds nothing across iterations, so its peak belongs to one iteration
// whatever the count - running it at N and at 4N and comparing the two
// peaks says whether anything is being kept. Tier parity cannot see this
// at all: a leaking program prints exactly what a correct one prints.
//
// The oracle needs no baseline from another tier. Comparing against the
// bytecode VM was the obvious shape and is the wrong one: `gos run`
// promotes hot bodies, so the reference leaks alongside the thing it is
// supposed to bound.
//
// Usage: gos run scripts/leak_oracle.gos [gos-binary]

use std::{env, fs, path, process}

/// Iterations the small run makes; the large run makes four times as many.
const SMALL: i64 = 50000

/// How much the large run may exceed the small one. A correct program's
/// peak is one iteration's allocation plus a fixed runtime, so the two
/// runs differ only by allocator noise; a per-iteration leak at these
/// counts is tens of megabytes.
const SLACK_KB: i64 = 4096

/// Probes whose growth is a known-open bug: exercised and reported on every
/// run, but not a gate, because the leak they show has not been fixed yet. A
/// name leaves this list in the same change that fixes it.
fn known_open() -> Vec<String> {
    #[]
}

/// Programs whose peak belongs to one iteration, each written against a
/// `COUNT` the harness substitutes.
fn probes() -> Vec<(String, String)> {
    #[
        ("struct_vec_field", """
        struct Node { kids: Vec<i64> }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT { let t = Node { kids: #[i, i + 1] }; acc += t.kids.len() }
            println("{}", acc)
        }
        """)
        ("struct_string_and_vec", """
        struct Row { name: String, cells: Vec<i64> }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                let r = Row { name: format("r{}", i), cells: #[i, i + 1, i + 2] }
                acc += r.cells.len() + r.name.len()
            }
            println("{}", acc)
        }
        """)
        ("tuple_vec_element", """
        fn main() {
            let mut acc = 0
            for i in 0..COUNT { let t = (i, #[i, i + 1]); acc += t.1.len() }
            println("{}", acc)
        }
        """)
        ("enum_vec_payload", """
        enum Holder { Empty, Full(Vec<i64>) }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                let h = Holder::Full(#[i, i + 1])
                acc += match h { Holder::Empty => 0, Holder::Full(v) => v.len() }
            }
            println("{}", acc)
        }
        """)
        ("nested_struct_tree", """
        struct Node { name: String, kids: Vec<Node> }
        fn build(d: i64) -> Node {
            if d == 0 { return Node { name: "leaf", kids: #[] } }
            Node { name: format("n{}", d), kids: #[build(d - 1), build(d - 1)] }
        }
        fn count(n: Node) -> i64 { let mut c = 1; for k in n.kids { c += count(k) }; c }
        fn main() {
            let mut acc = 0
            for _ in 0..(COUNT / 5000) { let t = build(8); acc += count(t) }
            println("{}", acc)
        }
        """)
        ("clone_then_walk_tree", """
        struct Node { name: String, kids: Vec<Node> }
        fn build(d: i64) -> Node {
            if d == 0 { return Node { name: "leaf", kids: #[] } }
            Node { name: format("n{}", d), kids: #[build(d - 1), build(d - 1)] }
        }
        fn count(n: Node) -> i64 { let mut c = 1; for k in n.kids { c += count(k) }; c }
        fn main() {
            let mut acc = 0
            for _ in 0..(COUNT / 5000) {
                let t = build(8)
                let u = t.clone()
                acc += count(u)
            }
            println("{}", acc)
        }
        """)
        ("map_in_struct_field", """
        struct C { pages: Map<i64, i64> }
        fn fill(c: &mut C, i: i64) { c.pages = Map::from([(i, i + 1)]) }
        fn main() {
            let mut c = C { pages: Map::new() }
            for i in 0..COUNT { fill(&mut c, i) }
            println("{}", c.pages.len())
        }
        """)
        ("closure_over_vec", """
        fn main() {
            let mut total = 0
            for i in 0..COUNT {
                let xs = #[i, i + 1, i + 2]
                let f = |k: i64| xs.len() + k
                total += f(1)
            }
            println("{}", total)
        }
        """)
        ("map_field_replaced", """
        struct Cache { pages: Map<i64, Vec<u8>>, seen: Set<i64>, hits: i64 }
        fn fill(cache: &mut Cache, page: i64) {
            cache.pages.insert(page, #[7u8; 4])
            let _ = cache.seen.insert(page)
            cache.hits += 1
            cache.pages = Map::from([(page, #[1u8, 2u8])])
        }
        fn main() {
            let mut acc = 0
            for round in 0..(COUNT / 500) {
                let mut cache = Cache { pages: Map::new(), seen: Set::new(), hits: 0 }
                for i in 0..50 { fill(&mut cache, i) }
                acc += cache.pages.len() + cache.hits + cache.seen.len()
            }
            println("{}", acc)
        }
        """)
        ("closures_in_vec", """
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                let mut fs: Vec<Fn(i64) -> i64> = #[]
                let tag = format("t{}", i)
                fs.push(|x| x + tag.len())
                acc += fs[0](1)
            }
            println("{}", acc)
        }
        """)
        ("closures_as_map_values", """
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                let mut m: Map<i64, Fn(i64) -> i64> = Map::new()
                let tag = format("t{}", i)
                let other = format("u{}", i)
                m.insert(i, |x| x + tag.len())
                m.insert(i + 1, |x| x + other.len())
                acc += m.get(i).unwrap()(1) + m.len()
            }
            println("{}", acc)
        }
        """)
        ("struct_on_channel", """
        use std::sync::channel
        struct Msg { name: String, body: String, n: i64 }
        fn produce(tx: Sender<Msg>) {
            for i in 0..COUNT { tx.send(Msg { name: format("a{}", i), body: format("b{}", i), n: i }) }
            tx.close()
        }
        fn main() {
            let tx, rx = channel()
            spawn(|| produce(tx))
            let mut acc = 0
            while let Some(m) = rx.recv() { acc += m.n + m.name.len() + m.body.len() }
            println("{}", acc)
        }
        """)
        ("option_field_if_let", """
        struct Msg { opt: Option<String>, n: i64 }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                let m = Msg { opt: Some(format("o{}", i)), n: i }
                if let Some(o) = m.opt { acc += o.len() }
            }
            println("{}", acc)
        }
        """)
        ("set_rebuilt", """
        fn main() {
            let mut n = 0
            for i in 0..COUNT { let mut s = Set::new(); s.insert(i); n += s.len() }
            println("{}", n)
        }
        """)
        ("deque_rebuilt", """
        fn main() {
            let mut n = 0
            for i in 0..COUNT { let d = Deque::from([i, i + 1]); n += d.len() }
            println("{}", n)
        }
        """)
        ("stack_rebuilt", """
        fn main() {
            let mut n = 0
            for i in 0..COUNT { let s = Stack::from([i, i + 1]); n += s.len() }
            println("{}", n)
        }
        """)
        ("vec_rebound_through_try", """
        struct V { tag: u8, s: String }
        fn decode(n: i64) -> Result<Vec<V>, String> { Ok(#[V { tag: 1, s: format("v{}", n) }]) }
        fn keep(p: i64) -> Result<i64, String> {
            let mut vals: Vec<V> = #[]
            if p > 0 { vals = decode(p)? }
            if p < 2 { vals = decode(2)? }
            Ok(vals.len())
        }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT { acc += keep(i % 3).unwrap_or(0) }
            println("{}", acc)
        }
        """)
        ("vec_read_then_stored_in_ok", """
        struct Res { rows: Vec<String>, count: i64 }
        fn build(i: i64) -> Result<Res, String> {
            let mut rows: Vec<String> = #[]
            rows.push(format("r{}", i))
            Ok(Res { rows: rows, count: rows.len() })
        }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                match build(i) {
                    Ok(r) => acc += r.count
                    Err(e) => println("{}", e)
                }
            }
            println("{}", acc)
        }
        """)
        ("tuple_filled_through_mut_ref", """
        fn fill(i: i64, rows: &mut Vec<String>) { rows.push(format("r{}", i)) }
        fn walk(i: i64) -> (i64, Vec<String>) {
            let mut rows: Vec<String> = #[]
            fill(i, &mut rows)
            fill(i + 1, &mut rows)
            (i, rows)
        }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT { acc += walk(i).1.len() }
            println("{}", acc)
        }
        """)
        ("enum_struct_payload_param", """
        struct Q { table: String, cols: Vec<i64> }
        enum Stmt { Select(Q), Compact }
        fn parse(i: i64) -> Result<Stmt, String> {
            Ok(Stmt::Select(Q { table: format("t{}", i), cols: #[i] }))
        }
        fn arity(s: Stmt) -> i64 {
            match s {
                Stmt::Select(q) => q.cols.len()
                Stmt::Compact => 0
            }
        }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT {
                match parse(i) {
                    Ok(s) => acc += arity(s)
                    Err(e) => println("{}", e)
                }
            }
            println("{}", acc)
        }
        """)
        ("enum_struct_payload_try", """
        struct Q { table: String, cols: Vec<i64> }
        enum Stmt { Select(Q), Compact }
        fn parse(i: i64) -> Result<Stmt, String> {
            Ok(Stmt::Select(Q { table: format("t{}", i), cols: #[i] }))
        }
        fn exec(i: i64) -> Result<i64, String> {
            match parse(i)? {
                Stmt::Select(q) => Ok(q.cols.len() + q.table.len())
                Stmt::Compact => Ok(0)
            }
        }
        fn main() {
            let mut acc = 0
            for i in 0..COUNT { acc += exec(i).unwrap_or(0) }
            println("{}", acc)
        }
        """)
        ("map_of_vecs", """
        fn main() {
            let mut acc = 0
            for round in 0..(COUNT / 500) {
                let mut m = Map::new()
                for i in 0..500 { m.insert(format("k{}", i), #[i, round]) }
                for (k, v) in m { acc += v[0] + k.len() }
            }
            println("{}", acc)
        }
        """)
    ]
}

/// Peak RSS in KB of `argv`, or `None` when the run failed.
///
/// `/usr/bin/time -v` reports the kernel's own high-water mark, which is
/// the only number that reflects memory the program never gave back.
fn peak_rss_kb(argv: Vec<String>) -> Option<i64> {
    let mut full = #["-v"]
    for a in argv { full.push(a) }
    let out = match process::run("/usr/bin/time", full) {
        Ok(out) => out
        Err(e) => {
            eprintln("leak_oracle: running the probe: {}", e)
            return None
        }
    }
    if out.code != 0 {
        eprintln("leak_oracle: probe exited {}: {}", out.code, out.stderr)
        return None
    }
    for line in out.stderr.split("\n") {
        let trimmed = line.trim()
        if trimmed.starts_with("Maximum resident set size") {
            if let Some((_, value)) = trimmed.split_once(":") {
                return value.trim().to_i64()
            }
        }
    }
    None
}

/// Builds `source` with `COUNT` substituted and answers the binary's peak.
///
/// Each probe gets its own output directory, because `--out-dir` names the
/// directory and the binary keeps the source's stem - so the two counts of
/// one probe would otherwise land on the same path.
fn peak_at(gos: String, dir: String, name: String, source: String, count: i64) -> Option<i64> {
    let out = path::join(dir, format("{}_{}", name, count))
    let src = path::join(out, format("{}.gos", name))
    let bin = path::join(out, name)
    if let Err(e) = fs::create_dir_all(out) {
        eprintln("leak_oracle: creating {}: {}", out, e)
        return None
    }
    if let Err(e) = fs::write(src, source.replace("COUNT", format("{}", count)).as_bytes()) {
        eprintln("leak_oracle: writing {}: {}", src, e)
        return None
    }
    match process::run(gos, #["build", "--out-dir", out, src]) {
        Ok(out) => {
            if out.code != 0 {
                eprintln("leak_oracle: {}: build failed: {}", name, out.stderr)
                return None
            }
        }
        Err(e) => {
            eprintln("leak_oracle: {}: build failed: {}", name, e)
            return None
        }
    }
    peak_rss_kb(#[bin])
}

fn main() {
    let args = env::args()
    let gos = if args.len() > 0 { args[0] } else { "./target/debug/gos" }
    let dir = path::join(env::temp_dir(), "gos-leak-oracle")
    // A binary left by an earlier run would be measured instead of the one
    // this run builds, so the tree starts empty.
    let _ = fs::remove_dir_all(dir)
    if let Err(e) = fs::create_dir_all(dir) {
        eprintln("leak_oracle: creating {}: {}", dir, e)
        process::exit(1)
    }
    let mut failures = #[]
    for (name, source) in probes() {
        let Some(small) = peak_at(gos, dir, name, source, SMALL) else {
            failures.push(name)
            continue
        }
        let Some(large) = peak_at(gos, dir, name, source, SMALL * 4) else {
            failures.push(name)
            continue
        }
        let budget = small + SLACK_KB
        let grew = large > budget
        let open = known_open().contains(name)
        let verdict = if grew && open {
            "LEAK (known open)"
        } else if grew {
            "LEAK"
        } else {
            "ok"
        }
        println("{:<24} n={:>8} KB  4n={:>8} KB  budget={:>8} KB  {}"
            name, small, large, budget, verdict)
        if grew && !open {
            failures.push(name)
        }
    }
    if failures.len() > 0 {
        eprintln("leak_oracle: {} probe(s) grew with the loop count: {:?}"
            failures.len(), failures)
        process::exit(1)
    }
    println("leak_oracle: no probe's peak grew with the loop count")
}
