// End-to-end test for the Rust-binding system.
//
// Usage: gos run scripts/test_rust_binding_e2e.gos
//
// Walks the whole path:
//
// 1. Build the `gos` binary (debug profile; release also works and is
//    slower).
// 2. Synthesise a temp project whose `project.toml` declares
//    `[rust-bindings] tuigoose = { path = ... }` and whose `main.gos`
//    imports `tuigoose::layout::rect` and dispatches it.
// 3. Run that `gos` against the project. It detects `[rust-bindings]`,
//    builds a per-project runner through cargo (statically linking
//    tuigoose plus gossamer-cli), and `execve`s into it.
// 4. The runner's `main` calls `tuigoose::binding::force_link()` plus
//    `gossamer_binding::install_all()`, then re-enters the CLI, which
//    interprets `main.gos` with the binding entries already installed.
// 5. `main.gos` prints known marker lines. Any non-zero exit, missing
//    marker, or runner-build failure is a hard fail.
//
// Slow on the first run (it cargo-builds the runner) and sub-second
// afterwards, since the runner workspace is cached.
//
// Environment overrides:
//   GOSSAMER_ROOT   path to the gossamer source tree (defaults to the
//                   checkout this harness is in).
//   TUIGOOSE_ROOT   path to the tuigoose source tree (defaults to
//                   <GOSSAMER_ROOT>/../tuigoose).
//   GOSSAMER_CACHE  runner-build cache root; the cargo target dir then
//                   lives under <cache>/runners/<fp>/target/.
//   KEEP_TEMP       set to 1 to leave the synthesised project behind.
//
// The toolchain under test is the one this harness builds. The
// interpreter running the harness is chosen by whoever invokes it - CI
// uses `GOS_HARNESS_BIN`.

use std::{env, fs, path, process}

/// The program the synthesised project runs. Every marker the harness
/// greps for comes from one of these lines.
const SAMPLE_SOURCE: String = """
use tuigoose::layout::rect
use tuigoose::layout::split_vertical
use tuigoose::block::bordered_all
use tuigoose::block::with_title
use tuigoose::paragraph::new
use tuigoose::paragraph::with_block
use tuigoose::render::paragraph_to_string
use tuigoose::render::drop_block
use tuigoose::render::drop_paragraph

fn main() {
    let quad = rect(0, 0, 12, 4)
    println("rect: {}", quad)

    let parts = split_vertical(quad, [2, 2])
    println("split_count: {}", parts)

    let block = bordered_all()
    let block = with_title(block, "hi")
    let para = new("hello world")
    let para = with_block(para, block)
    let rendered = paragraph_to_string(para, 12, 4)
    println("rendered: {}", rendered)

    let _ = drop_block(block)
    let _ = drop_paragraph(para)
    println("done")
}
"""

/// The checkout this harness lives in.
fn repo_root() -> String {
    if let Some(root) = env::var("GOSSAMER_ROOT") {
        return root
    }
    let mut directory = env::current_dir().unwrap_or(".")
    loop {
        if fs::is_dir(path::join(directory, "example-external-libraries")) {
            return directory
        }
        match path::parent(directory) {
            Some(parent) => directory = parent
            None => return "."
        }
    }
}

/// Ends the run with `message` on standard error and `code`.
fn fail(message: String, code: i64) {
    eprintln("test_rust_binding_e2e: {}", message)
    process::exit(code)
}

fn main() {
    let root = repo_root()
    let tuigoose = env::var("TUIGOOSE_ROOT")
        .unwrap_or(path::join(root, "../tuigoose"))
    if !fs::is_dir(tuigoose) {
        eprintln("test_rust_binding_e2e: tuigoose not found at {}", tuigoose)
        eprintln("  Set TUIGOOSE_ROOT or place tuigoose at <GOSSAMER_ROOT>/../tuigoose.")
        process::exit(2)
    }

    println("=> building gossamer-cli (debug)...")
    match process::run_in("cargo", #["build", "-p", "gossamer-cli"], root, #[]) {
        Ok(result) => {
            if result.code != 0 {
                eprint("{}", result.stderr)
                fail("cargo build failed", 2)
            }
        }
        Err(e) => fail(format("cargo build: {}", e), 2)
    }
    let gos = path::join(target_dir(root), "debug/gos")
    if !fs::is_file(gos) {
        fail(format("gos binary not produced at {}", gos), 2)
    }

    let work = match fs::temp_dir("gos-binding-e2e-") {
        Ok(work) => work
        Err(e) => {
            fail(format("creating a scratch directory: {}", e), 2)
            return
        }
    }
    let keep = env::var("KEEP_TEMP").unwrap_or("")
    if !keep.is_empty() {
        println("test_rust_binding_e2e: leaving {} for inspection", work)
    }

    let project = path::join(work, "sample-app")
    let _ = fs::create_dir_all(path::join(project, "src"))
    let manifest = format(
        """
        [project]
        id = "example.com/binding-e2e"
        version = "0.1.0"

        [dependencies]

        [rust-bindings]
        tuigoose = {{ path = "{}" }}
        """
        tuigoose
    )
    let _ = fs::write(path::join(project, "project.toml"), manifest.as_bytes())
    let _ = fs::write(path::join(project, "src/main.gos"), SAMPLE_SOURCE.as_bytes())

    println("=> running gos in {}...", project)
    // The runner builds synchronously and its output is forwarded, so a
    // cargo failure surfaces here rather than as a bare exit code.
    let mut environment = #[]
    if let Some(cache) = env::var("GOSSAMER_CACHE") {
        environment.push(("XDG_CACHE_HOME", cache))
    }
    let outcome = process::run_in(gos, #["run", "src/main.gos"], project, environment)
    let output, code = match outcome {
        Ok(result) => (format("{}{}", result.stdout, result.stderr), result.code)
        Err(e) => {
            fail(format("running the project: {}", e), 1)
            return
        }
    }
    print("{}", output)
    if !output.ends_with("\n") {
        println("")
    }
    if code != 0 {
        fail(format("gos failed (exit {})", code), 1)
    }
    for marker in #["rect:", "split_count:", "rendered:", "hello", "done", "┌hi"] {
        if !output.contains(marker) {
            fail(format("missing marker '{}' on stdout", marker), 1)
        }
    }
    if keep.is_empty() {
        let _ = fs::remove_dir_all(work)
    }
    println("=> ok (cached runner: {})", project)
}

/// Where `cargo build` writes: `CARGO_TARGET_DIR` when set, taken relative to
/// `root` unless absolute, else `<root>/target`.
fn target_dir(root: String) -> String {
    let dir = env::var("CARGO_TARGET_DIR").unwrap_or("target")
    if path::is_absolute(dir) { dir } else { path::join(root, dir) }
}
