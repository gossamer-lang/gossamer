/*
 * Process environment - env vars, args, working directory.
 *
 * Demonstrates the `std::env` surface for inspecting the
 * process state. Falls back gracefully when an env var is
 * missing.
 */

use std::{env, iter}

fn report_env(name: String) {
    match env::var(name) {
        Some(v) => println(f"  {name} = {v}")
        None => println(f"  {name} (unset)")
    }
}

println("argv:")
let args = env::args()
for i in 0..args.len() {
    println(f"  argv[{i}] = {args[i]}")
}

println("\nenvironment (selected):")
let env_vars = #["PATH", "HOME", "USER", "GOSSAMER_DEBUG"]
env_vars |> |v| iter::for_each(v, |name| report_env(name))

match env::current_dir() {
    Ok(dir) => println(f"\ncwd: {dir}")
    Err(e) => println(f"\ncwd error: {e}")
}
