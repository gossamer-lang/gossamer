/*
 * Media type parsing and extension lookup with `std::mime`.
 *
 * RFC 2045 type/subtype + parameters (charset, boundary, etc.) plus
 * filename-extension <-> media-type tables backed by IANA registries.
 */

use std::mime

let html = "text/html; charset=utf-8"
println(f"parsed: {mime::parse(html)}")
println(f"top: {mime::top(html)}")
println(f"sub: {mime::sub(html)}")
println(f"charset: {mime::charset(html)}")

let multi = "multipart/form-data; boundary=----abc123"
println(f"multi boundary: {mime::boundary(multi)}")

println(f"ext for text/html: {mime::extension_by_type("text/html")}")
println(f"type for .png: {mime::type_by_extension(".png")}")
println(f"type for json: {mime::type_by_extension("json")}")

println(f"valid: {mime::is_valid("application/json")}")
println(f"invalid: {mime::is_valid("nope")}")
