use std::{errors, image}
use std::image::{Image, Rgba}

fn png_width() -> Result<i64, errors::Error> {
    let mut source = Image::filled(2, 1, Rgba { r: 255, g: 0, b: 0, a: 255 })?
    source.set_pixel(1, 0, Rgba { r: 0, g: 255, b: 0, a: 255 })
    let decoded = image::decode(source.encode_png()?)?
    Ok(decoded.width())
}

println(png_width().unwrap())
println(png_width().unwrap())
let mut source = Image::filled(2, 1, Rgba { r: 255, g: 0, b: 0, a: 255 }).unwrap()
source.set_pixel(1, 0, Rgba { r: 0, g: 255, b: 0, a: 255 })
println(source.pixel(1, 0).unwrap())
println(image::decode(source.encode_jpeg(quality: 90).unwrap()).unwrap().height())
