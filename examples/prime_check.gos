/*
 * Primality test - trial division up to sqrt(n).
 *
 * `is_prime` is a pure function: it inspects `n` and returns a
 * `bool` without changing any caller state. Demonstrates `for
 * _ in lo..=hi` ranges, early `return`, and idiomatic guard
 * conditions.
 */

fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false
    }
    if n < 4 {
        return true              // 2 and 3
    }
    if n % 2 == 0 {
        return false
    }
    // Trial-divide by odd factors only; stop at sqrt(n).
    let mut d: i64 = 3
    while d * d <= n {
        if n % d == 0 { return false }
        d += 2
    }
    true
}

print("primes ≤ 50:")
for n in 0..=50 {
    if is_prime(n) {
        print(f" {n}")
    }
}
println()

// A few targeted spot-checks.
for (n, expected) in [(2, true), (3, true), (4, false), (97, true)
    (100, false), (7919, true), (7920, false)] {
    let actual = is_prime(n)
    let label = if actual == expected { "ok" } else { "WRONG" }
    println(f"is_prime({n}) = {actual} (expected {expected}): {label}")
}
