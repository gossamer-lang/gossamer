/*
 * Data compression with std::compress.
 *
 * Three codecs are available: gzip (RFC 1952), raw DEFLATE (RFC 1951),
 * and zlib (RFC 1950). Each follows the same pattern: compress(data,
 * level) -> Result<[u8], Error>, decompress(data) -> Result<[u8], Error>.
 * Level 0 is fastest, level 9 is best compression; level 6 is the
 * standard default.
 *
 * The compressed bytes are binary, so the example prints lengths rather
 * than raw content. For text-heavy payloads, expect 60-80% reduction.
 */

use std::compress

fn show_roundtrip(name: str, compressed: Result<Vec<u8>, compress::Error>, original_len: i64) {
    match compressed {
        Ok(bytes) => {
            let ratio = bytes.len() * 100 / original_len
            println(f"{name}: {original_len} -> {bytes.len()} bytes ({ratio}%)")
        }
        Err(e) => println(f"{name}: error: {e}")
    }
}

#[lint(allow(string_literal_concat))]
fn main() {
    let data = "The quick brown fox jumps over the lazy dog. " +
        "Pack my box with five dozen liquor jugs. " +
        "How vexingly quick daft zebras jump! " +
        "The five boxing wizards jump quickly."

    let n = data.len()

    let gz = compress::gzip::encode(data.clone().as_bytes(), 6)
    show_roundtrip("gzip", gz, n)

    let fl = compress::flate::compress(data.clone().as_bytes(), 6)
    show_roundtrip("flate", fl, n)

    let zl = compress::zlib::compress(data.clone().as_bytes(), 6)
    show_roundtrip("zlib", zl, n)

    // Verify roundtrip for gzip.
    let gz2 = compress::gzip::encode(data.clone().as_bytes(), 6)
    match gz2 {
        Ok(compressed) => {
            let restored = compress::gzip::decode(compressed)
            match restored {
                Ok(bytes) => {
                    if bytes.len() == n {
                        println(f"gzip roundtrip: ok ({n} bytes)")
                    } else {
                        println("gzip roundtrip: size mismatch")
                    }
                }
                Err(e) => println(f"gzip decode err: {e}")
            }
        }
        Err(e) => println(f"gzip encode err: {e}")
    }
}
