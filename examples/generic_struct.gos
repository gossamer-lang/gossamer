// Generic structs in Gossamer.
//
// A struct declared with type parameters `<A, B, ...>` is
// monomorphised at each construction site. The typechecker infers
// each parameter from the field values, so no turbofish annotation
// is required at the call site.
//
// Field reads carry the per-instance concrete type: when both
// fields share the same type parameter (e.g. `SameType<T>`),
// arithmetic across those fields typechecks without any annotation.
//
// Run with:
//   gos run examples/generic_struct.gos
//   gos build examples/generic_struct.gos

// Two independent type parameters.
struct Pair<A, B> {
    fst: A
    snd: B
}

// Single type parameter shared by both fields.
struct SameType<T> {
    left: T
    right: T
}

// Three independent type parameters.
struct Triple<A, B, C> {
    first: A
    second: B
    third: C
}

// Pair: same struct, three concrete type combinations - each
// instantiation is independent and the typechecker infers the
// parameters from the field values.
let int_pair = Pair { fst: 10, snd: 32 }
let str_pair = Pair { fst: "hello", snd: "world" }
let mixed = Pair { fst: 7, snd: "seven" }

// Both fields of int_pair resolve to i64 at this site, so
// arithmetic across them works without any extra annotation.
println(f"{int_pair.fst} + {int_pair.snd} = {int_pair.fst + int_pair.snd}")
println(f"{str_pair.fst} {str_pair.snd}")
println(f"{mixed.fst} is {mixed.snd}")

// SameType: left and right are the same concrete type here.
let counts = SameType { left: 100, right: 200 }
println(f"total: {counts.left + counts.right}")

// Triple: three independent type parameters, all inferred.
let record = Triple { first: 1, second: "two", third: 3.0 }
println(f"{record.first} {record.second} {record.third}")
