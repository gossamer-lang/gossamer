/*
 * Positional construction can copy selected fields from an existing struct
 * while changing another field. The base stays usable afterward because its
 * heap fields are shared and retained, not moved.
 */

struct Config {
    host: String
    port: i64
    verbose: bool
}

let base = Config { host: "localhost", port: 8080, verbose: false }

// Override one scalar field; host is copied from base.
let prod = Config { host: base.host, port: 443, verbose: base.verbose }

let remote = Config { host: "example.com", port: base.port, verbose: base.verbose }

println(f"base:   {base.host} {base.port} {base.verbose}")
println(f"prod:   {prod.host} {prod.port} {prod.verbose}")
println(f"remote: {remote.host} {remote.port} {remote.verbose}")
