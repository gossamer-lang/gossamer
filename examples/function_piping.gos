/*
 * Forward-pipe operator `|>`: composing free functions.
 *
 * A free function has no receiver, so a chain of them nests inside-out
 * and reads right to left. `|>` puts it back in reading order. This is
 * the functional-style tool - reach for it when a value flows through
 * two or more free-function transforms.
 *
 * A step is one of two shapes:
 *   x |> f            a bare callable takes the value as its only argument
 *   x |> |v| f(a, v)  a closure whose parameter is the value's slot
 *
 * No argument order is assumed, so a data-first callee reads like a
 * data-last one: `text |> |v| strings::split(v, ",")` alongside
 * `xs |> |v| iter::map(v, f)`.
 *
 * Anything with a receiver already chains, and the method chain is the
 * shorter spelling - prefer `s.trim().to_lowercase()` over any pipe
 * form of it. The two mix: a method chain is an ordinary operand, so it
 * can feed a pipe step.
 *
 * `|>` is left-associative with very low precedence, so `a |> f |> g`
 * reads as `g(f(a))` without parentheses.
 */

use std::iter
use std::option

fn double(x: i64) -> i64 { x * 2 }

fn add(a: i64, b: i64) -> i64 { a + b }

fn clamp(lo: i64, hi: i64, x: i64) -> i64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn split_words(s: String) -> Vec<String> {
    s.trim().to_lowercase().split(" ")
}

// Arithmetic chain: 3 -> double -> add 10 -> clamp to [0, 100].
let n = 3 |> double |> |v| add(10, v) |> |v| clamp(0, 100, v)
println(f"arithmetic: {n}")

// Equivalent nested form - what the pipe saves the reader.
let same = clamp(0, 100, add(10, double(3)))
println(f"nested: {same}")

// Methods chain on their own; the pipe is not involved.
let shout = "  hello  ".trim().to_uppercase()
println(f"shout: {shout}")

// A method chain is an ordinary operand, so it can feed a pipe step.
let loud = "  hello  ".trim().to_uppercase() |> split_words
println(f"from a chain: {loud |> iter::count}")

// Word count, top-down: split on whitespace, drop empties, count.
let words = "  Hello  World  "
    |> split_words
    |> |v| iter::filter(v, |w: String| w.len() > 0)
    |> iter::count
println(f"words: {words}")

// Sum of squares of evens in 1..=10 - one expression, no `let mut`.
let total = iter::range_inclusive(1, 10)
    |> |v| iter::filter(v, |n: i64| n % 2 == 0)
    |> |v| iter::sum_by(v, |n: i64| n * n)
println(f"sum of even squares: {total}")

// Pipeline through Option: first match, fall back to a default.
let xs = #[1, 3, 5, 9, 14, 21]
let first_big = xs
    |> |v| iter::find(v, |n: i64| n > 10)
    |> |v| option::unwrap_or(v, -1)
println(f"first > 10 (or -1): {first_big}")

// Filter twice - `iter::count` reports each subset's size.
let evens = xs |> |v| iter::filter(v, |n: i64| n % 2 == 0)
let odds = xs |> |v| iter::filter(v, |n: i64| n % 2 != 0)
println(f"evens: {evens |> iter::count}, odds: {odds |> iter::count}")
