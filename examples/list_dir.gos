/*
 * Directory listing - reads entries and prints an aligned table.
 *
 * Column alignment uses format-spec width + fill (`{:<4}` left,
 * `{:>14}` right) rather than hand-rolled padding helpers.
 *
 * Run:
 *     gos run examples/list_dir.gos examples
 */

use std::env
use std::errors
use std::fs

// Renders a non-negative integer with thousands separators.
fn comma_size(n: i64) -> String {
    if n == 0 {
        return "0"
    }
    let mut out = ""
    let mut value = n
    let mut digits_since_comma = 0
    while value > 0 {
        if digits_since_comma == 3 {
            out = "," + out
            digits_since_comma = 0
        }
        out = f"{value % 10}" + out
        value /= 10
        digits_since_comma += 1
    }
    out
}

fn kind_tag(is_dir: bool, is_file: bool, is_symlink: bool) -> String {
    if is_dir {
        return "d"
    }
    if is_file {
        return "f"
    }
    if is_symlink {
        return "l"
    }
    "?"
}

let args = env::args()
let target = if args.is_empty() { "." } else { args[0].clone() }

let entries = fs::read_dir(target)
    .map_err(|e| errors::newf("read_dir {}: {}", target, e))?

println(f"listing of {target}")
println(f"{"kind":<4} {"size":>14} name")

let mut files = 0
let mut dirs = 0
let mut total_bytes = 0
for entry in &entries {
    let kind = kind_tag(entry.is_dir, entry.is_file, entry.is_symlink)
    let size = if entry.is_file { entry.size } else { 0 }
    println(f"{kind:<4} {comma_size(size):>14} {entry.name}")
    if entry.is_dir {
        dirs += 1
    } else if entry.is_file {
        files += 1
        total_bytes += size
    }
}

println("---")
println("{} file(s), {} dir(s), {} bytes total in regular files"
    files, dirs, comma_size(total_bytes))
