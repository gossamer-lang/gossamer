/*
 * TOML with `std::encoding::toml`.
 *
 * Typed: `toml::decode::<T>` and `toml::encode` work as their `json::`
 * counterparts do. Untyped: `toml::parse` answers a `json::Value` and
 * `toml::encode` writes one back. `to_json_text` / `from_json_text`
 * convert text. TOML has no null, so an absent `Option` is left out.
 *
 * Run:
 *     gos run examples/toml_demo.gos
 */

use std::encoding::{json, toml}
use std::errors

struct Database {
    url: String
    pool: i64
}

struct Config {
    name: String
    port: i64
    verbose: bool
    owner: Option<String>
    database: Database
}

let text = """
name = "billing"
port = 8080
verbose = true

[database]
url = "postgres://db/billing"
pool = 16
"""

let config = toml::decode::<Config>(text)?
println(f"{config.name} on {config.port}, pool {config.database.pool}, owner {config.owner:?}")

print(toml::encode(config)?)
println("---")
print(toml::encode(config, sort: true)?)
println("---")

let doc = toml::parse(text)?
println(f"database.url: {json::pointer(doc, "/database/url"):?}")
println(toml::to_json_text("b = 1\na = [true, false]\n")?)
print(toml::from_json_text("{\"z\": 1, \"a\": {\"x\": \"y\"}}")?)
println(f"valid: {toml::is_valid(text)} {toml::is_valid("port == 8080")}")
