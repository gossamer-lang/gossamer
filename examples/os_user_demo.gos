/*
 * POSIX user / group lookup with `std::os::user`.
 *
 * Returns the current process user's name, uid, gid, home directory,
 * and lets you look up a uid from a login name (or the reverse).
 * On Windows the uid / gid functions return -1; name / home come
 * from the USERNAME / USERPROFILE environment variables.
 */

use std::os::user

let name = user::current_name()
println(f"name nonempty: {name.len() > 0}")

let uid = user::current_uid()
println(f"uid is i64: {uid >= -1}")

let gid = user::current_gid()
println(f"gid is i64: {gid >= -1}")

let home = user::current_home()
println(f"home nonempty: {home.len() > 0}")

// Round-trip: look up our own uid from our own name on unix,
// verify it matches. On Windows lookup_name returns -1.
let looked = user::lookup_name(name)
println(f"round-trip ok: {looked == uid || looked == -1}")
