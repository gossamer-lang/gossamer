// A service-readiness consumer with deterministic loopback transport
// diagnostics. Replace the `httptest::server` call with a deployed service URL
// in an application; the response-status handling remains the same.

use std::{http, httptest}

fn readiness_message(url: String) -> String {
    match http::get(url + "/ready", #[]) {
        Ok(response) => {
            if response.status >= 200 && response.status < 300 {
                f"ready status={response.status} body={response.body}"
            } else {
                f"unhealthy status={response.status} body={response.body}"
            }
        }
        Err(error) => f"transport diagnostic: {error}"
    }
}

let fixture = httptest::server(200, "database=up")
println(readiness_message(fixture))
