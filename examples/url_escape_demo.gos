/*
 * URL percent-encoding with `std::net::url`.
 *
 * Query-mode encodes space as `+`; path-mode encodes space as %20
 * and preserves `/ : @`. Decoding reverses each variant.
 */

use std::net::url

let q = url::query_escape("hello world & friends")
println(f"q escape: {q}")

let q2 = url::query_unescape(q)
println(f"q unescape: {q2}")

let p = url::path_escape("/users/alice@example.com/files")
println(f"p escape: {p}")

let p2 = url::path_unescape(p)
println(f"p unescape: {p2}")
