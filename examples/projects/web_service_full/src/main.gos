/*
 * web_service_full - a complete, runnable HTTP service.
 *
 * Demonstrates the production-stack shape that works identically on
 * every tier (bytecode VM via `gos`, Cranelift JIT, and LLVM AOT
 * via `gos build`):
 *
 *   - HTTP routing with path parameters via std::http::router
 *   - A notes "store" exposed through a CRUD-shaped JSON API
 *   - Structured JSON logging through std::slog
 *   - Signal-driven graceful shutdown via std::os::signal
 *   - Server-side HTML rendering (escaped) for the browser view
 *
 * The store is an in-memory seeded dataset: the language ships no
 * in-the-box SQL driver (a driver is wired per-project through
 * [rust-bindings]), so the example stays self-contained and runs
 * everywhere. Create/delete echo the operation's result the way a
 * REST front end does; reads are served from the seed.
 *
 * Endpoints:
 *   GET    /health        -> 200 "ok"
 *   GET    /notes         -> 200 JSON list
 *   POST   /notes         -> 201 created note JSON (body: {"body":"..."})
 *   GET    /notes/{id}    -> 200 note JSON / 404
 *   DELETE /notes/{id}    -> 204 / 400
 *   GET    /notes.html    -> 200 HTML listing
 */

use std::http
use std::http::router
use std::os::signal
use std::process
use std::slog

// POSIX interrupt signal number. On Windows the console-control
// bridge in std::os::signal maps Ctrl-C / close / shutdown onto the
// same notifier, so this value is the portable "please stop" signal.
const SIGINT: i64 = 2

struct Note { id: i64, body: String }

// Seed dataset standing in for a persistent store. Returned by value
// on each read so handlers never share mutable state across the
// request goroutines the server fans out to.
fn seed_notes() -> Vec<Note> {
    Vec::from([
        Note { id: 1, body: "first note" }
        Note { id: 2, body: "second note" }
        Note { id: 3, body: "third note" }
    ])
}

fn render_note_json(note: Note) -> String {
    f"{{\"id\":{note.id},\"body\":\"{escape_json(note.body)}\"}}"
}

fn render_notes_json(notes: [Note]) -> String {
    let mut out = String::new()
    out.push('[')
    let mut first = true
    for note in notes {
        if !first { out.push(',') }
        first = false
        out.push_str("{\"id\":")
        out.push_str(f"{note.id}")
        out.push_str(",\"body\":\"")
        out.push_str(escape_json(note.body))
        out.push_str("\"}")
    }
    out.push(']')
    out
}

fn render_notes_html(notes: [Note]) -> String {
    let mut out = String::new()
    out.push_str("<!doctype html><html><head><title>notes</title></head><body><ul>")
    for note in notes {
        out.push_str("<li>#")
        out.push_str(f"{note.id}")
        out.push_str(": ")
        out.push_str(escape_html(note.body))
        out.push_str("</li>")
    }
    out.push_str("</ul></body></html>")
    out
}

// Renders the single note whose id matches, or None. Returns the
// JSON string rather than the `Note` so nothing escapes the seed
// vector's ownership - the value model frees the vector at function
// exit on every tier.
fn find_note_json(id: i64) -> Option<String> {
    for note in seed_notes() {
        if note.id == id {
            return Some(format(
                "{{\"id\":{},\"body\":\"{}\"}}"
                note.id
                escape_json(note.body)
            ))
        }
    }
    None
}

fn escape_json(text: String) -> String {
    let mut out = String::new()
    for ch in text.chars() {
        match ch {
            '"' => out.push_str("\\\"")
            '\\' => out.push_str("\\\\")
            '\n' => out.push_str("\\n")
            _ => out.push(ch)
        }
    }
    out
}

fn escape_html(text: String) -> String {
    let mut out = String::new()
    for ch in text.chars() {
        match ch {
            '<' => out.push_str("&lt;")
            '>' => out.push_str("&gt;")
            '&' => out.push_str("&amp;")
            '"' => out.push_str("&quot;")
            _ => out.push(ch)
        }
    }
    out
}

// Plain-text body parser: the body is expected to be JSON of the
// form `{"body":"<text>"}`. The full json decoder is plumbed through
// std::encoding::json, but this service stays small and uses a string
// scan for the one field it cares about.
fn extract_body(body: String) -> String {
    let needle = "\"body\":\""
    let start = match body.find(needle) {
        Some(s) => s
        None => return String::new()
    }
    let after = start + needle.len()
    let bytes = body.as_bytes()
    let mut out = String::new()
    for i in after..bytes.len() {
        let b = bytes[i]
        if b == 34 {
            return out
        }
        out.push(b as char)
    }
    out
}

// --- Handlers - each is a one-job function with the standard
//     `fn(http::Request) -> Result<http::Response, http::Error>`
//     signature the router dispatches to. ---

fn health(_r: http::Request) -> Result<http::Response, http::Error> {
    Ok(http::Response::text(200, "ok"))
}

fn list_notes(_r: http::Request) -> Result<http::Response, http::Error> {
    slog::info("GET /notes")
    let notes = seed_notes()
    Ok(http::Response::json(200, render_notes_json(notes)))
}

fn create_note(r: http::Request) -> Result<http::Response, http::Error> {
    let body = extract_body(r.body)
    let created = Note { id: seed_notes().len() + 1, body: body }
    slog::info("POST /notes")
    Ok(http::Response::json(201, render_note_json(created)))
}

fn show_note(r: http::Request) -> Result<http::Response, http::Error> {
    match r.path_int("id") {
        Some(id) => match find_note_json(id) {
            Some(json) => Ok(http::Response::json(200, json))
            None => Ok(http::Response::text(404, "not found"))
        }
        None => Ok(http::Response::text(400, "bad id"))
    }
}

fn delete_note(r: http::Request) -> Result<http::Response, http::Error> {
    match r.path_int("id") {
        Some(_) => {
            slog::warn("DELETE /notes/{id}")
            Ok(http::Response::text(204, ""))
        }
        None => Ok(http::Response::text(400, "bad id"))
    }
}

fn notes_html(_r: http::Request) -> Result<http::Response, http::Error> {
    let notes = seed_notes()
    let resp = http::Response::text(200, render_notes_html(notes))
    Ok(resp.with_header("Content-Type", "text/html; charset=utf-8"))
}

// Graceful-shutdown coordinator. Subscribes to the interrupt signal,
// blocks until it fires, logs, and exits cleanly. The blocking
// `http::serve` accept loop runs on the main goroutine; this watcher
// is the one place that observes the signal and turns it into a clean
// process exit instead of an abrupt OS kill.
fn shutdown_watcher() {
    let notifier = signal::on(SIGINT)
    signal::wait(notifier)
    slog::warn("shutdown signal received; stopping web_service_full")
    process::exit(0)
}

fn main() -> Result<(), http::Error> {
    slog::info("web_service_full starting on 0.0.0.0:8080")
    println("web_service_full: listening on 0.0.0.0:8080")
    println("  routes: GET /health, GET /notes, POST /notes,")
    println("          GET /notes/{{id}}, DELETE /notes/{{id}}, GET /notes.html")

    spawn(|| shutdown_watcher())

    router::Router::new().get("/health", health).get("/notes", list_notes).post("/notes", create_note).get("/notes.html", notes_html).get("/notes/{id}", show_note).delete("/notes/{id}", delete_note)
        |> |v| http::serve("0.0.0.0:8080", v)
}

#[cfg(test)]
mod web_service_tests {
    use std::testing

    #[test]
    fn seed_has_three_notes() {
        let _ = testing::check_eq((super::seed_notes().len() as i64), 3, "seed size")
    }

    #[test]
    fn find_note_hits_and_misses() {
        match super::find_note_json(2) {
            Some(j) => { let _ = testing::check(j.contains("second note"), "found id 2") }
            None => { let _ = testing::check(false, "id 2 should exist") }
        }
        match super::find_note_json(99) {
            Some(_) => { let _ = testing::check(false, "id 99 should not exist") }
            None => { let _ = testing::check(true, "id 99 absent") }
        }
    }

    #[test]
    fn notes_json_renders_array() {
        let notes = super::seed_notes()
        let out = super::render_notes_json(notes)
        let _ = testing::check(out.starts_with("[{"), "json array opener")
        let _ = testing::check(out.contains("\"first note\""), "first body present")
        let _ = testing::check(out.ends_with("]"), "json array closer")
    }

    #[test]
    fn note_json_escapes_quotes() {
        let note = super::Note { id: 7, body: "a\"b" }
        let out = super::render_note_json(note)
        let _ = testing::check_eq(out, "{\"id\":7,\"body\":\"a\\\"b\"}", "escaped note json")
    }

    #[test]
    fn html_escapes_markup() {
        let note = super::Note { id: 1, body: "<script>" }
        let notes = #[note]
        let out = super::render_notes_html(notes)
        let _ = testing::check(out.contains("&lt;script&gt;"), "markup escaped")
        let _ = testing::check(!out.contains("<script>"), "no raw script tag")
    }

    #[test]
    fn extract_body_pulls_field() {
        let body = "{\"body\":\"hello\"}"
        let _ = testing::check_eq(super::extract_body(body), "hello", "extracted body")
    }
}
