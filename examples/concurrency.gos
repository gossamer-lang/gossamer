/*
 * Goroutines + channels - the canonical producer / consumer shape.
 *
 * `spawn(f)` starts a goroutine. `channel()` returns a
 * (Sender, Receiver) pair, destructurable inline. The producer
 * sends each value with `tx.send(v)` and `close()`s the channel
 * when the stream ends; the consumer drains it with the canonical
 * `while let Some(v) = rx.recv()` - no sleeps, no manual counting.
 */

use std::sync::channel

fn produce(tx: Sender<i64>) {
    tx.send(10)
    tx.send(20)
    tx.send(30)
    tx.close()
}

let tx, rx = channel()
spawn(|| produce(tx))

let mut total = 0
while let Some(v) = rx.recv() {
    total += v
}
println(f"drained three values, total = {total}")
