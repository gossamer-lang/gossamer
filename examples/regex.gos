/*
 * `std::regex` - compiled regular expressions.
 *
 * Wraps the Rust `regex` crate. Pattern syntax is the same subset
 * (PCRE-like; no backreferences or look-around). The public API is
 * small by design:
 *
 *     compile(pattern) -> Result<Pattern, String>
 *     is_match(re, text) -> bool
 *     find(re, text) -> Option<(i64, i64, String)>
 *     find_all(re, text) -> Vec<(i64, i64, String)>
 *     captures(re, text) -> Option<[Option<String>]>
 *     captures_all(re, text) -> [[Option<String>]]
 *     replace(re, text, replacement) -> String
 *     replace_all(re, text, replacement) -> String
 *     split(re, text) -> Vec<String>
 *
 * Compile once, use many times: the compiled `Pattern` is cheap to
 * pass around and carries its source string for diagnostics.
 */

use std::regex

// Pulls every `key=value` pair out of a config line.
fn parse_pairs(line: String) -> Vec<Vec<Option<String>>> {
    let re = regex::compile("(\\w+)=(\\w+)")
    regex::captures_all(re, line)
}

// Digit extraction.
let digits = regex::compile("\\d+")
for hit in regex::find_all(digits, "1 and 22 and 333") {
    println(f"digit: {hit.2}")
}

// Group rewrite: "port=80 host=443" -> "80:port 443:host".
let kv = regex::compile("(\\w+)=(\\d+)")
let rewritten = regex::replace_all(kv, "port=80 host=443", "$2:$1")
println(f"rewritten: {rewritten}")

// Structured parse: each row is [full, key, value]. A let-chain
// binds both capture groups and tests them in one condition.
for row in parse_pairs("addr=localhost port=8080") {
    if let Some(k) = row[1] && let Some(v) = row[2] {
        println(f"  {k} = {v}")
    }
}

// Split on any run of commas-with-whitespace.
let comma = regex::compile("\\s*,\\s*")
for piece in regex::split(comma, "a,  b , c,d") {
    println(f"piece: {piece}")
}
