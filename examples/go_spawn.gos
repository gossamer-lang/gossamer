/*
 * Goroutine spawn without channels.
 *
 * `spawn(f)` hands a closure to the scheduler; in `main` it needs no
 * enclosing `cohort { }`. The goroutine + channel shape lives in
 * `concurrency.gos`.
 */

fn worker(id: i64, reps: i64) {
    for i in 0..reps {
        println(f"worker {id} tick {i}")
    }
}

fn main() {
    // Spawn three workers. Scheduler runs them cooperatively;
    // output order is not guaranteed.
    spawn(|| worker(1, 2))
    spawn(|| worker(2, 2))
    spawn(|| worker(3, 2))

    println("main is done dispatching")
}
