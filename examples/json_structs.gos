/*
 * Typed JSON: structs, enums, and collections to and from text.
 *
 *     json::decode::<T>(text) -> Result<T, errors::Error>
 *     json::encode(value)     -> Result<String, errors::Error>
 *
 * Any type with a JSON form works as a target: structs and enums
 * (generic ones too), `Vec<T>`, `Map<String, V>`, `Option`, tuples,
 * fixed arrays, and scalars. Encoding keeps a struct's members in
 * declaration order; `sort: true` orders them by key. Decoding is
 * strict, and an error names the path to the member that failed.
 *
 * Run:
 *     gos run examples/json_structs.gos
 */

use std::encoding::json
use std::errors

struct Address {
    city: String
    zip: String
}

#[rename_all("camelCase")]
struct User {
    user_name: String
    age: i64
    active: bool
    tags: Vec<String>
    address: Address
    #[default]
    nickname: Option<String>
    #[default(3)]
    retries: i64
}

#[tag("kind")]
enum Event {
    Login { user: String }
    Logout { user: String }
}

let original = User {
    user_name: "alice"
    age: 30
    active: true
    tags: #["admin", "ops"]
    address: Address { city: "denver", zip: "80205" }
    nickname: None
    retries: 3
}

let text = json::encode(original)?
println(f"declared: {text}")
println(f"sorted:   {json::encode(original, sort: true)?}")
println(f"pretty:\n{json::encode_pretty(original.address)?}")

// Members `#[default]` marks may be absent; the rest must be present.
let back = json::decode::<User>(
    "{\"userName\":\"bob\",\"age\":41,\"active\":false,\"tags\":[],\"address\":{\"city\":\"x\",\"zip\":\"0\"}}"
)?
println(f"{back.user_name} {back.age} {back.nickname:?} {back.retries}")

// Errors name the member that failed.
match json::decode::<User>("{\"userName\":\"bob\",\"age\":\"oops\"}") {
    Ok(_) => println("unexpected: bad payload decoded")
    Err(e) => println(f"rejected: {e}")
}
match json::decode::<User>("{\"userName\":\"carol\",\"age\":40,\"active\":true,\"tags\":[]}") {
    Ok(_) => println("unexpected: missing member decoded")
    Err(e) => println(f"rejected: {e}")
}

// Enums carry their variant by tag; collections decode directly.
let events = json::decode::<Vec<Event>>(
    "[{\"kind\":\"Login\",\"user\":\"a\"},{\"kind\":\"Logout\",\"user\":\"a\"}]"
)?
println(f"{events.len()} events, first {events[0]}")
println(json::encode(events)?)
let scores: Map<String, i64> = json::decode("{\"b\":2,\"a\":1}")?
println(f"{scores}")
