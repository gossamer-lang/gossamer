/*
 * JSON serialize and deserialize with structs - one line per direction.
 *
 * Every named struct in the program auto-derives a pair of generic
 * serializer functions, called with a turbofish type argument:
 *
 *     to_json::<Type>(value) -> Result<String, errors::Error>
 *     from_json::<Type>(text: &String) -> Result<Type, errors::Error>
 *
 * `from_json` is strict: every declared field must be present and
 * each one must match its declared type. A JSON document whose
 * `"age"` field is a string fails with a structured error.
 *
 * Nested structs, growable arrays (`[String]`), tuples, fixed-size
 * arrays, `Option<T>`, and `Map<String, V>` are walked
 * recursively.
 *
 * Run:
 *     gos run examples/json_structs.gos
 */

use std::errors

struct Address {
    city: String
    zip: String
}

struct User {
    name: String
    age: i64
    active: bool
    tags: Vec<String>
    address: Address
}

let tags: Vec<String> = #["admin", "ops"]
let original = User { name: "alice", age: 30, active: true, tags: tags, address: Address { city: "denver", zip: "80205" } }

// Serialize: one call, one line.
let text = to_json::<User>(original)?
println(f"serialized: {text}")

// Deserialize: one call, one line.
let back: User = from_json::<User>(text)?
println(f"name    = {back.name}")
println(f"age     = {back.age}")
println(f"active  = {back.active}")
println(f"city    = {back.address.city}")
println(f"zip     = {back.address.zip}")
println(f"tags[0] = {back.tags[0]}")
println(f"tags[1] = {back.tags[1]}")

// Strict validation rejects type mismatches with a path-qualified
// error: `from_json: field 'age': expected integer, got string`.
let bad = "{\"name\":\"bob\",\"age\":\"oops\",\"active\":false,\"tags\":[],\"address\":{\"city\":\"x\",\"zip\":\"0\"}}"
match from_json::<User>(bad) {
    Ok(_) => println("unexpected: bad payload parsed clean")
    Err(e) => println(f"rejected:   {e}")
}

// Strict validation also rejects missing required fields.
let missing = "{\"name\":\"carol\",\"age\":40,\"active\":true,\"tags\":[]}"
match from_json::<User>(missing) {
    Ok(_) => println("unexpected: missing payload parsed clean")
    Err(e) => println(f"rejected:   {e}")
}
