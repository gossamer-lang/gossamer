/*
 * Cryptographic hashing with std::crypto.
 *
 * Demonstrates SHA-256, SHA-512, and BLAKE3 digests and HMAC-SHA-256
 * message authentication. All functions are one-shot: pass bytes, get
 * a hex string back. Use these for checksums, fingerprints, and
 * message integrity - not for password storage (use crypto::kdf for
 * that).
 */

use std::crypto
use std::encoding

let msg = "The quick brown fox jumps over the lazy dog"

let h256 = crypto::sha256::hex(msg.as_bytes())
println(f"SHA-256: {h256}")

let h512 = crypto::sha512::hex(msg.as_bytes())
println(f"SHA-512: {h512}")

let hb3 = crypto::blake3::hex(msg.as_bytes())
println(f"BLAKE3:  {hb3}")

let key = "secret-key"
let mac = crypto::hmac::sha256_mac(key.clone().as_bytes(), msg.clone().as_bytes())
let mac_hex = encoding::hex::encode(mac)
println(f"HMAC:    {mac_hex}")

// Verify a digest is stable across two calls.
let a = crypto::sha256::hex("gossamer".as_bytes())
let b = crypto::sha256::hex("gossamer".as_bytes())
if a == b {
    println("deterministic: ok")
}

// A one-byte change produces a completely different digest.
let c = crypto::sha256::hex("gossamer!".as_bytes())
if a != c {
    println("avalanche: ok")
}
