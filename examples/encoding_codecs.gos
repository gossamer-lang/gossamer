/*
 * Encoding and decoding with std::encoding.
 *
 * Covers the most common byte-to-text codecs: base64, hex, and base32.
 * Also demonstrates JSON encode/decode via the encoding::json submodule.
 * All codecs are one-shot and allocation-conscious: pass a slice or
 * string, get an encoded string back; pass the encoded string, get the
 * original bytes back.
 */

use std::encoding

let data = "Hello, Gossamer!"

// Base64
let b64 = encoding::base64::encode(data.clone().as_bytes())
println(f"base64 encode: {b64}")
let b64_dec = encoding::base64::decode(b64)
match b64_dec {
    Ok(bytes) => println(f"base64 decode: {bytes.len()} bytes ok")
    Err(e) => println(f"base64 err: {e}")
}

// Hex
let h = encoding::hex::encode(data.clone().as_bytes())
println(f"hex encode:    {h}")
let h_dec = encoding::hex::decode(h)
match h_dec {
    Ok(bytes) => println(f"hex decode:    {bytes.len()} bytes ok")
    Err(e) => println(f"hex err: {e}")
}

// Base32
let b32 = encoding::base32::encode(data.clone().as_bytes())
println(f"base32 encode: {b32}")
let b32_dec = encoding::base32::decode_string(b32)
match b32_dec {
    Ok(s) => println(f"base32 decode: {s}")
    Err(e) => println(f"base32 err: {e}")
}

// JSON
let json_str = encoding::json::encode(42)
println(f"json int:  {json_str}")
let arr = encoding::json::encode(#[1, 2, 3])
println(f"json arr:  {arr}")
