/*
 * #[derive(...)] - the derivable traits.
 *
 * The derivable set is `Debug`, `Default`, `PartialEq`, `Eq`,
 * `PartialOrd`, and `Ord`. Annotating a struct with
 * `#[derive(PartialEq, Eq, Default, Debug)]` synthesizes the matching
 * methods: `==` / `!=` compare field-by-field, `Type::default()` builds
 * a zero-valued instance, and `{:?}` prints `Name { field: value }`.
 * Nested-struct fields derive recursively, and the methods are
 * generated as ordinary Gossamer code so they run identically on every
 * tier.
 *
 * Copying (`let b = a`, `a.clone()`) is automatic for every value type
 * - there is no `Clone` derive. Structural `==` and ordering are also
 * available with no derive at all; deriving forces synthesis for the
 * generic / container-field cases the automatic gate is conservative
 * about.
 */

#[derive(PartialEq, Eq, Default, Debug)]
struct Color { r: i64, g: i64, b: i64 }

#[derive(PartialEq, Default, Debug)]
struct Pixel { at: i64, color: Color }

fn rgb(r: i64, g: i64, b: i64) -> Color { Color { r: r, g: g, b: b } }
fn default_color() -> Color { Color::default() }

let black = Color::default()
println(f"black = {black:?}")

let red = Color { r: 255, g: 0, b: 0 }
let also_red = red.clone()
println(f"red == also_red: {red == also_red}")
println(f"red != black:    {red != black}")

// Nested struct: Debug and equality recurse into `color`.
let p = Pixel { at: 3, color: red }
println(f"pixel = {p:?}")
println(f"same pixel: {p == Pixel { at: 3, color: rgb(255, 0, 0) }}")

#[cfg(test)]
mod tests {
    use std::testing

    #[test]
    fn default_is_black() {
        let c = super::default_color()
        let _ = testing::check(c.r == 0 && c.g == 0 && c.b == 0, "default Color is all-zero")
    }

    #[test]
    fn equality_is_structural() {
        let _ = testing::check(super::rgb(1, 2, 3) == super::rgb(1, 2, 3), "same fields compare equal")
        let _ = testing::check(super::rgb(1, 2, 3) != super::rgb(9, 2, 3), "a differing field compares unequal")
    }

    #[test]
    fn clone_equals_source() {
        let a = super::rgb(10, 20, 30)
        let _ = testing::check(a.clone() == a, "a clone equals its source")
    }
}
