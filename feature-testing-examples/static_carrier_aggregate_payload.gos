struct Drag { id: u64, types: Vec<u64>, name: String }
static mut ACTIVE: Option<Drag> = None
static mut LAST: Option<i64> = None

fn start(n: i64) {
    ACTIVE = Some(Drag { id: n as u64, types: #[7, 8, 9], name: f"drag {n}" })
}

fn move_to(n: i64) {
    let Some(mut drag) = ACTIVE else {
        return
    }
    drag.types.push(n as u64)
    ACTIVE = Some(drag)
}

fn show() {
    match ACTIVE {
        Some(d) => println(f"{d.id} {d.types.len()} {d.name}")
        None => println("none")
    }
}

fn main() {
    for n in 0..3 {
        LAST = Some(n)
        start(n)
        move_to(n)
        show()
    }
    println(f"last {LAST}")
    ACTIVE = None
    show()
    start(9)
    show()
}
