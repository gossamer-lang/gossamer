struct Drag { id: u64, types: Vec<u64>, name: String }
static mut ACTIVE: Option<Drag> = None
static mut LAST: Option<i64> = None

fn start(n: i64) {
    unsafe { ACTIVE = Some(Drag { id: n as u64, types: #[7, 8, 9], name: f"drag {n}" }) }
}

fn move_to(n: i64) {
    let Some(mut drag) = unsafe { ACTIVE } else {
        return
    }
    drag.types.push(n as u64)
    unsafe { ACTIVE = Some(drag) }
}

fn show() {
    match unsafe { ACTIVE } {
        Some(d) => println(f"{d.id} {d.types.len()} {d.name}")
        None => println("none")
    }
}

fn main() {
    for n in 0..3 {
        unsafe { LAST = Some(n) }
        start(n)
        move_to(n)
        show()
    }
    unsafe { println(f"last {LAST:?}") }
    unsafe { ACTIVE = None }
    show()
    start(9)
    show()
}
