// A type's identity is the module that declares it, so two modules may each
// declare `Point` and `Tag`. Construction, field access, `{:?}`, `==`, map
// keying, and serde all reach the right one on every tier, and a rendered
// value shows the name as declared. A field naming `Point` inside a module
// names that module's own `Point`, whether that is a struct or an enum.

use std::encoding::json
use a::Point
use b::Point as Label

mod a {
    pub struct Point { pub x: i64, pub y: i64 }
    pub struct Pair(pub i64, pub i64)
    pub enum Tag { One, Two(i64) }
    pub fn make() -> Point { Point { x: 1, y: 2 } }
}

mod b {
    pub struct Point { pub name: String }
    pub struct Line { pub points: Vec<Point>, pub end: Option<Point> }
    pub enum Tag { Red, Blue }
    pub fn make() -> Point { Point { name: "b" } }
}

mod c {
    pub enum Point { Origin, At(i64) }
    pub struct Path { pub stops: Vec<Point> }
}

fn main() {
    let p = a::make()
    let q = b::make()
    println("{} {} {}", p.x, p.y, q.name)
    println("{:?} {:?}", p, q)
    println("eq {} {}", p == Point { x: 1, y: 2 }, q == Label { name: "b" })

    let pair = a::Pair(3, 4)
    println("pair {} {}", pair.0, pair.1)

    println("{:?} {:?}", a::Tag::Two(7), b::Tag::Red)
    println("{:?} {:?}", a::Tag::One, b::Tag::Blue)
    println("tag eq {} {}", a::Tag::Two(7) == a::Tag::Two(7), b::Tag::Red == b::Tag::Blue)

    let mut seen: Map<a::Point, i64> = Map::new()
    seen.insert(a::Point { x: 1, y: 2 }, 9)
    println("keyed {}", seen.get(a::Point { x: 1, y: 2 }).unwrap_or(-1))

    let encoded = to_json::<a::Point>(p).unwrap_or("ERR")
    let other = to_json::<b::Point>(q).unwrap_or("ERR")
    println("{} {}", encoded, other)
    let back = from_json::<a::Point>(encoded).unwrap_or(a::Point { x: 0, y: 0 })
    println("roundtrip {} {}", back.x, back.y)

    let line = b::Line { points: #[b::make()], end: Some(Label { name: "end" }) }
    let line_json = to_json::<b::Line>(line).unwrap_or("ERR")
    println("{}", line_json)
    let line_back = from_json::<b::Line>(line_json).unwrap_or(b::Line { points: #[], end: None })
    println("line {} {:?}", line_back.points[0].name, line_back.end)

    let path = c::Path { stops: #[c::Point::Origin, c::Point::At(5)] }
    println("path {:?}", path.stops)
}
