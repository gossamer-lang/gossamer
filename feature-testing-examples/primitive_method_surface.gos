// The `char` and integer method surface: Unicode and ASCII classification,
// digit conversion, checked / saturating / overflowing arithmetic, Euclidean
// division, and integer powers, identical on every tier.

fn char_surface() {
    let cs = #['a', 'Z', '7', ' ', 'é', '中', '!', '\n', 'ß']
    for c in cs {
        println(
            "{:?} alpha={} num={} alnum={} ws={} up={} low={} ascii={} ctl={}"
            c
            c.is_alphabetic()
            c.is_numeric()
            c.is_alphanumeric()
            c.is_whitespace()
            c.is_uppercase()
            c.is_lowercase()
            c.is_ascii()
            c.is_control()
        )
    }
    println("{} {} {} {}", 'ß'.to_uppercase(), 'Ä'.to_lowercase(), 'q'.to_ascii_uppercase(), 'Q'.to_ascii_lowercase())
    println("{:?} {:?} {:?} {}", 'f'.to_digit(16), '9'.to_digit(8), 'z'.to_digit(36), '7'.is_digit(10))
    println("{:?} {:?} {:?}", char::from_digit(11, 16), char::from_digit(3, 2), char::from_u32(0x1F600))
    println("{:?} {:?}", char::from_u32(0xD800), char::from_u32(-1))
    println("{} {} {} {}", 'a'.len_utf8(), 'é'.len_utf8(), '中'.len_utf8(), '\u{1F600}'.len_utf8())
    println("{} {}", 'a'.len_utf16(), '\u{1F600}'.len_utf16())
    println("{} {} {}", 'x'.is_ascii_hexdigit(), 'F'.is_ascii_hexdigit(), '.'.is_ascii_punctuation())
    println("{} {}", 'a'.eq_ignore_ascii_case('A'), 'a'.eq_ignore_ascii_case('b'))
    let digits: Vec<i64> = "a1b22c3".chars().filter(|c| c.is_ascii_digit()).map(|c| c.to_digit(10).unwrap_or(0)).collect()
    println("{:?}", digits)
}

fn byte_surface() {
    let bytes = "Hi 9!".as_bytes()
    for b in bytes {
        println("{} digit={} alpha={} ws={} up={}", b, b.is_ascii_digit(), b.is_ascii_alphabetic(), b.is_ascii_whitespace(), b.to_ascii_uppercase())
    }
}

fn integer_surface() {
    let big = i64::MAX
    let small = i64::MIN
    println("{:?} {:?} {:?}", big.checked_add(1), 5.checked_add(3), small.checked_sub(1))
    println("{:?} {:?} {:?}", big.checked_mul(2), (-4).checked_mul(5), small.checked_mul(-1))
    println("{:?} {:?} {:?}", 7.checked_div(0), small.checked_div(-1), 7.checked_rem(3))
    println("{:?} {:?}", small.checked_neg(), small.checked_abs())
    println("{} {} {}", big.saturating_add(9), small.saturating_sub(9), big.saturating_mul(-2))
    println("{:?} {:?}", big.overflowing_add(1), 3.overflowing_mul(4))
    let b: u8 = 250
    println("{:?} {:?} {} {}", b.checked_add(10), b.checked_sub(251), b.saturating_add(10), b.saturating_sub(251))
    println("{:?} {}", b.overflowing_add(10), b.abs_diff(3))
    println("{} {} {} {}", (-7).rem_euclid(3), 7.rem_euclid(-3), (-7).div_euclid(3), 7.div_euclid(-3))
    println("{} {} {}", (-9).signum(), 0.signum(), 12.signum())
    println("{} {}", (-3).is_negative(), (-3).is_positive())
    println("{} {} {}", 3.pow(4), (-2).pow(5), 10.pow(0))
    println("{:?} {:?} {}", 10.checked_pow(18), 10.checked_pow(19), 10.saturating_pow(19))
    let n: i32 = -100
    println("{} {}", n.abs_diff(28), n.pow(2))
    let u: u32 = 40
    println("{} {} {}", u.is_power_of_two(), u.next_power_of_two(), 64.isqrt())
    let w: u16 = 0b1011_0000
    println("{} {} {} {}", w.count_ones(), w.count_zeros(), w.leading_zeros(), w.trailing_zeros())
}

fn float_surface() {
    let x = 1.5
    let y: f32 = 2.0
    println("{} {} {} {}", x.powi(3), x.powf(0.5), y.powi(10), y.powf(1.5))
}

fn main() {
    float_surface()
    char_surface()
    byte_surface()
    integer_surface()
}
