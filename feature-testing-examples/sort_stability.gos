// Every sort is stable on every tier: equal elements keep their order.
struct Item {
    key: i64
    seq: i64
}

fn stable(xs: Vec<Item>) -> bool {
    for i in 1..xs.len() {
        let a = xs[i - 1]
        let b = xs[i]
        if a.key > b.key || (a.key == b.key && a.seq > b.seq) {
            return false
        }
    }
    true
}

fn main() {
    let mut items: Vec<Item> = #[]
    let mut state = 12345
    for i in 0..5000 {
        state = (state * 1103515245 + 12345) % 2147483648
        items.push(Item { key: state % 7, seq: i })
    }
    let mut a = items.clone()
    a.sort_by(|x, y| x.key.cmp(y.key))
    println(f"sort_by stable: {stable(a)}")
    let mut b = items.clone()
    b.sort_by_key(|x| x.key)
    println(f"sort_by_key stable: {stable(b)}")
    let mut c = items.clone()
    c[100..4000].sort_by_key(|x| x.key)
    println(f"window sorted: {stable(c[100..4000].to_vec())}")
    let mut d: Vec<(i64, i64)> = #[]
    for i in 0..3000 {
        d.push((i % 5, i))
    }
    d.sort_by_key(|p| p.0)
    let mut ok = true
    for i in 1..d.len() {
        if d[i - 1].0 == d[i].0 && d[i - 1].1 > d[i].1 {
            ok = false
        }
    }
    println(f"tuples stable: {ok}")
    let mut e: Vec<String> = #[]
    for i in 0..2000 {
        e.push(f"{i % 3}-{i}")
    }
    e.sort_by_key(|s| s.len())
    let mut prev = ""
    let mut ok2 = true
    for s in e {
        if prev.len() == s.len() && prev.len() > 0 {
            let pa = prev.split("-")[1].to_i64().unwrap()
            let pb = s.split("-")[1].to_i64().unwrap()
            if pa > pb { ok2 = false }
        }
        prev = s
    }
    println(f"strings stable: {ok2}")
}
