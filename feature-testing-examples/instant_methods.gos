// Locks the `time::Instant` accessor in method form across every tier.
// An Instant is its own type over a monotonic reading in nanoseconds, so
// `inst.elapsed_ms()` must dispatch by the receiver's static type and
// reach the same monotonic-delta helper as the qualified
// `time::Instant::elapsed_ms(inst)` free call. Absolute times are
// non-deterministic, so the fixture only asserts invariants that hold on
// every tier: the elapsed delta is non-negative, and a later sample of
// the qualified form is never smaller than an earlier method-form sample
// (the monotonic clock never runs backwards).
use std::time

fn main() {
    let t = time::Instant::now()
    let method_form = t.elapsed_ms()
    let qualified_form = time::Instant::elapsed_ms(t)
    assert(method_form >= 0, "method-form elapsed_ms is non-negative")
    assert(qualified_form >= 0, "qualified-form elapsed_ms is non-negative")
    assert(
        qualified_form >= method_form
        "monotonic: qualified form sampled after method form"
    )
    println("instant ok")
}
