// Cross-tier regression for the middleware that are controls rather
// than response decorations: a body budget refuses an oversized
// request before the handler runs, a credential gate answers 401
// without running it, and a rate limit refills over time instead of
// spending a lifetime quota.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the fixture compares as a plain stdout-parity run. Binds fixed
// loopback ports - serialized under SERVER_PORT_LOCK by
// `http_middleware_controls_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::errors
use std::http
use std::http::middleware
use std::process
use std::strings
use std::time

fn echo(r: http::Request) -> Result<http::Response, errors::Error> {
    Ok(http::Response::text(200, format("body={}", r.body.byte_len())))
}

fn secret(_r: http::Request) -> Result<http::Response, errors::Error> {
    Ok(http::Response::text(200, "secret"))
}

fn serve_capped() {
    let app = middleware::body_limit(echo, 16)
    if let Err(e) = http::serve("127.0.0.1:23888", app) {
        eprintln("serve failed: {e}")
    }
}

fn serve_guarded() {
    let app = middleware::bearer_auth(secret, "api")
    if let Err(e) = http::serve("127.0.0.1:23893", app) {
        eprintln("serve failed: {e}")
    }
}

fn serve_limited() {
    let app = middleware::rate_limit(secret, middleware::RateLimit::per_ip(3, 1))
    if let Err(e) = http::serve("127.0.0.1:23894", app) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn status_of(url: String, headers: Vec<(String, String)>) -> i64 {
    match http::get(url, headers) {
        Ok(r) => r.status
        Err(_) => -1
    }
}

fn main() {
    spawn(|| serve_capped())
    spawn(|| serve_guarded())
    spawn(|| serve_limited())
    await_ready("http://127.0.0.1:23888/x")
    await_ready("http://127.0.0.1:23893/x")
    await_ready("http://127.0.0.1:23894/x")

    match http::post("http://127.0.0.1:23888/x", "tiny", "text/plain") {
        Ok(r) => println("under status={} body={}", r.status, r.body)
        Err(e) => println("under error: {}", e)
    }
    match http::post("http://127.0.0.1:23888/x", strings::repeat("x", 64), "text/plain") {
        Ok(r) => println("over status={}", r.status)
        Err(e) => println("over error: {}", e)
    }

    println("anonymous status={}", status_of("http://127.0.0.1:23893/x", Vec::from([])))
    let bearer = Vec::from([("Authorization", "Bearer token")])
    println("bearer status={}", status_of("http://127.0.0.1:23893/x", bearer))

    // Capacity 3 refilling one token a second. The readiness probe spent
    // the first, so two pass and the third is shed; a wait past one second
    // refills exactly one more. Refill during the back-to-back requests is
    // a thousandth of a token, so the sequence is the same on every tier.
    println("limit1 status={}", status_of("http://127.0.0.1:23894/x", Vec::from([])))
    println("limit2 status={}", status_of("http://127.0.0.1:23894/x", Vec::from([])))
    println("limit3 status={}", status_of("http://127.0.0.1:23894/x", Vec::from([])))
    time::sleep(1200)
    println("limit4 status={}", status_of("http://127.0.0.1:23894/x", Vec::from([])))
    process::exit(0)
}
