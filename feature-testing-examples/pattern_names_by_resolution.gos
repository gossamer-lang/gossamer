// A single name in a pattern means what it resolves to, whatever its case:
// a variant, struct, or const is matched, and any other name binds. Imported
// variants name their own enum even when another enum shares the name.
// The lowercase variant and const and the uppercase bindings are the point.

#![lint(allow(non_camel_case_types), allow(non_snake_case), allow(non_upper_case_globals))]

use m::Dir::{Up, Down}
use n::Shape::*
use n::Other::Up as OtherUp

mod m {
    pub enum Dir { Up, Down }
}

mod n {
    pub enum Other { Up, Left }
    pub enum Shape { Circle(i64), Rect { w: i64, h: i64 }, Empty }
}

enum Color { red, green }

const limit: i64 = 5

fn color_name(c: Color) -> String {
    match c {
        red => "red"
        green => "green"
    }
}

fn classify(x: i64) -> String {
    match x {
        limit => "limit"
        other => f"other {other}"
    }
}

fn area(W: i64, H: i64) -> i64 {
    let Total = W * H
    Total
}

fn dir(d: m::Dir) -> i64 {
    match d {
        Up => 1
        Down => 2
    }
}

fn shape_area(s: n::Shape) -> i64 {
    match s {
        Circle(r) => 3 * r * r
        Rect { w, h } => w * h
        Empty => 0
    }
}

fn other(o: n::Other) -> String {
    match o {
        OtherUp => "other up"
        n::Other::Left => "left"
    }
}

fn main() {
    // Each call site runs twice, so the JIT compiles `main`.
    for round in 1..3 {
        println(f"round {round}")
        println(color_name(Color::green))
        println(classify(5))
        println(classify(9))
        println(area(3, 4))
        println(dir(Up) + dir(Down))
        println(shape_area(Circle(2)) + shape_area(Rect { w: 3, h: 4 }) + shape_area(Empty))
        println(other(OtherUp))
    }
}
