// Request-side `r.form_file(name)` convenience: parses a
// `multipart/form-data` body off the request's `raw_body`, reading the
// boundary from the `Content-Type` header, and returns the matching
// file part as `{ name, filename, content_type, content: [u8] }`. The
// handler echoes the uploaded file's metadata and a byte checksum of
// its content. Must read back bit-identically on the bytecode VM
// (`gos`), Cranelift JIT, and LLVM AOT (incl. `gos build
// --release`).
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_form_file_parity_across_tiers`.

use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        match r.form_file("upload") {
            Some(part) => {
                let mut sum: i64 = 0
                for b in part.content {
                    sum += b as i64
                }
                http::Response::text(
                    200
                    format(
                        "file={} ctype={} len={} sum={}"
                        part.filename
                        part.content_type
                        part.content.len()
                        sum
                    )
                )
            }
            None => http::Response::text(404, "no file")
        }
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23922", App { }) {
        eprintln("serve failed: {e}")
    }
}

fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| serve_app())
    await_ready("http://127.0.0.1:23922/x")
    let body = "--ZZBOUND\r\n" +
        "Content-Disposition: form-data; name=\"text\"\r\n" +
        "\r\n" +
        "hello\r\n" +
        "--ZZBOUND\r\n" +
        "Content-Disposition: form-data; name=\"upload\"; filename=\"x.txt\"\r\n" +
        "Content-Type: text/plain\r\n" +
        "\r\n" +
        "ABCDE\r\n" +
        "--ZZBOUND--\r\n"
    let hdr: Vec<(String, String)> = Vec::from([("Content-Type", "multipart/form-data; boundary=ZZBOUND")])
    match http::request("POST", "http://127.0.0.1:23922/x", body, hdr) {
        Ok(r) => println("status={} body={}", r.status, r.body)
        Err(e) => println("error: {}", e)
    }
    // No multipart body: the convenience degrades to a 404.
    match http::get("http://127.0.0.1:23922/x", Vec::from([])) {
        Ok(r) => println("status={} body={}", r.status, r.body)
        Err(e) => println("error: {}", e)
    }
    process::exit(0)
}
