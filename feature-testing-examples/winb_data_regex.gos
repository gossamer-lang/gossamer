// Win B DATA: cross-tier parity for std::regex. Compile errors,
// anchors, unicode, named/optional groups, empty matches, $N
// backreferences and splits must be bit-identical on the VM and the
// LLVM AOT tier.

use std::regex

fn cap_line(caps: Vec<Option<String>>) -> String {
    let mut out = format("n={}", caps.len())
    for c in caps {
        match c {
            Some(s) => { out += " <" + s + ">" }
            None => { out += " <none>" }
        }
    }
    out
}

fn main() {
    // --- compile error path ---
    // A literal reaching `regex::compile` is validated while the program
    // is compiled, so the failing pattern is built at run time: that is
    // the shape whose error a program can still handle.
    let bad = "(unclos" + "ed"
    match regex::new(bad) {
        Ok(_) => println("compile bad: ok?!")
        Err(_) => println("compile bad: err")
    }

    let digits = regex::compile("\\d+")

    // --- is_match / find / find_all ---
    println("is_match abc123 = {}", regex::is_match(digits, "abc123"))
    println("is_match abc = {}", regex::is_match(digits, "abc"))
    println("is_match empty = {}", regex::is_match(digits, ""))
    match regex::find(digits, "x 42 y 7") {
        Some((s, e, t)) => println("find = {} [{},{})", t, s, e)
        None => println("find = none")
    }
    println("find_all count = {}", regex::find_all(digits, "1 22 333").len())
    for hit in regex::find_all(digits, "1 22 333") {
        println("  hit {} [{},{})", hit.2, hit.0, hit.1)
    }

    // --- anchors + alternation ---
    let anchored = regex::compile("^(cat|dog)$")
    println("anchor cat = {}", regex::is_match(anchored, "cat"))
    println("anchor cats = {}", regex::is_match(anchored, "cats"))

    // --- unicode classes (UTF-8 byte offsets vs char offsets) ---
    let letters = regex::compile("\\p{L}+")
    match regex::find(letters, "  café ") {
        Some((s, e, t)) => println("uni find = {} [{},{})", t, s, e)
        None => println("uni find = none")
    }

    // --- captures with optional + multiple groups ---
    let date = regex::compile("(\\d{4})-(\\d{2})(-(\\d{2}))?")
    match regex::captures(date, "2024-03-15") {
        Some(caps) => println("caps full: {}", cap_line(caps))
        None => println("caps full: none")
    }
    match regex::captures(date, "2024-03") {
        Some(caps) => println("caps partial: {}", cap_line(caps))
        None => println("caps partial: none")
    }
    let kvs = regex::captures_all(date, "2024-03-15 and 1999-12")
    println("captures_all count = {}", kvs.len())

    // --- replace / replace_all with $N ---
    let kv = regex::compile("(\\w+)=(\\d+)")
    println("replace = {}", regex::replace(kv, "a=1 b=2", "$2:$1"))
    println("replace_all = {}", regex::replace_all(kv, "a=1 b=2", "$2:$1"))

    // --- split: empty matches, leading/trailing separators ---
    let ws = regex::compile("\\s+")
    let parts = regex::split(ws, " a  b   c ")
    println("split count = {}", parts.len())
    let mut i = 0
    for p in parts {
        println("  part[{}] = <{}>", i, p)
        i += 1
    }

    // --- zero-width pattern split ---
    let empty_pat = regex::compile("")
    println("empty split count = {}", regex::split(empty_pat, "ab").len())
}
