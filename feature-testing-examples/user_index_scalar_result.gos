// A user type's `[]` whose `index` answers an integer or a float calls that
// method on every tier, for a loop element and a let binding alike, where the
// bytecode VM read the struct as a built-in sequence.
struct R { items: [i64; 3], scale: f64 }
impl Index for R {
    fn index(self, i: i64) -> i64 { self.items[i] * 10 }
}
struct F { v: [f64; 2] }
impl Index for F {
    fn index(self, i: i64) -> f64 { self.v[1 - i] }
}
fn main() {
    let rs = #[R { items: [1, 2, 3], scale: 1.0 }, R { items: [4, 5, 6], scale: 2.0 }]
    let mut s = 0
    for r in rs { s += r[1] }
    let direct = rs[0]
    let f = F { v: [1.5, 2.5] }
    let x: f64 = f[0]
    println(f"{s} {direct[2]} {x} {f[1]}")
}
