// A spawned closure reads a binding nothing can change after the spawn
// through the binding itself, and takes a snapshot of one the spawning code
// may still write.

use std::errors

struct Tag { label: String, rows: i64 }

fn grid(n: i64) -> Vec<Vec<f64>> {
    let mut rows: Vec<Vec<f64>> = #[]
    for i in 0..n {
        let mut row: Vec<f64> = #[0.0; n]
        for j in 0..n { row[j] = (i * n + j) as f64 }
        rows.push(row)
    }
    rows
}

fn band_sum(rows: Vec<Vec<f64>>, lo: i64, hi: i64) -> f64 {
    let mut s = 0.0
    for i in lo..hi {
        for x in rows[i] { s += x }
    }
    s
}

fn parallel_sum(rows: Vec<Vec<f64>>, workers: i64) -> f64 {
    let n = rows.len()
    let mut total = 0.0
    let joined = cohort {
        let mut handles = #[]
        for w in 0..workers {
            let lo = n * w / workers
            let hi = n * (w + 1) / workers
            handles.push(spawn(|| band_sum(rows, lo, hi)))
        }
        for handle in handles {
            match handle.join() {
                Ok(part) => { total += part }
                Err(e) => panic(f"worker failed: {e}")
            }
        }
    }
    if let Err(e) = joined { panic(f"workers failed: {e}") }
    total
}

fn labelled(tag: Tag, rows: Vec<Vec<f64>>) -> Result<String, errors::Error> {
    let mut out = ""
    cohort {
        let h = spawn(|| f"{tag.label}: {tag.rows} of {rows.len()} rows, first {rows[0]}")
        out = h.join()?
    }?
    Ok(out)
}

fn written_after_spawn() -> Result<String, errors::Error> {
    let mut rows = grid(2)
    let mut out = ""
    cohort {
        let h = spawn(|| f"{rows.len()} {rows[0][1]}")
        rows.push(#[9.0, 9.0])
        rows[0][1] = 7.0
        out = f"{h.join()?} then {rows.len()} {rows[0][1]}"
    }?
    Ok(out)
}

fn main() {
    let rows = grid(8)
    println(f"serial {band_sum(rows, 0, 8)}")
    for workers in [1, 3, 8] {
        println(f"{workers} workers {parallel_sum(rows, workers)}")
    }
    println(f"after {rows.len()} {rows[7][7]}")
    match labelled(Tag { label: "g", rows: 3 }, grid(3)) {
        Ok(s) => println(s)
        Err(e) => println(f"error {e}")
    }
    match written_after_spawn() {
        Ok(s) => println(s)
        Err(e) => println(f"error {e}")
    }
}
