// Popping a `static mut` vector shortens the shared vector, wherever the pop
// is written.

static mut STACK: Vec<String> = #[]

fn enter(key: String) {
    unsafe { STACK.push(key) }
}

fn leave() -> Option<String> {
    unsafe { STACK.pop() }
}

fn main() {
    enter("main")
    enter("dialog")
    unsafe { println(f"{STACK.len()} {leave()} {STACK.len()}") }
    let _ = unsafe { STACK }.pop()
    unsafe { println(f"{STACK.len()} {STACK.pop()}") }
}
