// Byte kernels on the portable `Simd` surface: UTF-8 validation that skips
// ASCII sixteen bytes at a time, base64 decoding that classifies sixteen
// characters per step, and a `memchr`-style search walking a bitmask. Each
// answers what its scalar counterpart answers.
use std::encoding::base64

/// Whether `bytes` is valid UTF-8: whole ASCII blocks are skipped by one
/// bitmask test, and a block holding a multi-byte sequence is checked a
/// character at a time from its first non-ASCII byte.
fn utf8_valid(bytes: [u8]) -> bool {
    let n = bytes.len()
    let high: Simd<u8, 16> = Simd::splat(128)
    let mut i = 0
    while i < n {
        let block: Simd<u8, 16> = Simd::load_or(bytes, i, 0)
        let wide = block.lanes_ge(high)
        match wide.first_set() {
            None => {
                i += 16
            }
            Some(first) => {
                i += first
                let lead = bytes[i] as i64
                let extra = if lead < 0xC2 {
                    return false
                } else if lead < 0xE0 {
                    1
                } else if lead < 0xF0 {
                    2
                } else if lead < 0xF5 {
                    3
                } else {
                    return false
                }
                if i + extra >= n {
                    return false
                }
                let mut k = 1
                while k <= extra {
                    if (bytes[i + k] as i64) & 0xC0 != 0x80 {
                        return false
                    }
                    k += 1
                }
                let second = bytes[i + 1] as i64
                if (lead == 0xE0 && second < 0xA0) || (lead == 0xED && second > 0x9F) {
                    return false
                }
                if (lead == 0xF0 && second < 0x90) || (lead == 0xF4 && second > 0x8F) {
                    return false
                }
                i += extra + 1
            }
        }
    }
    true
}

/// The six-bit values of sixteen base64 characters, and a mask of the
/// lanes that are not base64 characters at all.
fn classify(chars: Simd<u8, 16>) -> (Simd<u8, 16>, Mask<16>) {
    let upper = chars.lanes_ge(Simd::splat(65)) & chars.lanes_le(Simd::splat(90))
    let lower = chars.lanes_ge(Simd::splat(97)) & chars.lanes_le(Simd::splat(122))
    let digit = chars.lanes_ge(Simd::splat(48)) & chars.lanes_le(Simd::splat(57))
    let plus = chars.lanes_eq(Simd::splat(43))
    let slash = chars.lanes_eq(Simd::splat(47))
    let zero: Simd<u8, 16> = Simd::splat(0)
    let mut values = upper.select(chars -% Simd::splat(65), zero)
    values = lower.select(chars -% Simd::splat(71), values)
    values = digit.select(chars +% Simd::splat(4), values)
    values = plus.select(Simd::splat(62), values)
    values = slash.select(Simd::splat(63), values)
    let known = upper | lower | digit | plus | slash
    (values, known.select(Simd::splat(false), Simd::splat(true)))
}

/// Standard base64 with `=` padding, sixteen characters per step.
fn base64_decode(text: String) -> Option<Vec<u8>> {
    let bytes = text.bytes()
    let mut n = bytes.len()
    if n % 4 != 0 {
        return None
    }
    let mut pad = 0
    while pad < 2 && n > 0 && bytes[n - 1] == 61 {
        n -= 1
        pad += 1
    }
    let mut out: Vec<u8> = #[]
    let mut i = 0
    while i < n {
        let chunk: Simd<u8, 16> = Simd::load_or(bytes, i, 65)
        let values, bad = classify(chunk)
        let take = if n - i < 16 { n - i } else { 16 }
        let stray = bad.to_bitmask() & ((1u64 << (take as u64)) - 1)
        if stray != 0 {
            return None
        }
        let v = values.to_array()
        let mut g = 0
        while g + 4 <= take {
            let word = (v[g] as u64) << 18 | (v[g + 1] as u64) << 12 | (v[g + 2] as u64) << 6 | (v[g + 3] as u64)
            out.push((word >> 16) as u8)
            out.push((word >> 8) as u8)
            out.push(word as u8)
            g += 4
        }
        if g < take {
            let mut word = 0u64
            let mut k = 0
            while g + k < take {
                word = word | (v[g + k] as u64) << ((18 - 6 * k) as u64)
                k += 1
            }
            out.push((word >> 16) as u8)
            if k == 3 {
                out.push((word >> 8) as u8)
            }
        }
        i += 16
    }
    Some(out)
}

/// The first index of `needle` in `hay`, sixteen bytes per step.
fn find_byte(hay: [u8], needle: u8) -> Option<i64> {
    let target: Simd<u8, 16> = Simd::splat(needle)
    let mut i = 0
    while i < hay.len() {
        let block: Simd<u8, 16> = Simd::load_or(hay, i, needle +% 1)
        match block.lanes_eq(target).first_set() {
            Some(lane) => return Some(i + lane)
            None => {}
        }
        i += 16
    }
    None
}

fn scalar_find(hay: [u8], needle: u8) -> Option<i64> {
    let mut i = 0
    while i < hay.len() {
        if hay[i] == needle {
            return Some(i)
        }
        i += 1
    }
    None
}

fn main() {
    let samples = #[
        ""
        "plain ascii text that runs past sixteen bytes"
        "héllo wörld, ünïcödé"
        "日本語のテキストとASCII"
        "emoji 😀 and more"
    ]
    for text in samples {
        let bytes = text.bytes()
        println(f"utf8 {utf8_valid(bytes)} {String::from_utf8(bytes).is_ok()}")
    }
    let broken = #[#[0xC3u8, 0x28], #[0xE2u8, 0x82], #[0xF0u8, 0x9F, 0x98], #[0xEDu8, 0xA0, 0x80], #[0x41u8; 20]]
    for bytes in broken {
        println(f"broken {utf8_valid(bytes)} {String::from_utf8(bytes).is_ok()}")
    }
    let inputs = #["", "Zg==", "Zm8=", "Zm9v", "SGVsbG8sIFNJTUQgd29ybGQh", "VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZw==", "bad*input!", "abc"]
    for text in inputs {
        let ours = base64_decode(text)
        let theirs = base64::decode(text)
        println(f"base64 {ours} {theirs.is_ok()} {ours == theirs.ok()}")
    }
    let hay = "the needle is near the end of this haystack: X".bytes()
    println(f"find {find_byte(hay, 88)} {scalar_find(hay, 88)} {find_byte(hay, 63)} {scalar_find(hay, 116)}")
}
