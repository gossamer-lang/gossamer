// An `else if` chain with no final `else` answers no value, like an
// else-less `if`, so its branches keep their own types. A loop body discards
// its tail, so a chain there may end each branch in a different value.

fn record(mut m: Map<String, i64>, i: i64) -> i64 {
    if i == 0 {
        m.insert("a", i)
    } else if i == 1 {
        m.insert("b", i)
    }
    m.len()
}

fn pick(i: i64) -> i64 {
    let v = if i == 0 { 10 } else if i == 1 { 20 } else { 30 }
    v
}

fn main() {
    let mut m: Map<String, i64> = Map::new()
    let mut s: Set<i64> = #{}
    for i in 0..4 {
        if i == 0 {
            m.insert("x", i)
        } else if i == 1 {
            s.insert(i)
        } else {
            m.remove("x")
        }
    }
    let mut n = 0
    while n < 3 {
        n += 1
        if n == 1 { m.insert("w", n) } else if n == 2 { s.insert(n) }
    }
    let mut seen: Map<i64, i64> = Map::new()
    for i in 0..3 {
        if i == 0 {
            seen.insert(i, 1)
        } else if i == 2 {
            seen.insert(i, 3)
        }
    }
    println("{:?} {:?} {}", m, s, record(m, 1))
    println("{:?}", seen)
    println("{} {} {}", pick(0), pick(1), pick(2))
}
