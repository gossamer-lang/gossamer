// Scalar statics written by a body that stays interpreted (it holds a sync
// object) and read and written by a hot compiled loop: both tiers must see
// one value.
use std::sync

static mut COUNT: i64 = 0
static mut SCALE: f64 = 1.5
static mut ON: bool = false
static mut MARK: char = 'a'
static mut SMALL: u8 = 250

struct Item {
    name: String
    weight: i64
}

fn record(items: Vec<Item>) {
    let guard = sync::Mutex::new()
    for item in items {
        guard.lock()
        defer guard.unlock()
        unsafe { COUNT += item.weight }
        unsafe { MARK = item.name[0] }
    }
    unsafe { ON = !ON }
    unsafe { SCALE *= 2.0 }
    unsafe { SMALL = 7 }
}

fn hot(n: i64) -> i64 {
    let mut acc = 0
    for i in 0..n {
        unsafe { acc += COUNT + i }
        unsafe { COUNT += 1 }
    }
    if unsafe { ON } {
        acc += 1000
    }
    if unsafe { MARK } == 'z' {
        acc += 2000
    }
    unsafe { acc + (SCALE * 10.0) as i64 + SMALL as i64 }
}

fn main() {
    println(hot(10))
    record(#[Item { name: "apple", weight: 5 }, Item { name: "zest", weight: 7 }])
    println(hot(10))
    unsafe { println(f"{COUNT} {SCALE} {ON} {MARK} {SMALL}") }
}
