// `json::encode` over every aggregate shape the lowering walks: a struct, a
// sequence of structs, nested structs, a tuple, and a nested sequence. Each
// tier builds the same document, so each prints the same text.

use std::encoding::json

struct Inner {
    n: i64
    tags: Vec<String>
}

struct Item {
    id: i64
    title: String
    ratio: f64
    done: bool
    inner: Inner
    pair: (i64, String)
}

fn item(id: i64, title: String) -> Item {
    Item {
        id: id
        title: title
        ratio: 1.5
        done: id % 2 == 0
        inner: Inner { n: id * 10, tags: #["a", "b"] }
        pair: (id, "p")
    }
}

fn main() {
    println("{}", json::encode(item(1, "one")))
    println("{}", json::encode(#[item(1, "one"), item(2, "two")]))
    println("{}", json::encode([item(3, "three")]))
    println("{}", json::encode((1, "a", true, 2.5)))
    println("{}", json::encode(#[(1, "a"), (2, "b")]))
    println("{}", json::encode(#[#[1, 2], #[3]]))
    println("{}", json::encode(#[#[Inner { n: 1, tags: #["z"] }]]))
    let empty: Vec<Item> = #[]
    println("{}", json::encode(empty))
    println("{} {} {} {}", json::encode(7), json::encode(true), json::encode(2.5), json::encode("s"))
    println("{} {}", json::encode(#[1, 2, 3]), json::encode(#["x", "y"]))
    map_fields()
}

struct Opts { flags: Map<String, i64>, name: String }
struct Pairs { table: Map<String, (i64, bool)> }
struct Wrapped { rows: Vec<Opts> }

// A `Map` field is a JSON object, whatever its values are, and an integer
// value keeps its digits rather than picking up a fractional part.
fn map_fields() {
    let mut flags: Map<String, i64> = Map::new()
    let _ = flags.insert("a", 1)
    let _ = flags.insert("b", 22)
    println("{}", json::encode(flags))
    println("{}", json::encode(Opts { flags: flags, name: "n" }))
    println("{}", json::encode(Wrapped { rows: #[Opts { flags: flags, name: "n" }] }))

    let mut table: Map<String, (i64, bool)> = Map::new()
    let _ = table.insert("t", (3, true))
    println("{}", json::encode(Pairs { table: table }))

    let mut texts: Map<String, String> = Map::new()
    let _ = texts.insert("k", "v")
    println("{}", json::encode(texts))

    let empty: Map<String, i64> = Map::new()
    println("{}", json::encode(empty))

    let mut total = 0
    let mut i = 0
    while i < 3000 {
        total += json::encode(Opts { flags: flags, name: "n" }).len()
        i += 1
    }
    println("hot: {}", total)
}
