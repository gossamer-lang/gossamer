// `html::template` renders a context-aware HTML template, escaping each
// substitution by where it lands: HTML text, a quoted attribute, a URL
// attribute, or a `<script>` body. The data is any value with a JSON form,
// and the output is the same on every tier.

use std::html::template
use std::html::template::Template

struct Page {
    name: String
    link: String
    attr: String
    msg: String
}

fn main() {
    let page = Template::parse("<p>{{ .name }}</p> <a href=\"{{ .link }}\">x</a> <input value=\"{{ .attr }}\"> <script>var m={{ .msg }}</script>").unwrap()
    let data = Page { name: "<b>", link: "javascript:x", attr: "a&b", msg: "</script>" }
    match page.render(data) {
        Ok(out) => {
            println(out)
            // Text context: angle brackets HTML-escaped.
            assert(out.contains("&lt;b&gt;"), "text context escaped")
            // URL context: the javascript: scheme is neutralised to '#'.
            assert(out.contains("href=\"#\""), "url scheme blocked")
            assert(!out.contains("javascript:"), "no javascript scheme survives")
            // Quoted-attribute context: ampersand entity-escaped.
            assert(out.contains("value=\"a&amp;b\""), "attr context escaped")
            // JS context: the </script> breakout is unicode-escaped.
            assert(out.contains("u003c"), "js context unicode-escaped")
            assert(!out.contains("var m=</script>"), "no raw script breakout")
        }
        Err(e) => panic(f"render failed: {e}")
    }
    println(template::render("<b>{{ .x }}</b>", { "x": "1 < 2" }).unwrap())
    match template::render("{{ .nope }}", { "x": 1 }) {
        Ok(_) => println("missing rendered")
        Err(e) => println(f"missing: {e}")
    }
    println("ok")
}
