// Mutable static - read+write across function boundaries.
// Verifies that `static mut` storage is shared and observable
// from both the writer and reader, in all tiers.

static mut COUNTER: i64 = 0

fn bump() {
    unsafe { COUNTER += 1 }
}

fn read() -> i64 {
    unsafe { COUNTER }
}

fn main() {
    println("start = {}", read())
    bump()
    bump()
    bump()
    println("after 3 bumps = {}", read())
    unsafe { COUNTER = 100 }
    println("after assign 100 = {}", read())
}
