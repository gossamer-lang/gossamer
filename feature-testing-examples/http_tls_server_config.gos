const CLIENT_CERT: String = "-----BEGIN CERTIFICATE-----\nMIIBrTCCAVOgAwIBAgIUMSPLkEbusH5msEE383mgUOPQkKIwCgYIKoZIzj0EAwIw\nHjEcMBoGA1UEAwwTR29zc2FtZXIgRml4dHVyZSBDQTAgFw0yNjExMjYxMDMwMjFa\nGA8yMTI2MTEwMjEwMzAyMVowGTEXMBUGA1UEAwwOZml4dHVyZSBjbGllbnQwWTAT\nBgcqhkjOPQIBBggqhkjOPQMBBwNCAATTxMkQ7V3ud1by1rB+QuePv7nZRNSwPDUT\n58o2nm2R/AO54gs4dbmlyMr2xzrXxcCarL4tr3JBdsIfAOnF2SSlo3IwcDAJBgNV\nHRMEAjAAMA4GA1UdDwEB/wQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDAjAdBgNV\nHQ4EFgQUY1T3jHpzeCECEoCcNSE5mHOUQ+8wHwYDVR0jBBgwFoAUDBylyoFSUjZ2\nldfrU7YaZNpl9BgwCgYIKoZIzj0EAwIDSAAwRQIgc10DKuVJ2TRLc3hSYMMFkeIT\nwgOfSXvDZmodBoxxIYQCIQC3KGljPX6Xb875jwEgGyrHxsjqnjAE1vNPp8b2ItYq\nVA==\n-----END CERTIFICATE-----\n"

const CLIENT_KEY: String = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgCVTy2BCXFGei1NWy\nKGBG6PAxwKrGPnqDIK6FG6Xz64mhRANCAATTxMkQ7V3ud1by1rB+QuePv7nZRNSw\nPDUT58o2nm2R/AO54gs4dbmlyMr2xzrXxcCarL4tr3JBdsIfAOnF2SSl\n-----END PRIVATE KEY-----\n"

const REQUEST: String = "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"

struct App { }

impl http::Handler for App {
    fn serve(&self, _r: http::Request) -> http::Response {
        http::Response::text(200, "tls config ok")
    }
}

fn address(index: i64, fallback: String) -> String {
    let args = env::args()
    if args.len() > index { args[index] } else { fallback }
}

fn await_ready(addr: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(s) = net::TcpStream::connect(addr) {
            let _ = s.close()
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn der(cert: String) -> Vec<u8> {
    match pem::decode(cert) {
        Ok(block) => block.bytes
        Err(_) => #[]
    }
}

fn served(tls: net::TcpStream) -> String {
    let _ = tls.write(REQUEST.as_bytes())
    match tls.read(1024) {
        Ok(b) => {
            if b.len() == 0 {
                return "rejected"
            }
        }
        Err(_) => return "rejected"
    }
    let peer = tls.peer_certificate()
    if peer == der(CERT_A) {
        "A"
    } else if peer == der(CERT_B) {
        "B"
    } else if peer == der(CERT_C) {
        "C"
    } else {
        "unknown"
    }
}

fn without_identity(addr: String, host: String) -> String {
    let stream = match net::TcpStream::connect(addr) {
        Ok(s) => s
        Err(_) => return "no connection"
    }
    match stream.start_tls_ca(host, CA) {
        Ok(tls) => served(tls)
        Err(_) => "rejected"
    }
}

fn with_identity(addr: String) -> String {
    let stream = match net::TcpStream::connect(addr) {
        Ok(s) => s
        Err(_) => return "no connection"
    }
    match stream.start_tls_identity("localhost", CA, CLIENT_CERT, CLIENT_KEY) {
        Ok(tls) => served(tls)
        Err(_) => "rejected"
    }
}

fn main() {
    let strict_addr = address(1, "127.0.0.1:23985")
    let open_addr = address(2, "127.0.0.1:23972")
    let strict = tls::ServerConfig::new(CERT_A, KEY_A, client_ca: Some(CA)).unwrap()
    let open = tls::ServerConfig::new(CERT_A, KEY_A, client_ca: Some(CA), client_auth_optional: true).unwrap()
    open.add_sni("other.test", CERT_B, KEY_B).unwrap()
    println(f"bad key refused: {tls::ServerConfig::new(CERT_A, KEY_B).is_err()}")
    spawn(|| {
        let _ = http::serve_tls_config(strict_addr, strict, App { })
    })
    spawn(|| {
        let _ = http::serve_tls_config(open_addr, open, App { })
    })
    await_ready(strict_addr)
    await_ready(open_addr)
    println(f"mtls without a client certificate: {without_identity(strict_addr, "localhost")}")
    println(f"mtls with a client certificate: {with_identity(strict_addr)}")
    println(f"optional auth, no certificate: {without_identity(open_addr, "localhost")}")
    println(f"sni other.test: {without_identity(open_addr, "other.test")}")
    open.reload(CERT_C, KEY_C).unwrap()
    println(f"after reload: {without_identity(open_addr, "localhost")}")
    println(f"sni kept after reload: {without_identity(open_addr, "other.test")}")
    println(f"bad reload keeps the old certificate: {open.reload(CERT_A, KEY_C).is_err()} {without_identity(open_addr, "localhost")}")
    process::exit(0)
}
