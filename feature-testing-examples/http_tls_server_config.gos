// `tls::ServerConfig` on every tier: a server that requires a client
// certificate (mutual TLS), one that serves a second certificate by SNI name,
// and a reload that reaches the next handshake without a restart. Each client
// names the certificate it was served by comparing the peer's certificate
// with the known ones. The addresses come from the test harness, with fixed
// ones when the program runs alone.
use std::{env, http, net, process, time, tls}
use std::encoding::pem

