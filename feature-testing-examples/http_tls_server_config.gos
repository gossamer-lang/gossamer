const CERT_C: String = "-----BEGIN CERTIFICATE-----\nMIIBwTCCAWigAwIBAgIUMSPLkEbusH5msEE383mgUOPQkKEwCgYIKoZIzj0EAwIw\nHjEcMBoGA1UEAwwTR29zc2FtZXIgRml4dHVyZSBDQTAgFw0yNjExMjYxMDMwMjFa\nGA8yMTI2MTEwMjEwMzAyMVowFjEUMBIGA1UEAwwLbG9jYWxob3N0IEMwWTATBgcq\nhkjOPQIBBggqhkjOPQMBBwNCAAScR1B0gWJWjGF3fjcr3Nc+fNrtoAOeNwUhZdMD\nwywcUmQC0hFUiCt+6vsxlnKCuPNvjpXlcoMtiIb/B3Owr+dqo4GJMIGGMAkGA1Ud\nEwQCMAAwDgYDVR0PAQH/BAQDAgeAMBMGA1UdJQQMMAoGCCsGAQUFBwMBMBQGA1Ud\nEQQNMAuCCWxvY2FsaG9zdDAdBgNVHQ4EFgQUbR1frRiPPoFtPwfzWy5rFxr/i5gw\nHwYDVR0jBBgwFoAUDBylyoFSUjZ2ldfrU7YaZNpl9BgwCgYIKoZIzj0EAwIDRwAw\nRAIgSrq6DbFpkKJsxqozMzn42XiHA5sU5OPEAe1sasRncSYCIBn/WwLcyN/WLTTZ\nD3hElt54JjkvxGmY3lD+A+nXebZ+\n-----END CERTIFICATE-----\n"

