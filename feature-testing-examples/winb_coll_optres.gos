// Win B collections sweep: std::option / std::result combinator
// surface across tiers, with special attention to Option/Result
// payloads that carry structs. map/and_then/filter/or/or_else/
// unwrap_or/unwrap_or_else/zip/flatten/is_some/is_none and result
// map/map_err/and_then/or_else/unwrap_or/unwrap_or_else/ok/err/is_ok/
// is_err, with float payloads falling back to the value written.
// Bit-identical VM vs compiled.

use std::option
use std::result
use std::errors

#[derive(PartialEq, Eq, Debug)]
struct Point { x: i64, y: i64 }

fn main() {
    // ---- Option, scalar payloads ----
    let some: Option<i64> = Some(3)
    let none: Option<i64> = None
    println("map {}", some |> |v| option::map(v, |n: i64| n + 1) |> |v| option::unwrap_or(v, 0))
    println("map-none {}", none |> |v| option::map(v, |n: i64| n + 1) |> |v| option::unwrap_or(v, -1))
    println("and_then {}"
        some |> |v| option::and_then(v, |n: i64| if n > 1 { Some(n * 10) } else { None }) |> |v| option::unwrap_or(v, 0))
    println("filter-keep {}", some |> |v| option::filter(v, |n: i64| n % 2 == 1) |> |v| option::unwrap_or(v, 0))
    println("filter-drop {}", some |> |v| option::filter(v, |n: i64| n % 2 == 0) |> |v| option::unwrap_or(v, -1))
    println("or {}", none |> |v| option::or(v, Some(5)) |> |v| option::unwrap_or(v, 0))
    println("or_else {}", none |> |v| option::or_else(v, || Some(6)) |> |v| option::unwrap_or(v, 0))
    println("unwrap_or_else {}", none |> |v| option::unwrap_or_else(v, || 9))
    println("is_some {} is_none {}", some |> option::is_some, none |> option::is_none)

    // zip + flatten.
    let zipped = some |> |v| option::zip(v, Some(4))
    let mut zs = 0
    if let Some((a, b)) = zipped { zs = a + b }
    println("zip {}", zs)
    let nested: Option<Option<i64>> = Some(Some(8))
    println("flatten {}", nested |> option::flatten |> |v| option::unwrap_or(v, 0))

    // ---- Option, struct payloads ----
    let sp: Option<Point> = Some(Point { x: 1, y: 2 })
    let np: Option<Point> = None
    match sp {
        Some(p) => println("struct some {} {}", p.x, p.y)
        None => println("struct some none")
    }
    println("struct is_some {} none is_none {}", sp |> option::is_some, np |> option::is_none)
    // map a struct option to a scalar.
    println("struct map {}", sp |> |v| option::map(v, |p: Point| p.x + p.y) |> |v| option::unwrap_or(v, 0))
    // and_then producing a new struct option, read back.
    let moved = sp |> |v| option::and_then(v, |p: Point| Some(Point { x: p.x + 10, y: p.y + 20 }))
    match moved {
        Some(p) => println("struct and_then {} {}", p.x, p.y)
        None => println("struct and_then none")
    }

    // ---- Result, scalar payloads ----
    let ok: Result<i64, errors::Error> = Ok(2)
    let bad: Result<i64, errors::Error> = Err(errors::new("boom"))
    println("r map {}", ok |> |v| result::map(v, |n: i64| n * 3) |> |v| result::unwrap_or(v, 0))
    println("r map-err-default {}"
        bad |> |v| result::map(v, |n: i64| n * 3) |> |v| result::unwrap_or(v, -1))
    println("r and_then {}", ok |> |v| result::and_then(v, |n: i64| Ok(n + 10)) |> |v| result::unwrap_or(v, 0))
    println("r or_else {}", bad |> |v| result::or_else(v, |_e: errors::Error| Ok(7)) |> |v| result::unwrap_or(v, 0))
    println("r is_ok {} is_err {}", ok |> result::is_ok, bad |> result::is_err)
    println("r ok->some {} err->some {}"
        ok |> result::ok |> option::is_some, bad |> result::err |> option::is_some)
    bad |> |v| result::map_err(v, |e: errors::Error| errors::wrap(e, "ctx"))
        |> |v| result::unwrap_or_else(v, |e: errors::Error| println("r unwrap_or_else {}", e))

    // ---- Float payloads fall back to the value written ----
    let fbad: Result<f64, errors::Error> = Err(errors::new("nan"))
    let fnone: Option<f64> = None
    println("f unwrap_or {} {} {}", fbad.unwrap_or(0.25), fnone.unwrap_or(1.75), fbad |> |v| result::unwrap_or(v, 2.5))

    // ---- Result, struct payloads ----
    let rsp: Result<Point, errors::Error> = Ok(Point { x: 5, y: 6 })
    let rbad: Result<Point, errors::Error> = Err(errors::new("nope"))
    match rsp {
        Ok(p) => println("r struct ok {} {}", p.x, p.y)
        Err(e) => println("r struct err {}", e)
    }
    println("r struct map {}", rsp |> |v| result::map(v, |p: Point| p.x * p.y) |> |v| result::unwrap_or(v, 0))
    let rmoved = rsp |> |v| result::and_then(v, |p: Point| Ok(Point { x: p.x + 1, y: p.y + 1 }))
    match rmoved {
        Ok(p) => println("r struct and_then {} {}", p.x, p.y)
        Err(_) => println("r struct and_then err")
    }
    match rbad |> |v| result::map(v, |p: Point| p.x) {
        Ok(v) => println("r struct bad ok {}", v)
        Err(e) => println("r struct bad err {}", e)
    }
}
