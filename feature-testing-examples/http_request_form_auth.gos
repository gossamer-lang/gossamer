// Cross-tier regression for the request-side conveniences
// `r.form_value(key)` and `r.basic_auth()`. The handler reads two
// fields out of an `application/x-www-form-urlencoded` body and the
// `(user, password)` out of an `Authorization: Basic` header, then
// echoes them. Both reads lower identically on the bytecode VM
// (`gos`) and LLVM AOT (`gos build`): `form_value` returns a
// `String` (empty when absent), `basic_auth` returns
// `Option<(String, String)>` packed as the same 2-word shape
// `split_once` uses.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_request_form_auth_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        let user = r.form_value("user")
        let role = r.form_value("role")
        let missing = r.form_value("nope")
        let auth = match r.basic_auth() {
            Some((u, p)) => "auth=" + u + ":" + p
            None => "auth=none"
        }
        http::Response::text(
            200
            "form_user=" + user + " form_role=" + role
            + " missing=[" + missing + "] " + auth
        )
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23898", App { }) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| serve_app())
    await_ready("http://127.0.0.1:23898/x")
    // "admin:s3cret" base64-encoded is "YWRtaW46czNjcmV0".
    let hdr: Vec<(String, String)> = Vec::from([
        ("Content-Type", "application/x-www-form-urlencoded")
        ("Authorization", "Basic YWRtaW46czNjcmV0")
    ])
    match http::request("POST", "http://127.0.0.1:23898/x", "user=alice&role=admin", hdr) {
        Ok(r) => println("status={} body={}", r.status, r.body)
        Err(e) => println("error: {}", e)
    }
    // No-auth, no-body request: both conveniences degrade gracefully.
    match http::get("http://127.0.0.1:23898/x", Vec::from([])) {
        Ok(r) => println("status={} body={}", r.status, r.body)
        Err(e) => println("error: {}", e)
    }
    process::exit(0)
}
