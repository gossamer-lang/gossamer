// Channel Fan-In
// Spawn several goroutines sending values into one channel and drain
// with while let Some to expose scheduler and recv differences.

use std::sync::channel

fn worker(id: i64, tx: channel::Sender<i64>, val: i64) {
    tx.send(val)
}

fn main() {
    let tx, rx = channel::unbounded()

    spawn(|| worker(1, tx, 10))
    spawn(|| worker(2, tx, 20))
    spawn(|| worker(3, tx, 30))
    spawn(|| worker(4, tx, 40))
    spawn(|| worker(5, tx, 50))

    // `main` still holds a sender, so the channel never closes on its own:
    // take exactly one value per worker, each `recv` waiting for its send.
    let mut received: Vec<i64> = Vec::from([])
    for _ in 0..5 {
        if let Some(v) = rx.recv() {
            received.push(v)
        }
    }

    received.sort()
    for v in received {
        println("received {}", v)
    }

    let mut total = 0
    for v in [10, 20, 30, 40, 50] {
        total += v
    }
    println("fan-in total = {}", total)
}

#[cfg(test)]
mod tests {
    use std::sync::channel
    use std::testing

    #[test]
    fn fan_in_total() {
        let tx, rx = channel::unbounded()
        // The block joins every sender before it is left, so the drain
        // below reads a channel every send has already reached.
        let _ = cohort {
            spawn(|| super::worker(1, tx, 10))
            spawn(|| super::worker(2, tx, 20))
            spawn(|| super::worker(3, tx, 30))
        }
        let mut total = 0
        while let Some(v) = rx.try_recv() {
            total += v
        }
        let _ = testing::check_eq(total, 60, "10+20+30=60")
    }
}
