// Closed-channel select readiness.
//
// A `select` receive answers `Option<T>`: `Some(v)` for a value, `None`
// once the channel is closed and drained. A `Some(v)` arm is ready only
// when a value waits, a `None` arm only once the channel is closed and
// drained, and a bare name takes either. An open-but-empty channel's
// recv arm stays not-ready, so the default arm fires. Every selection
// point here is decided synchronously - no goroutines, no sleeps - so
// stdout is bit-identical across the bytecode VM (`gos` / `gos test`),
// the Cranelift JIT, and the LLVM AOT tier (`gos build`).

use std::sync::channel

fn main() {
    // 1. Open + empty channel: the recv arm is not ready, default fires.
    let tx, rx = channel()
    let open = select {
        v = rx.recv() => v
        default => Some(-1)
    }
    println("open empty = {}", open)

    // 2. After close, the same channel's recv arm is ready with `None`,
    //    chosen over the default.
    tx.close()
    let closed = select {
        v = rx.recv() => v
        default => Some(-1)
    }
    println("closed = {}", closed)

    // 3. A closed channel still drains its buffered values in order,
    //    then answers `None` once empty.
    let tx2, rx2 = channel::unbounded()
    tx2.send(7)
    tx2.send(8)
    tx2.close()
    let mut drained = #[]
    for _ in 0..3 {
        let got = select {
            Some(v) = rx2.recv() => v
            None = rx2.recv() => 0
            default => -1
        }
        drained.push(got)
    }
    println("buffered = {}", drained)

    // 4. An arm that takes only values is not ready on a closed channel,
    //    and one that takes only the close waits out the buffer.
    let tx3, rx3 = channel::unbounded()
    tx3.send(1)
    tx3.close()
    let close_first = select {
        None = rx3.recv() => "closed"
        default => "still buffered"
    }
    let value = select {
        Some(v) = rx3.recv() => v
        default => -1
    }
    let value_after = select {
        Some(v) = rx3.recv() => v
        default => -1
    }
    let close_after = select {
        None = rx3.recv() => "closed"
        default => "still buffered"
    }
    println("{} {} {} {}", close_first, value, value_after, close_after)
}

#[cfg(test)]
mod select_closed_tests {
    use std::sync::channel
    use std::testing

    #[test]
    fn open_empty_recv_arm_falls_to_default() {
        let _tx, rx = channel()
        let chosen = select {
            v = rx.recv() => v
            default => Some(-1)
        }
        let _ = testing::check(chosen == Some(-1), "open+empty recv arm is not ready")
    }

    #[test]
    fn closed_recv_arm_is_ready_with_none() {
        let tx, rx = channel::unbounded()
        tx.close()
        let chosen = select {
            v = rx.recv() => v
            default => Some(-1)
        }
        let _ = testing::check(chosen.is_none(), "closed recv arm answers None")
    }

    #[test]
    fn closed_channel_drains_before_none() {
        let tx, rx = channel::unbounded()
        tx.send(42)
        tx.close()
        let a = select {
            v = rx.recv() => v
            default => Some(-1)
        }
        let b = select {
            v = rx.recv() => v
            default => Some(-1)
        }
        let _ = testing::check_eq(a, Some(42), "buffered value drains first")
        let _ = testing::check(b.is_none(), "None once drained")
    }
}
