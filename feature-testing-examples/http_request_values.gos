// Cross-tier regression for request-scoped values (Go's
// context.WithValue / ctx.Value analog). A handler attaches identity
// data with `r.set_value(key, value)` and reads it back with
// `r.value(key)`; an absent key yields "". Re-setting a key overwrites
// the prior value (replace-then-push). Bit-identical under `gos`
// (bytecode VM) and `gos build` (LLVM AOT).
//
// `set_value` mutates the request in place and returns it on the
// compiled tiers; on the VM it returns a rebuilt request (structs are
// immutable values). Threading the returned request is therefore the
// rule on every tier - this fixture shadows `r` at each step.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// `http_request_values_parity_across_tiers` in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::process
use std::time

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> http::Response {
        let r = r.set_value("user", "alice")
        let r = r.set_value("role", "admin")
        // Replace-then-push: re-setting `user` overwrites the value.
        let r = r.set_value("user", "bob")
        http::Response::text(
            200
            "user=" + r.value("user") + " role=" + r.value("role") +
                " missing=[" + r.value("nope") + "]"
        )
    }
}

fn serve_app() {
    if let Err(e) = http::serve("127.0.0.1:23884", App { }) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| serve_app())
    await_ready("http://127.0.0.1:23884/x")
    match http::get("http://127.0.0.1:23884/x", Vec::from([])) {
        Ok(r) => println("status={} body={}", r.status, r.body)
        Err(e) => println("error: {}", e)
    }
    process::exit(0)
}
