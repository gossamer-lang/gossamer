// `term::read_password` writes its prompt to standard error and reads a line
// without echo. Input that is not a terminal is read up to its next newline,
// leaving out the `\r` before it, and an empty input is an `Err`.

use std::term

fn main() {
    let first = term::read_password("Password: ").unwrap()
    println(f"first: {first} ({first.len()} chars)")
    let second = term::read_password().unwrap()
    println(f"second: {second}")
    let last = term::read_password("again: ")
    println(f"no more input: {last.is_err()}")
}
