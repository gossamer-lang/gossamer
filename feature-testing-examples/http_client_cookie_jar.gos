// Cross-tier regression for the http::Client cookie jar (Go's
// net/http/cookiejar analog). A persistent Client built with
// .cookie_jar(true) stores the Set-Cookie from /login and re-sends it
// on the follow-up /me request; the handler echoes the Cookie header
// it received. Proves the jar round-trips across two requests on the
// SAME client handle.
//
// The jar survives only because the client holds a persistent engine:
// the compiled tiers keep one ureq Agent on the boxed GosHttpClient
// (built at .build()), and the interp tier keeps the built
// gossamer_std::http::Client in an id-keyed registry. Without that,
// each gos_rt_http_client_* call would build a throwaway agent and the
// cookie would not survive between requests.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// http_client_cookie_jar_parity_across_tiers in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::env
use std::http
use std::process
use std::time

// Selected-header lookup through a borrowed header list - the same
// shape http_request_headers.gos uses, which lowers identically on
// every tier (r.headers is a Vec<(String, String)>).
fn header_of(headers: [(String, String)], want: String) -> String {
    let mut found = ""
    for (name, value) in headers {
        if name == want {
            found = *value
        }
    }
    found
}

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        if r.path == "/login" {
            return Ok(http::Response::text(200, "logged in")
                .with_header("set-cookie", "sid=abc123"))
        }
        let cookie = header_of(r.headers, "cookie")
        Ok(http::Response::text(200, format("cookie={}", cookie)))
    }
}

/// Where this run listens; the caller names it, so nothing on the box is
/// competed for. The default is what running the fixture by hand gets.
fn addr() -> String { env::args().first().unwrap_or("127.0.0.1:23887") }

fn base() -> String { "http://" + addr() }

fn serve_app() {
    if let Err(e) = http::serve(addr(), App { }) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| serve_app())
    await_ready(base() + "/ready")

    let client = http::Client::builder().cookie_jar(true).timeout_ms(5000).build()
    match client.request("GET", base() + "/login", "", #[]) {
        Ok(r) => println("login status={}", r.status)
        Err(e) => println("login error: {}", e)
    }
    match client.request("GET", base() + "/me", "", #[]) {
        Ok(r) => println("me_body={}", r.body)
        Err(e) => println("me error: {}", e)
    }

    process::exit(0)
}
