// Associated consts declared in modules: each hoists into its own module, and
// a read reaches the one its path, its module, or its import names.

use b::V

mod a {
    pub struct V { pub x: i64 }
    impl V { pub const K: V = V { x: 1 } }
    pub fn own() -> i64 { V::K.x }
    pub mod inner {
        pub fn up() -> i64 { super::V::K.x }
    }
}
mod b {
    pub struct V { pub x: i64 }
    impl V {
        pub const K: V = V { x: 2 }
        pub fn me() -> i64 { Self::K.x }
    }
    pub fn own() -> i64 { V::K.x }
}
fn main() {
    // Each call site runs twice, so the JIT compiles `main` with its
    // spliced defaults.
    for round in 1..3 {
        println(f"round {round}")
        println(a::V::K.x)
        println(b::V::K.x)
        println(crate::a::V::K.x)
        println(V::K.x)
        println(a::own())
        println(b::own())
        println(a::inner::up())
        println(b::V::me())
    }
}
