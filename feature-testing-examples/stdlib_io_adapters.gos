// Cross-tier parity for the `std::io` stream adapters: in-memory
// readers and writers, limit_reader, tee_reader, multi_reader, pipe,
// and copy_n. Each is an `io::MemoryStream`; adapters compose by value
// and keep their sources alive, on the VM, the JIT, and LLVM AOT alike.
use std::io

fn main() {
    let src = io::string_reader("abcdefgh")
    println("limit={}", io::drain(io::limit_reader(src, 3)))

    let teed = io::string_reader("hello world")
    let sink = io::buffer_writer()
    println("tee={}", io::drain(io::tee_reader(teed, sink)))
    println("sink={}", io::contents(sink))

    let a = io::string_reader("one ")
    let b = io::string_reader("two ")
    let c = io::string_reader("three")
    println("multi={}", io::drain(io::multi_reader(#[a, b, c])))

    let reader, writer = io::pipe()
    println("wrote={}", io::write(writer, "payload"))
    io::close_writer(writer)
    println("pipe={}", io::drain(reader))

    // Two pipes alive at once are two pairs of handles.
    let r1, w1 = io::pipe()
    let r2, w2 = io::pipe()
    io::write(w1, "first")
    io::write(w2, "second")
    io::close_writer(w1)
    io::close_writer(w2)
    println("pipes={} {} {}", io::drain(r1), io::drain(r2), r1 != r2)

    let from = io::string_reader("0123456789")
    let to = io::buffer_writer()
    match io::copy_n(to, from, 4) {
        Ok(n) => println("copied={} body={}", n, io::contents(to))
        Err(e) => println("copy failed: {}", e)
    }
    match io::copy_n(to, from, 100) {
        Ok(n) => println("rest={} body={}", n, io::contents(to))
        Err(e) => println("copy failed: {}", e)
    }

    // A limit reader stacked under a tee still mirrors only what it yields.
    let deep = io::string_reader("abcdefgh")
    let audit = io::buffer_writer()
    let chained = io::tee_reader(io::limit_reader(deep, 5), audit)
    println("chained={}", io::drain(chained))
    println("audit={}", io::contents(audit))
}
