// Cross-tier regression for http::websocket::accept - the RFC 6455
// server-side upgrade handshake. accept(req) validates the
// Upgrade / Connection / Sec-WebSocket-Version headers, computes
// Sec-WebSocket-Accept = base64(sha1(key + GUID)), and returns a
// 101 Switching Protocols Response. The compiled tier wires it to
// gos_rt_ws_accept (Result<Response, Error>); the interp tier to the
// native websocket::accept. The standalone accept_key call pins the
// token math directly (already cross-tier), and the handler proves
// the accept() entry validates + builds the 101.
//
// Returning the raw 101 to a plain HTTP client would leave the client
// awaiting the post-upgrade stream, so the handler echoes the upgrade
// status in a normal 200 body. A request without the upgrade headers
// must be rejected with the handshake error string.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// http_websocket_accept_parity_across_tiers in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::http
use std::http::websocket
use std::process
use std::time

// RFC 6455 §1.3 worked example: accept_key("dGhlIHNhbXBsZSBub25jZQ==")
// == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=".
const SAMPLE_KEY: String = "dGhlIHNhbXBsZSBub25jZQ=="

struct App { }

impl http::Handler for App {
    fn serve(&self, r: http::Request) -> Result<http::Response, http::Error> {
        match websocket::accept(r) {
            Ok(upgrade) => Ok(http::Response::text(200, format("status={}", upgrade.status)))
            Err(e) => Ok(http::Response::text(400, format("{}", e)))
        }
    }
}

fn serve_ws() {
    if let Err(e) = http::serve("127.0.0.1:23886", App { }) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    println("accept_key={}", websocket::accept_key(SAMPLE_KEY))

    spawn(|| serve_ws())
    await_ready("http://127.0.0.1:23886/x")

    let up: Vec<(String, String)> = Vec::from([
        ("Upgrade", "websocket")
        ("Connection", "Upgrade")
        ("Sec-WebSocket-Version", "13")
        ("Sec-WebSocket-Key", SAMPLE_KEY)
    ])
    match http::request("GET", "http://127.0.0.1:23886/ws", "", up) {
        Ok(r) => println("valid={}", r.body)
        Err(e) => println("valid error: {}", e)
    }
    match http::get("http://127.0.0.1:23886/ws", Vec::from([])) {
        Ok(r) => println("reject={}", r.body)
        Err(e) => println("reject error: {}", e)
    }

    process::exit(0)
}
