// Values that cross between interpreted and compiled code as a struct
// holding a byte vector, a unit-only enum, and float and integer vectors
// handed back and forth across many calls.
enum Rule {
    NonZero
    EvenOdd
}

struct Mask {
    left: i64
    width: i64
    coverage: Vec<u8>
}

struct Layer {
    px: Vec<f64>
    width: i64
}

fn fill(n: i64, rule: Rule) -> Mask {
    let mut cov = #[0u8; n]
    for i in 0..n {
        cov[i] = match rule {
            Rule::NonZero => (i % 200) as u8
            Rule::EvenOdd => (i * 3 % 251) as u8
        }
    }
    Mask { left: n % 5, width: n, coverage: cov }
}

fn flip(rule: Rule, times: i64) -> Rule {
    let mut r = rule
    for _ in 0..times {
        r = match r {
            Rule::NonZero => Rule::EvenOdd
            Rule::EvenOdd => Rule::NonZero
        }
    }
    r
}

fn covered(m: Mask) -> i64 {
    let mut t = 0
    for c in m.coverage { t += c as i64 }
    t + m.left + m.width
}

fn darken(m: &mut Mask, by: u8) {
    let mut i = 0
    while i < m.coverage.len() {
        if m.coverage[i] > by { m.coverage[i] -= by } else { m.coverage[i] = 0 }
        i += 1
    }
}

fn paint(layer: &mut Layer, m: Mask, k: f64) {
    let mut i = 0
    while i < m.coverage.len() && i < layer.px.len() {
        layer.px[i] = layer.px[i] * (1.0 - k) + m.coverage[i] as f64 / 255.0 * k
        i += 1
    }
}

fn scaled(xs: Vec<f64>, k: f64) -> Vec<f64> {
    let mut out = #[]
    for x in xs { out.push(x * k) }
    out
}

fn shifted(xs: Vec<i64>, by: i64) -> Vec<i64> {
    let mut out = #[]
    for x in xs { out.push(x + by) }
    out
}

fn main() {
    let mut total = 0
    let mut rule = Rule::NonZero
    let mut layer = Layer { px: #[0.5; 64], width: 8 }
    for i in 0..300 {
        rule = flip(rule, i % 3)
        let mut m = fill(40 + i % 9, rule)
        total += covered(m)
        darken(&mut m, 7)
        total += covered(m)
        paint(&mut layer, m, 0.25)
    }
    let mut xs = #[1.5, 2.5, 3.5]
    let mut ns = #[1, 2, 3]
    for _ in 0..200 {
        xs = scaled(xs, 1.01)
        ns = shifted(ns, 2)
    }
    let picked = match rule {
        Rule::NonZero => "nonzero"
        Rule::EvenOdd => "evenodd"
    }
    println(f"{total} {picked} {layer.px[3]:.6} {layer.px[63]:.6}")
    println(f"{xs[0]:.6} {xs[2]:.6} {ns}")
}
