// A `select { }` recv arm whose channel carries a struct (with a heap
// `String` field). The select value is a boxed pointer; the arm binding must
// be typed as the channel's element so field access derefs the box rather
// than reading the pointer bits inline. Deterministic output on every tier.

use std::sync::channel

struct M { v: i64, s: String }

fn prod(tx: Sender<M>) {
    tx.send(M { v: 7, s: format("hi") })
    tx.close()
}

fn main() {
    let tx, rx = channel()
    spawn(|| prod(tx))
    let got = select {
        Some(m) = rx.recv() => m.v + m.s.len()
    }
    println("select_struct={}", got)
}
