// A closure stored in the value it reads holds a reference cycle the
// runtime does not collect. `[weak o] || body` captures a weak reference
// instead: in the body `o` is the `Option` the reference upgrades to on
// that call, `Some` while the value lives and `None` once it is gone.
// `o.downgrade()` written by hand is the same capture.

struct Obj {
    payload: [u8; 16]
    callback: Option<Fn() -> i64>
}

fn make() -> Fn() -> i64 {
    let o = Obj { payload: [1u8; 16], callback: None }
    [weak o] || match o {
        Some(o) => o.payload.len()
        None => -1
    }
}

fn main() {
    let mut total = 0
    let mut i = 0
    while i < 3 {
        let mut o = Obj { payload: [0u8; 16], callback: None }
        o.callback = Some([weak o] || match o {
            Some(o) => o.payload.len()
            None => -1
        })
        if let Some(cb) = o.callback {
            total += cb()
        }
        i += 1
    }
    println(total)

    let mut by_hand = Obj { payload: [2u8; 16], callback: None }
    let w = by_hand.downgrade()
    by_hand.callback = Some(|| match w.upgrade() {
        Some(obj) => obj.payload[0] as i64
        None => -1
    })
    if let Some(cb) = by_hand.callback {
        println(cb())
    }

    let first = Obj { payload: [0u8; 16], callback: None }
    let second = Obj { payload: [5u8; 16], callback: None }
    let both = [weak first, weak second] | k: i64 | match (first, second) {
        (Some(a), Some(b)) => a.payload.len() + b.payload[0] as i64 + k
        _ => 0
    }
    println(both(10))

    let gone = make()
    println(gone())
}
