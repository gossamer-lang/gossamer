// Canonical stdlib namespace wiring across tiers.

use std::env
use std::fs
use std::fs as f
use std::fs::{read_dir}
use std::path
use std::process as p

fn main() {
    match env::home_dir() {
        Some(h) => println("home_nonempty={}", h.len() > 0)
        None => println("home_nonempty=false")
    }

    let dir = path::join(env::temp_dir(), "gossamer-alias-demo")
    let _ = fs::remove_dir_all(dir)
    let nested = path::join(dir, "a")
    match fs::create_dir_all(nested) {
        Ok(_) => println("mkdir_all_ok=true")
        Err(e) => println("mkdir_all_err={}", e)
    }

    let file = path::join(dir, "data.bin")
    let _ = fs::write(file, "abc".as_bytes())
    let bytes = fs::read(file).unwrap()
    println("read_file_len={}", bytes.len())

    match env::set_current_dir(dir) {
        Ok(_) => println("set_cwd_ok=true")
        Err(e) => println("set_cwd_err={}", e)
    }

    // `create_dir_all` and `write` above put exactly `a` and `data.bin`
    // under `dir`, and the walk yields them in sorted order.
    let _ = path::walk(dir, |entry| {
        println("walk_entry={}", entry.name)
        Ok(())
    })

    // A module alias and an item import reach the same functions and types
    // as the qualified spellings above.
    let _ = f::write(path::join(dir, "alias.txt"), "via alias")
    match f::read_to_string(path::join(dir, "alias.txt")) {
        Ok(text) => println("alias_read={}", text)
        Err(e) => println("alias_read_err={}", e)
    }
    match read_dir(dir) {
        Ok(entries) => println("imported_read_dir={}", entries.len())
        Err(e) => println("imported_read_dir_err={}", e)
    }
    match p::run("echo", #["aliased process"]) {
        Ok(out) => print("alias_run={}", out.stdout)
        Err(e) => println("alias_run_err={}", e)
    }

    let _ = fs::remove_dir_all(dir)
}
