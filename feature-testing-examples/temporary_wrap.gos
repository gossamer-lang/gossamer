// Regression: a `gos_rt_*` runtime-call result used DIRECTLY as a
// method receiver or pipe argument must carry the same pinned
// Gossamer type as the let-binding path. The compiled tiers used to
// dispatch on the unresolved HIR receiver type (a `Var`) and read
// the raw c-string / bare-i64 return through the wrong ABI, so
// `crypto::sha256::hex(x).len()` returned a garbage integer and
// `iter::min(xs) |> option::unwrap_or(0)` read a bare i64 through the
// 16-byte Option ABI. Binding to a local first always worked; these
// exercise the inline-temporary path on every tier.

use std::{crypto, iter, option}

fn main() {
    // sha256 / hmac hex digests are 64 ASCII hex chars. `.len()` on
    // the inline temporary must dispatch to `gos_rt_str_len` (strlen),
    // not the GosVec-header `gos_rt_len`.
    println("sha256 len = {}", crypto::sha256::hex("abc".as_bytes()).len())
    println("hmac len = {}", crypto::hmac::sha256_hex("key".as_bytes(), "msg".as_bytes()).len())

    // iter::min / iter::max are typed `Option<i64>`. Piped straight
    // into option::unwrap_or / matched inline, the boxed-Option ABI must
    // hold for the non-empty (Some) and empty (None) cases alike.
    let xs = #[4, 1, 7, 3]
    let lo = iter::min(xs) |> |v| option::unwrap_or(v, 0)
    let hi = iter::max(xs) |> |v| option::unwrap_or(v, 0)
    println("min = {} max = {}", lo, hi)

    let present = match iter::min(xs) {
        Some(_) => true
        None => false
    }
    println("min is_some = {}", present)

    let empty: Vec<i64> = Vec::from([])
    let fallback = iter::min(empty) |> |v| option::unwrap_or(v, -1)
    println("empty default = {}", fallback)
}
