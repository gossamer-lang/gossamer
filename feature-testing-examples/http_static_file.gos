// Cross-tier regression for http::static_files::FileServer served
// through http::serve. The compiled tier wires FileServer::new ->
// gos_rt_file_server_new and FileServer.serve ->
// gos_rt_file_server_serve (registry + symbol_table + cranelift +
// LLVM); the interp tier resolves the same surface through
// FileServer::new -> builtin_file_server_new and the http::serve
// dispatch loop -> native_file_server_serve. A real file is written
// to a per-process temp directory, served on a fixed loopback port,
// and fetched by the client in main. The prefix-strip, the `..`
// rejection, and the extension MIME table are bit-identical between
// the runtime shim and the interp native.
//
// Self-terminating: the client runs in main and exits explicitly, so
// the run is a plain stdout-parity comparison. Binds a fixed loopback
// port, serialized under SERVER_PORT_LOCK by
// http_static_file_parity_across_tiers in
// crates/gossamer-cli/tests/tier_parity.rs.

use std::env
use std::fs
use std::http
use std::http::static_files
use std::path
use std::process
use std::time

// Fixed sub-directory of the system temp dir. The three tier runs are
// sequential (serialized under SERVER_PORT_LOCK), and each run does an
// idempotent create_dir_all + overwrite + remove_all, so a stable name
// is collision-free without relying on a per-process suffix.
fn doc_root() -> String {
    path::join(env::temp_dir(), "gossamer_static_fixture")
}

fn serve_files(root: String) {
    let server = static_files::FileServer::new(root, "")
    if let Err(e) = http::serve("127.0.0.1:23883", server) {
        eprintln("serve failed: {e}")
    }
}

// Polls until the server goroutine accepts connections; binding is
// asynchronous, so readiness is observable only by connecting.
fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

// A response's headers are name/value pairs in arrival order, so a
// lookup is a scan rather than a map read.
fn header_of(headers: Vec<(String, String)>, name: String) -> String {
    for (key, value) in headers {
        if key.to_lowercase() == name {
            return value
        }
    }
    "none"
}

fn main() {
    let root = doc_root()
    let _ = fs::create_dir_all(root)
    let _ = fs::write(path::join(root, "hello.txt"), "static file ok".as_bytes())
    let _ = fs::write(path::join(root, "index.html"), "root index".as_bytes())
    let tour = path::join(root, "tour")
    let _ = fs::create_dir_all(tour)
    let _ = fs::write(path::join(tour, "index.html"), "tour index".as_bytes())

    spawn(|| serve_files(root))
    await_ready("http://127.0.0.1:23883/hello.txt")

    match http::get("http://127.0.0.1:23883/hello.txt", Vec::from([])) {
        Ok(r) => println("status={} body={}", r.status, r.body)
        Err(e) => println("error: {}", e)
    }
    match http::get("http://127.0.0.1:23883/missing.txt", Vec::from([])) {
        Ok(r) => println("missing status={}", r.status)
        Err(e) => println("missing error: {}", e)
    }

    // A directory is served as the index.html inside it, and a request
    // that named the directory without a trailing slash is redirected
    // to the form the page's own relative links resolve under.
    match http::get("http://127.0.0.1:23883/", Vec::from([])) {
        Ok(r) => println("root status={} body={}", r.status, r.body)
        Err(e) => println("root error: {}", e)
    }
    match http::get("http://127.0.0.1:23883/tour/", Vec::from([])) {
        Ok(r) => println("dir status={} body={}", r.status, r.body)
        Err(e) => println("dir error: {}", e)
    }
    // A client that does not follow redirects sees the 301 itself; the
    // default client follows it and lands on the same index.
    let direct = http::Client::builder().max_redirects(0).build()
    match direct.request("GET", "http://127.0.0.1:23883/tour", "", Vec::from([])) {
        Ok(r) => println("dir-no-slash status={} location={}", r.status, header_of(r.headers, "location"))
        Err(e) => println("dir-no-slash error: {}", e)
    }
    match http::get("http://127.0.0.1:23883/tour", Vec::from([])) {
        Ok(r) => println("dir-followed status={} body={}", r.status, r.body)
        Err(e) => println("dir-followed error: {}", e)
    }

    let _ = fs::remove_dir_all(root)
    process::exit(0)
}
