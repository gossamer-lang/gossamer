// Cross-tier regression for typed router path-parameter extractors.
// `r.path_int(name) -> Option<i64>` and `r.path_float(name) ->
// Option<f64>` parse the captured segment, returning None when absent
// or unparseable. This exercises the packed-Option C-ABI on the
// compiled tiers (the audit's known miscompile class), so a tier
// divergence here points straight at the Option<T> marshalling.
//
// Self-terminating; binds a fixed loopback port, serialized under
// SERVER_PORT_LOCK by `http_router_typed_params_parity_across_tiers`.

use std::http
use std::http::router
use std::process
use std::time

fn show(r: http::Request) -> http::Response {
    let id = match r.path_int("id") {
        Some(n) => n
        None => -1
    }
    let amt = match r.path_float("amt") {
        Some(f) => f
        None => -1.0
    }
    http::Response::text(200, format("id={} amt={} raw={}", id, amt, r.path_value("id")))
}

fn serve_router() {
    let r = router::Router::new().get("/p/{id}/{amt}", show)
    if let Err(e) = http::serve("127.0.0.1:23880", r) {
        eprintln("serve failed: {e}")
    }
}

fn await_ready(url: String) {
    let mut tries = 0
    while tries < 400 {
        if let Ok(_) = http::get(url, Vec::from([])) {
            return
        }
        time::sleep(25)
        tries += 1
    }
}

fn main() {
    spawn(|| serve_router())
    await_ready("http://127.0.0.1:23880/p/1/1.0")
    match http::get("http://127.0.0.1:23880/p/42/3.5", Vec::from([])) {
        Ok(r) => println("A {}", r.body)
        Err(e) => println("A error: {}", e)
    }
    match http::get("http://127.0.0.1:23880/p/notnum/x", Vec::from([])) {
        Ok(r) => println("B {}", r.body)
        Err(e) => println("B error: {}", e)
    }
    process::exit(0)
}
