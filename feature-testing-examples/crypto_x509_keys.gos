// `crypto::x509` key containers and certificate extensions: legacy PKCS#1
// and SEC1 keys import as PKCS#8, a PBES2 key opens with its password while
// a PBES1 key is refused by name, a certificate's custom extensions read
// back, and `self_signed` writes checked custom extensions.
use std::crypto::{ecdsa, rsa, x509}
use std::crypto::x509::Extension
use std::encoding::hex

