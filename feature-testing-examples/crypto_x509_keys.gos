sYC50GX5PSF4Po3dw03LeFm3m2WkJw4UzQIDAQAB
-----END RSA PUBLIC KEY-----
"""

const CERT_WITH_EXT: String = """
-----BEGIN CERTIFICATE-----
MIIBljCCATygAwIBAgIUMY9g5hhdNi7elq6arslkS5WKCJ0wCgYIKoZIzj0EAwIw
FjEUMBIGA1UEAwwLZXh0LmV4YW1wbGUwHhcNMjYxMTI3MDM0NTE2WhcNMjYxMjI3
MDM0NTE2WjAWMRQwEgYDVQQDDAtleHQuZXhhbXBsZTBZMBMGByqGSM49AgEGCCqG
SM49AwEHA0IABIJ96eqbYmEIOBxbOXiaTfh+3aSplFSAzUntZXjDYBTRwjErh86Y
Z/0i+LIbahlfSZVO/X20AKLSV7MCmlSics2jaDBmMB0GA1UdDgQWBBQ5vUWaVC0i
zNBKK+TYuL//uylhBTAfBgNVHSMEGDAWgBQ5vUWaVC0izNBKK+TYuL//uylhBTAP
BgNVHRMBAf8EBTADAQH/MBMGCisGAQQB1nkCBAMBAf8EAgUAMAoGCCqGSM49BAMC
A0gAMEUCIHhMuJ+ka9Z6IM5vc+jCxTzKuzWd+0rqwAO9IGeWqQGIAiEAmqOLk3aI
mMAfnNHFhFMG3h48+dngdqDpAvwhNlzEsCY=
-----END CERTIFICATE-----
"""

fn main() {
    let pkcs8 = x509::private_key_pkcs8(SEC1_P256).unwrap()
    println(f"sec1 -> {pkcs8.lines()[0]}")
    let fixed = ecdsa::sign_fixed_pem(pkcs8, "m".bytes()).unwrap()
    println(f"signs: {fixed.len()} bytes, der {x509::private_key_der(SEC1_P256).unwrap().len() > 0}")
    let opened = x509::decrypt_private_key(PBES2_KEY, "correct-horse").unwrap()
    println(f"pbes2 opens: {ecdsa::sign_fixed_pem(opened, "m".bytes()).unwrap() == fixed}")
    match x509::decrypt_private_key(PBES2_KEY, "wrong") {
        Ok(_) => println("wrong password opened")
        Err(e) => println(f"wrong password: {e}")
    }
    match x509::decrypt_private_key(PBES1_KEY, "correct-horse") {
        Ok(_) => println("pbes1 opened")
        Err(e) => println(f"pbes1: {e}")
    }
    match x509::private_key_pkcs8(PBES2_KEY) {
        Ok(_) => println("encrypted imported")
        Err(e) => println(f"encrypted: {e}")
    }
    let rsa_key = x509::private_key_pkcs8(RSA_PKCS1).unwrap()
    let rsa_public = x509::public_key_spki(RSA_PKCS1_PUBLIC).unwrap()
    let signature = rsa::sign_pss_sha256(rsa_key, "m".bytes()).unwrap()
    println(f"pkcs1 rsa signs and verifies: {rsa::verify_pss_sha256(rsa_public, "m".bytes(), signature).is_ok()}")
    println(f"certificate key: {x509::public_key_spki(CERT_WITH_EXT).unwrap().lines()[0]} {x509::public_key_der(CERT_WITH_EXT).unwrap().len()} bytes")
    for ext in x509::extensions(CERT_WITH_EXT).unwrap() {
        println(f"extension {ext.oid} critical {ext.critical} value {hex::encode(ext.value)}")
    }
    let custom = Extension { oid: "1.3.6.1.4.1.99999.1", critical: true, value: #[0x0cu8, 0x02, 0x68, 0x69] }
    let cert, _ = x509::self_signed("ext.test", #["ext.test"], days: 2, extensions: #[custom]).unwrap()
    let found = x509::extensions(cert).unwrap().filter(|e| e.oid == "1.3.6.1.4.1.99999.1")
    println(f"written: {found.len()} critical {found[0].critical} value {hex::encode(found[0].value)}")
    let twice = Extension { oid: "2.5.29.17", critical: false, value: #[0x30u8, 0x00] }
    match x509::self_signed("ext.test", #["ext.test"], extensions: #[twice]) {
        Ok(_) => println("repeated extension accepted")
        Err(e) => println(f"repeated: {e}")
    }
    let not_der = Extension { oid: "1.2.3.4", critical: false, value: #[0x0cu8, 0x05] }
    match x509::self_signed("ext.test", #["ext.test"], extensions: #[not_der]) {
        Ok(_) => println("bad value accepted")
        Err(e) => println(f"bad value: {e}")
    }
    let bad_oid = Extension { oid: "1.02.3", critical: false, value: #[0x05u8, 0x00] }
    match x509::self_signed("ext.test", #["ext.test"], extensions: #[bad_oid]) {
        Ok(_) => println("bad oid accepted")
        Err(e) => println(f"bad oid: {e}")
    }
}
