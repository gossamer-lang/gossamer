// The one spelling that abbreviates a callback: a std free function or a
// prelude printer named in value position. Everything else is a written
// closure.
use std::encoding::base64
use std::{math, strings}

struct Reading { label: String, value: f64 }

fn main() {
    let raw = #[1.0, -2.0, 3.5]

    // A std free function stands for the closure that calls it.
    println("{:?}", raw.map(math::abs))
    println("{:?}", #["  a  ", " b "].map(strings::trim))
    println("{:?}", #["ab".as_bytes(), "cd".as_bytes()].map(base64::encode))

    // A printer renders the one value it is handed.
    #["x", "y"].for_each(println)
    #[1, 2].for_each(print)
    println("")
    #[true, false].for_each(println)
    #[(1, "a")].for_each(println)
    #['x'].for_each(println)
    let greeting: Result<String, String> = Ok("hi\n")
    let _ = greeting.map(print)
    let _ = Some(2.5).map(println)
    let failed: Result<i64, String> = Err("bad")
    let _ = failed.map_err(eprintln)

    // Every other callback is a written closure.
    println("{:?}", raw.map(|v| v.abs()))
    println("{:?}", #["hi", "yo"].map(|v| v.to_uppercase()))
    println("{:?}", #["ab", "cde"].map(|v| v.len()))
    println("{:?}", #[(1, 2), (3, 4)].map(|v| v.0))
    println("{:?}", #[#[1, 2], #[3, 4]].map(|v| v[1]))

    // A closure callback nests inside another the same way.
    println("{:?}", #[4.0, 9.0].map(|v| v.sqrt()))

    // A struct-typed sequence reaches its methods the same way.
    let readings = #[
        Reading { label: "a", value: -1.5 }
        Reading { label: "b", value: 2.5 }
    ]
    println("{:?}", readings.map(|r| r.value).map(|v| v.abs()))

    // The mapped element type is concrete, so the debug rendering of
    // the result is the element's own.
    let scaled = raw.map(|v| v.abs()).map(|v| v * 2.0)
    println("{:?} {} {}", scaled, scaled[0], scaled.len())
    println("{:?} {:?}", #[1, -2].map(|v| v.abs()), #[2, 9].map(|v| v.sqrt()))
}
