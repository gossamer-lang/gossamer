// `crate::name` names the root's item and `super::name` the parent module's,
// even where the module being resolved declares a same-named item.
pub fn init(name: String) -> String {
    f"root {name}"
}

mod store {
    pub fn init(code: u32) -> u32 {
        code + 1
    }

    pub fn tree() -> i64 {
        7
    }

    pub fn check() -> String {
        crate::init("x")
    }

    pub mod inner {
        fn tree(n: i64) -> i64 {
            n
        }

        pub fn call() -> i64 {
            super::tree() + tree(1)
        }

        pub fn total(n: i64) -> i64 {
            let mut sum = 0
            for i in 0..n {
                sum += super::tree() + tree(i)
            }
            sum
        }
    }
}

fn main() {
    println(store::check())
    println(store::inner::call())
    println(store::inner::total(4))
}
