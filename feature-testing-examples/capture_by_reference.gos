// A closure names the bindings it captures (SPEC 3.5). Mutating a captured
// `Vec` through the closure is observed by the enclosing binding and the
// other way round, and so is assigning the whole binding, a scalar, or a
// `String`: the closure reads each capture's current value.

fn make_counter() -> Fn() -> i64 {
    let mut seen: Vec<i64> = #[]
    let count = || {
        seen.push(1)
        seen.len()
    }
    count
}

fn main() {
    let mut v: Vec<i64> = #[9]
    let add = || { v.push(2) }
    add()
    println("push {}", v.len())

    // The enclosing binding's own mutation reaches the closure.
    v.push(3)
    add()
    println("both ways {}", v.len())

    // Indexed and sorting mutations travel through the same buffer.
    let mut nums: Vec<i64> = #[3, 1, 2]
    let fix = || {
        nums[0] = 7
        nums.sort()
    }
    fix()
    println("index+sort {} {}", nums[0], nums[2])

    // A read-only capture still sees the enclosing binding's writes.
    let mut log: Vec<i64> = #[]
    let size = || log.len()
    log.push(1)
    log.push(2)
    println("read-only {}", size())

    // Assigning the whole binding is seen by the closure, which pushes onto
    // the new value.
    let mut items: Vec<i64> = #[1]
    let grow = || { items.push(2) }
    items = #[10, 20, 30]
    grow()
    println("reassigned {}", items.len())

    // A scalar capture reads the binding's current value.
    let mut k = 10
    let peek = || k
    k = 11
    println("scalar {} {}", peek(), k)

    // So does a `String` capture.
    let mut s = "a"
    let shown = || s
    s += "b"
    println("string {} {}", shown(), s)

    // Combinators run the closure against the captured binding.
    let mut seen: Vec<i64> = #[]
    let doubled = #[1, 2, 3].iter().map(|x| {
        seen.push(x)
        x * 2
    })
    println("combinator {} {}", seen.len(), doubled.count())

    // A closure outliving the frame that built it keeps its capture
    // alive across calls.
    let counter = make_counter()
    println("escaping {} {} {}", counter(), counter(), counter())
}
