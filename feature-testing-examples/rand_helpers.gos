// The math::rand helpers draw from an Rng's own stream, so a seed gives the
// same values on every tier.
use std::math::rand

fn main() {
    let rng = rand::Rng::new(7)
    let mut rolls = #[]
    for _ in 0..10 { rolls.push(rand::range(rng, 1, 7)) }
    println(f"{rolls}")
    println(f"{rand::range_f64(rng, 0.0, 1.0):.6} {rand::chance(rng, 0.5)}")
    let names = #["ann", "bob", "cy", "dee"]
    println(f"{rand::choose(rng, names):?} {rand::sample(rng, names, 2)}")
    let mut deck = #[1, 2, 3, 4, 5, 6]
    rand::shuffle(rng, &mut deck)
    println(f"{deck}")
    println(f"{rand::weighted(rng, #[0.0, 1.0, 3.0]):?} {rand::weighted(rng, #[0.0]):?}")
    println(f"{rand::normal(rng, 10.0, 2.0):.6} {rand::exponential(rng, 2.0):.6}")
    println(f"{rand::range(rng, i64::MIN + 1, i64::MAX) != 0}")
    println(f"{rand::from_os().is_ok()}")
}
