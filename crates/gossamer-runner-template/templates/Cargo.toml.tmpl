# generated by gos for {{ project_id }} -- fingerprint {{ fingerprint_hex }}
# DO NOT EDIT. Regenerated when `[rust-bindings]` changes.
[package]
name = "gos-runner-{{ fingerprint_hex }}"
version = "0.0.0"
edition = "2024"
publish = false

# Stand alone as a workspace root. The runner is generated inside the
# gossamer cache, which can itself sit under an unrelated Cargo
# workspace; an empty table keeps that ancestor from absorbing this
# crate (cargo would otherwise reject it as a non-member) and anchors
# the `[patch]` block below.
[workspace]

[[bin]]
name = "gos-runner"
path = "main.rs"

[[bin]]
name = "gos-sigs-dump"
path = "sigs_dump.rs"

[profile.dev]
opt-level = 0
debug = 0
incremental = false

# Build scripts and proc-macros run only on the build machine, and rustc loads
# a proc-macro through the crate metadata in its dylib. They stay unstripped:
# the Xcode 27 linker lays out a stripped macOS dylib built for a deployment
# target the SDK supplies in a way rustc cannot read that metadata from.
[profile.dev.build-override]
strip = false

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
strip = "debuginfo"
incremental = false

[profile.release.build-override]
strip = false

[dependencies]
gossamer-cli     = { path = '{{ gossamer_root }}/crates/gossamer-cli' }
gossamer-binding = { path = '{{ gossamer_root }}/crates/gossamer-binding' }
# time 0.3.48 breaks cookie 0.18.1 (E0119: conflicting From impls with
# cookie's blanket Expiration conversion). Pin until cookie ships a fix;
# fresh-resolving generated workspaces hit it without this.
time = "=0.3.47"
{{#each bindings}}
{{ this.cargo_dep_line }}
{{/each}}
{{ gossamer_patch }}
